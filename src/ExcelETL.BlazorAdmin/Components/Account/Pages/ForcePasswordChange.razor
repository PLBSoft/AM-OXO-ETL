@page "/Account/ForcePasswordChange"
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using ExcelETL.Application.Identity
@using ExcelETL.Infrastructure.Identity
@using ExcelETL.BlazorAdmin.Components.Account.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IUserRepository UserRepository
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<BlazorAdminMessages> Loc

<PageTitle>@Loc["ForcePasswordChange_Title"]</PageTitle>

<h1>@Loc["ForcePasswordChange_Title"]</h1>
<p>@Loc["ForcePasswordChange_Explanation"]</p>

<div class="row">
    <div class="col-lg-6">
        <section>
            <StatusMessage Message="@errorMessage" IsError="true" />
            <EditForm id="force-password-change-form" Model="Input" method="post" OnValidSubmit="ChangePasswordAsync" FormName="force-password-change">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.CurrentPassword" id="current-password-input" class="form-control" autocomplete="current-password" aria-required="true" aria-describedby="current-password-validation" placeholder="@Loc["Profile_CurrentPasswordPlaceholder"]" />
                    <label for="current-password-input">@Loc["Profile_CurrentPasswordLabel"]</label>
                    <!-- Lot 042 (42.1): ValidationMessage renders nothing at all when the field has
                         no error, so the aria-describedby target needs its own always-present
                         wrapper rather than an id on ValidationMessage itself. -->
                    <div id="current-password-validation"><ValidationMessage For="() => Input.CurrentPassword" class="text-danger" /></div>
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.NewPassword" id="new-password-input" class="form-control" autocomplete="new-password" aria-required="true" aria-describedby="new-password-validation" placeholder="@Loc["Profile_NewPasswordPlaceholder"]" />
                    <label for="new-password-input">@Loc["Profile_NewPasswordLabel"]</label>
                    <div id="new-password-validation"><ValidationMessage For="() => Input.NewPassword" class="text-danger" /></div>
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.ConfirmNewPassword" id="confirm-password-input" class="form-control" autocomplete="new-password" aria-required="true" aria-describedby="confirm-password-validation" placeholder="@Loc["Profile_ConfirmNewPasswordPlaceholder"]" />
                    <label for="confirm-password-input">@Loc["Profile_ConfirmNewPasswordLabel"]</label>
                    <div id="confirm-password-validation"><ValidationMessage For="() => Input.ConfirmNewPassword" class="text-danger" /></div>
                </div>
                <button id="force-password-change-submit" type="submit" class="w-100 btn btn-lg btn-primary">@Loc["ForcePasswordChange_Submit"]</button>
            </EditForm>
        </section>
    </div>
</div>

@code {
    // Lot 045 (45.4): PasswordChangeGuard's own allow-list compares against this route verbatim.
    public const string Route = "Account/ForcePasswordChange";

    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    protected override async Task OnInitializedAsync()
    {
        // Lot 045 (45.2): only reachable while the flag is actually set -- a user who doesn't need
        // this page (flag already false) is redirected away rather than shown a pointless form.
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null || !user.RequirePasswordChangeOnFirstLogin)
        {
            RedirectManager.RedirectTo("");
        }
    }

    private async Task ChangePasswordAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectTo("");
            return;
        }

        var result = await UserRepository.ChangePasswordAsync(user.Id, Input.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            errorMessage = string.Join(", ", result.Errors);
            return;
        }

        // Lot 045 (45.1/45.0): the flag was just lifted by UserRepository.ChangePasswordAsync --
        // re-fetch the user so RefreshSignInAsync rebuilds the principal from the now-false flag
        // (via RequirePasswordChangeClaimsPrincipalFactory) instead of the stale in-memory instance.
        // This page is static SSR ([ExcludeFromInteractiveRouting] via the Account/_Imports.razor
        // attribute), so -- unlike Profile.razor's InteractiveServer password form -- the auth
        // cookie can be rewritten directly during this POST; no manual logout/relogin dance needed.
        var refreshedUser = await UserManager.FindByIdAsync(user.Id) ?? user;
        await SignInManager.RefreshSignInAsync(refreshedUser);
        RedirectManager.RedirectTo("");
    }

    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        public string CurrentPassword { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword))]
        public string ConfirmNewPassword { get; set; } = "";
    }
}
