@using System.Globalization
@using ExcelETL.Application.Home
@using ExcelETL.BlazorAdmin.Formatting
@using ExcelETL.BlazorAdmin.Services
@using Microsoft.JSInterop

@implements IAsyncDisposable

@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject IActivityChartInterop ChartInterop

<!-- Lot 089: files processed per local day over the last 30 days, stacked by status, drawn by
     Chart.js (wwwroot/js/activityChart.js) in the canvas below once the circuit is interactive --
     tooltip on hover/touch, redrawn at every width and on a light/dark theme change. Before that
     (prerendering) nothing is drawn, the container keeps its height. A canvas isn't read by screen
     readers: the hidden summary and table carry the same numbers. -->
<figure class="home-activity-chart mb-0">
    <div class="home-activity-chart-canvas">
        <canvas id="@CanvasId" role="img" aria-labelledby="home-activity-chart-summary"></canvas>
    </div>

    <p id="home-activity-chart-summary" class="visually-hidden">@Summary()</p>

    @* The table sits inside a hidden div rather than carrying visually-hidden itself: a table never
       shrinks below its rows, so the 30-row table stayed full height (invisible) and made the whole
       page scroll. *@
    <div class="visually-hidden">
    <table id="home-activity-table">
        <caption>@Loc["Home_ActivityChartTitle"]</caption>
        <thead>
            <tr>
                <th scope="col">@Loc["Home_ActivityTableDate"]</th>
                <th scope="col">@Loc["Home_ActivityLegendSuccess"]</th>
                <th scope="col">@Loc["Home_ActivityLegendWarning"]</th>
                <th scope="col">@Loc["Home_ActivityLegendRejected"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var day in Days)
            {
                <tr>
                    <th scope="row">@day.Day.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</th>
                    <td>@day.Success</td>
                    <td>@day.Warning</td>
                    <td>@day.Rejected</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</figure>

@code {
    private const string CanvasId = "home-activity-chart";

    [Parameter, EditorRequired]
    public IReadOnlyList<DailyGenerationActivity> Days { get; set; } = [];

    // The days last handed to the script: the page passes a new list whenever it regroups (browser
    // time zone now known), which only needs a redraw if a count actually moved.
    private IReadOnlyList<DailyGenerationActivity>? _drawnDays;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive || (_drawnDays is not null && _drawnDays.SequenceEqual(Days)))
        {
            return;
        }

        _drawnDays = Days;
        try
        {
            await ChartInterop.RenderAsync(CanvasId, ActivityChartModelBuilder.Build(Days, Loc));
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away while drawing: nothing left to draw into.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_drawnDays is null)
        {
            return;
        }

        try
        {
            await ChartInterop.DisposeChartAsync(CanvasId);
        }
        catch (JSDisconnectedException)
        {
            // The browser page is already gone, and the chart with it.
        }
    }

    private string Summary() => Days.Count == 0
        ? string.Empty
        : Loc[
            "Home_ActivityChartSummary",
            Days.Sum(d => d.Total),
            Days[0].Day.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
            Days[^1].Day.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
            Days.Sum(d => d.Success),
            Days.Sum(d => d.Warning),
            Days.Sum(d => d.Rejected)];
}
