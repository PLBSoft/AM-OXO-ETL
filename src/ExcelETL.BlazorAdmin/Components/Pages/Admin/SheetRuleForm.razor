<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}point-rule-colonne-name-input")" class="form-control" @bind="_newPointRuleColonneName"
               placeholder="@Loc["ImportProfileEditor_ColonneNamePlaceholder"]" />
        <label for="@($"{IdPrefix}point-rule-colonne-name-input")">@Loc["ImportProfileEditor_ColonneNameLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}point-rule-source-field-name-input")" class="form-control" @bind="_newPointRuleSourceFieldName"
               placeholder="@Loc["ImportProfileEditor_SourceFieldNamePlaceholder"]" />
        <label for="@($"{IdPrefix}point-rule-source-field-name-input")">@Loc["ImportProfileEditor_SourceFieldNameLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <select id="@($"{IdPrefix}point-rule-operator-select")" class="form-select" @bind="_newPointRuleOperator">
            <option value="@ConditionOperator.Equals">@Loc["ImportProfileEditor_Operator_Equals"]</option>
            <option value="@ConditionOperator.NotEquals">@Loc["ImportProfileEditor_Operator_NotEquals"]</option>
        </select>
        <label for="@($"{IdPrefix}point-rule-operator-select")">@Loc["ImportProfileEditor_OperatorLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}point-rule-comparison-value-input")" class="form-control" @bind="_newPointRuleComparisonValue"
               placeholder="@Loc["ImportProfileEditor_ComparisonValuePlaceholder"]" />
        <label for="@($"{IdPrefix}point-rule-comparison-value-input")">@Loc["ImportProfileEditor_ComparisonValueLabel"]</label>
    </div>
</div>
<div class="right-aligned-actions">
    <button id="@($"{IdPrefix}add-point-rule-button")" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="AddPointRule">
        @((MarkupString)AdminIconMarkup.Plus) @Loc["ImportProfileEditor_AddPointRuleButton"]
    </button>
</div>
</div>
</div>

<div class="card bg-light mb-3">
<div class="card-body">
<h3 class="h5">@Loc["ImportProfileEditor_HeaderFieldsHeading"]</h3>
@if (GetMissingWellKnownNames() is { Count: > 0 } missingNames)
{
    <div id="@($"{IdPrefix}header-well-known-names-warning")" class="alert alert-warning" role="alert">
        @Loc["ImportProfileEditor_WellKnownHeaderNamesMissingWarning", string.Join(", ", missingNames)]
    </div>
}
@if (_headerFields.Count > 0)
{
    <ul class="block-field-list">
        @for (var j = 0; j < _headerFields.Count; j++)
        {
            var fieldIndex = j;
            var field = _headerFields[fieldIndex];
            @if (_editingHeaderFieldIndex == fieldIndex)
            {
                <li class="block-field-item-editing">
                    <HeaderFieldRuleForm IdPrefix="@($"{IdPrefix}header-field-{fieldIndex}-")"
                                         InitialField="field"
                                         SubmitButtonId="@($"{IdPrefix}save-header-field-button-{fieldIndex}")"
                                         SubmitLabel="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                         ShowCancel="true"
                                         CancelButtonId="@($"{IdPrefix}cancel-header-field-button-{fieldIndex}")"
                                         OnCancel="() => _editingHeaderFieldIndex = null"
                                         OnSubmit="(HeaderFieldRule updated) => HandleSaveHeaderField(fieldIndex, updated)" />
                </li>
            }
            else
            {
                <li class="block-field-item">
                    <div class="block-field-info">
                        <span class="block-field-name">@field.Name</span>
                        <span class="block-field-range text-muted font-monospace">@FormatHeaderFieldSummary(field)</span>
                    </div>
                    <div class="block-field-actions">
                        <button id="@($"{IdPrefix}modify-header-field-button-{fieldIndex}")" type="button"
                                class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                aria-label="@Loc["ImportProfileEditor_ModifyButton"]"
                                title="@Loc["ImportProfileEditor_ModifyButton"]"
                                @onclick="() => _editingHeaderFieldIndex = fieldIndex">
                            @((MarkupString)AdminIconMarkup.Pencil)
                        </button>
                        <button id="@($"{IdPrefix}delete-header-field-button-{fieldIndex}")" type="button"
                                class="btn btn-sm btn-outline-danger block-field-icon-btn"
                                aria-label="@Loc["ImportProfileEditor_DeleteButton"]"
                                title="@Loc["ImportProfileEditor_DeleteButton"]"
                                @onclick="() => DeleteHeaderField(fieldIndex)">
                            @((MarkupString)AdminIconMarkup.Trash)
                        </button>
                    </div>
                </li>
            }
        }
    </ul>
}
<HeaderFieldRuleForm IdPrefix="@($"{IdPrefix}header-field-")"
                     SubmitButtonId="@($"{IdPrefix}add-header-field-button")"
                     SubmitLabel="@Loc["ImportProfileEditor_AddHeaderFieldButton"]"
                     OnSubmit="AddHeaderField" />
</div>
</div>

<div class="card bg-light mb-3">
<div class="card-body">
<h3 class="h5">@Loc["ImportProfileEditor_HeaderCompositesHeading"]</h3>
@if (_headerComposites.Count > 0)
{
    <ul class="block-field-list">
        @for (var j = 0; j < _headerComposites.Count; j++)
        {
            var itemIndex = j;
            var composite = _headerComposites[itemIndex];
            @if (_editingHeaderCompositeIndex == itemIndex)
            {
                <li class="block-field-item-editing">
                    <HeaderCompositeRuleForm IdPrefix="@($"{IdPrefix}header-composite-{itemIndex}-")"
                                             InitialComposite="composite"
                                             SubmitButtonId="@($"{IdPrefix}save-header-composite-button-{itemIndex}")"
                                             SubmitLabel="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                             ShowCancel="true"
                                             CancelButtonId="@($"{IdPrefix}cancel-header-composite-button-{itemIndex}")"
                                             OnCancel="() => _editingHeaderCompositeIndex = null"
                                             OnSubmit="(HeaderCompositeRule updated) => HandleSaveHeaderComposite(itemIndex, updated)" />
                </li>
            }
            else
            {
                <li class="block-field-item">
                    <div class="block-field-info">
                        <span class="block-field-name">@composite.Name</span>
                        <span class="block-field-range text-muted font-monospace">@composite.Template</span>
                    </div>
                    <div class="block-field-actions">
                        <button id="@($"{IdPrefix}modify-header-composite-button-{itemIndex}")" type="button"
                                class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                aria-label="@Loc["ImportProfileEditor_ModifyButton"]"
                                title="@Loc["ImportProfileEditor_ModifyButton"]"
                                @onclick="() => _editingHeaderCompositeIndex = itemIndex">
                            @((MarkupString)AdminIconMarkup.Pencil)
                        </button>
                        <button id="@($"{IdPrefix}delete-header-composite-button-{itemIndex}")" type="button"
                                class="btn btn-sm btn-outline-danger block-field-icon-btn"
                                aria-label="@Loc["ImportProfileEditor_DeleteButton"]"
                                title="@Loc["ImportProfileEditor_DeleteButton"]"
                                @onclick="() => DeleteHeaderComposite(itemIndex)">
                            @((MarkupString)AdminIconMarkup.Trash)
                        </button>
                    </div>
                </li>
            }
        }
    </ul>
}
<HeaderCompositeRuleForm IdPrefix="@($"{IdPrefix}header-composite-")"
                         SubmitButtonId="@($"{IdPrefix}add-header-composite-button")"
                         SubmitLabel="@Loc["ImportProfileEditor_AddHeaderCompositeButton"]"
                         OnSubmit="AddHeaderComposite" />
</div>
</div>

<!-- Lot 056 (56.7): submission and cancel are now visually distinct in every mode -- the
     submission button is always solid btn-secondary (icon still Plus in add mode / Check in edit
     mode, Lot 041 unchanged); "Cancel" stays btn-outline-secondary. Previously, in edit mode
     (ShowCancel=true), both buttons were btn-outline-secondary and strictly indistinguishable
     (audit S2.3 / lot 053 deferral -- the exact 29/07 usability remark this lot closes). -->
<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="Submit">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        else
        {
            @((MarkupString)AdminIconMarkup.Plus)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3" @onclick="Cancel">
            @Loc["ImportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter]
    public SheetExtractionRule? InitialRule { get; set; }

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-sheet-rule-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-sheet-rule-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback<SheetExtractionRule> OnSubmit { get; set; }

    // Lot 056 (56.3): raised on every mutation of this form's own state (root locator fields plus
    // every add/modify/delete on its four nested sub-lists) so the root editor's "unsaved changes"
    // indicator/NavigationLock guard also covers in-progress edits, not just committed ones.
    [Parameter]
    public EventCallback OnDirty { get; set; }

    private void MarkDirty() => OnDirty.InvokeAsync();

    private string _sheetName = string.Empty;
    private int _firstBlockStartRow;
    private int _step;
    private string _stopFieldName = string.Empty;
    private readonly List<BlockFieldDefinition> _fields = [];
    private readonly List<string> _unconditionalColonneNames = [];
    private readonly List<ConditionalPointRule> _pointRules = [];
    private readonly List<HeaderFieldRule> _headerFields = [];
    private readonly List<HeaderCompositeRule> _headerComposites = [];

    private int? _editingFieldIndex;

    private string _newUnconditionalColonneName = string.Empty;
    private ElementReference _unconditionalColonneNameInputRef;
    private string _newPointRuleColonneName = string.Empty;
    private string _newPointRuleSourceFieldName = string.Empty;
    private ConditionOperator _newPointRuleOperator = ConditionOperator.Equals;
    private string _newPointRuleComparisonValue = string.Empty;

    private int? _editingUnconditionalColonneIndex;
    private string _editingUnconditionalColonneValue = string.Empty;
    private string? _unconditionalColonneEditError;

    private int? _editingPointRuleIndex;
    private string _editingPointRuleColonneName = string.Empty;
    private string _editingPointRuleSourceFieldName = string.Empty;
    private ConditionOperator _editingPointRuleOperator = ConditionOperator.Equals;
    private string _editingPointRuleComparisonValue = string.Empty;
    private string? _pointRuleEditError;

    private int? _editingHeaderFieldIndex;
    private int? _editingHeaderCompositeIndex;

    private string? _errorMessage;

    // Only ever runs once per mounted instance -- the parent gives an edit-mode instance a fresh
    // component identity (conditionally rendered inside an @if, not a persistently bound one), so
    // InitialRule never changes underneath an already-initialized instance.
    protected override void OnInitialized()
    {
        if (InitialRule is null)
        {
            return;
        }

        _sheetName = InitialRule.SheetName;
        _firstBlockStartRow = InitialRule.Locator.FirstBlockStartRow;
        _step = InitialRule.Locator.Step;
        _stopFieldName = InitialRule.Locator.StopFieldName;
        _fields.AddRange(InitialRule.Locator.Fields);
        _unconditionalColonneNames.AddRange(InitialRule.UnconditionalColonneNames);
        _pointRules.AddRange(InitialRule.PointRules);
        _headerFields.AddRange(InitialRule.HeaderFields);
        _headerComposites.AddRange(InitialRule.HeaderComposites);
    }

    private void AddBlockField(BlockFieldDefinition field)
    {
        _fields.Add(field);
        MarkDirty();
    }

    private void HandleSaveBlockField(int fieldIndex, BlockFieldDefinition updated)
    {
        _fields[fieldIndex] = updated;
        _editingFieldIndex = null;
        MarkDirty();
    }

    private void DeleteBlockField(int fieldIndex)
    {
        _fields.RemoveAt(fieldIndex);
        if (_editingFieldIndex == fieldIndex)
        {
            _editingFieldIndex = null;
        }
        MarkDirty();
    }

    private void AddUnconditionalColonneName()
    {
        if (string.IsNullOrWhiteSpace(_newUnconditionalColonneName))
        {
            return;
        }

        _unconditionalColonneNames.Add(_newUnconditionalColonneName);
        _newUnconditionalColonneName = string.Empty;
        MarkDirty();
    }

    // Lot 056 (56.4): a single-field row's "all fields filled" check is just the field itself --
    // AddUnconditionalColonneName() already no-ops silently on a blank value. Focus is only stolen
    // back to the field when something was actually added -- otherwise a blank-field blur (e.g. the
    // user tabbing/clicking away to a different button entirely) would fight that click by
    // re-focusing this field out from under it.
    private async Task OnUnconditionalColonneRowBlurAsync()
    {
        if (string.IsNullOrWhiteSpace(_newUnconditionalColonneName))
        {
            return;
        }

        AddUnconditionalColonneName();
        await _unconditionalColonneNameInputRef.FocusAsync();
    }

    private async Task OnUnconditionalColonneRowKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_newUnconditionalColonneName))
        {
            AddUnconditionalColonneName();
            await _unconditionalColonneNameInputRef.FocusAsync();
        }
    }

    private void StartUnconditionalColonneEdit(int itemIndex)
    {
        _editingUnconditionalColonneIndex = itemIndex;
        _editingUnconditionalColonneValue = _unconditionalColonneNames[itemIndex];
        _unconditionalColonneEditError = null;
    }

    private void SaveUnconditionalColonneEdit(int itemIndex)
    {
        if (string.IsNullOrWhiteSpace(_editingUnconditionalColonneValue))
        {
            _unconditionalColonneEditError = Loc["ImportProfileEditor_EmptyColonneNameError"];
            return;
        }

        _unconditionalColonneNames[itemIndex] = _editingUnconditionalColonneValue;
        _editingUnconditionalColonneIndex = null;
        _unconditionalColonneEditError = null;
        MarkDirty();
    }

    private void CancelUnconditionalColonneEdit()
    {
        _editingUnconditionalColonneIndex = null;
        _unconditionalColonneEditError = null;
    }

    private void DeleteUnconditionalColonneName(int itemIndex)
    {
        _unconditionalColonneNames.RemoveAt(itemIndex);
        if (_editingUnconditionalColonneIndex == itemIndex)
        {
            _editingUnconditionalColonneIndex = null;
        }
        MarkDirty();
    }

    private void AddPointRule()
    {
        _errorMessage = null;

        try
        {
            _pointRules.Add(new ConditionalPointRule(
                _newPointRuleSourceFieldName, _newPointRuleOperator, _newPointRuleComparisonValue, _newPointRuleColonneName));
            _newPointRuleColonneName = string.Empty;
            _newPointRuleSourceFieldName = string.Empty;
            _newPointRuleOperator = ConditionOperator.Equals;
            _newPointRuleComparisonValue = string.Empty;
            MarkDirty();
        }
        catch (DomainValidationException ex)
        {
            _errorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }

    private void StartPointRuleEdit(int itemIndex)
    {
        var rule = _pointRules[itemIndex];
        _editingPointRuleIndex = itemIndex;
        _editingPointRuleColonneName = rule.ColonneName;
        _editingPointRuleSourceFieldName = rule.SourceFieldName;
        _editingPointRuleOperator = rule.Operator;
        _editingPointRuleComparisonValue = rule.ComparisonValue;
        _pointRuleEditError = null;
    }

    private void SavePointRuleEdit(int itemIndex)
    {
        _pointRuleEditError = null;

        try
        {
            _pointRules[itemIndex] = new ConditionalPointRule(
                _editingPointRuleSourceFieldName, _editingPointRuleOperator, _editingPointRuleComparisonValue, _editingPointRuleColonneName);
            _editingPointRuleIndex = null;
            MarkDirty();
        }
        catch (DomainValidationException ex)
        {
            _pointRuleEditError = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }

    private void CancelPointRuleEdit()
    {
        _editingPointRuleIndex = null;
        _pointRuleEditError = null;
    }

    private void DeletePointRule(int itemIndex)
    {
        _pointRules.RemoveAt(itemIndex);
        if (_editingPointRuleIndex == itemIndex)
        {
            _editingPointRuleIndex = null;
        }
        MarkDirty();
    }

    private void AddHeaderField(HeaderFieldRule field)
    {
        _headerFields.Add(field);
        MarkDirty();
    }

    private void HandleSaveHeaderField(int fieldIndex, HeaderFieldRule updated)
    {
        _headerFields[fieldIndex] = updated;
        _editingHeaderFieldIndex = null;
        MarkDirty();
    }

    // Deletion is immediate, no confirmation -- same parity-with-sibling-sublists decision as every
    // other list in this component (Lot 048 decision 1).
    private void DeleteHeaderField(int fieldIndex)
    {
        _headerFields.RemoveAt(fieldIndex);
        if (_editingHeaderFieldIndex == fieldIndex)
        {
            _editingHeaderFieldIndex = null;
        }
        MarkDirty();
    }

    private void AddHeaderComposite(HeaderCompositeRule composite)
    {
        _headerComposites.Add(composite);
        MarkDirty();
    }

    private void HandleSaveHeaderComposite(int itemIndex, HeaderCompositeRule updated)
    {
        _headerComposites[itemIndex] = updated;
        _editingHeaderCompositeIndex = null;
        MarkDirty();
    }

    private void DeleteHeaderComposite(int itemIndex)
    {
        _headerComposites.RemoveAt(itemIndex);
        if (_editingHeaderCompositeIndex == itemIndex)
        {
            _editingHeaderCompositeIndex = null;
        }
        MarkDirty();
    }

    private string FormatHeaderFieldSummary(HeaderFieldRule field)
    {
        var indicators = new List<string>();
        if (field.StripReperePrefix)
        {
            indicators.Add(Loc["ImportProfileEditor_HeaderFieldStripPrefixIndicator"]);
        }

        if (field.DateFormat is not null)
        {
            indicators.Add(Loc["ImportProfileEditor_HeaderFieldDateFormatIndicator", field.DateFormat]);
        }

        return indicators.Count == 0 ? field.Cell.Range : $"{field.Cell.Range} ({string.Join(", ", indicators)})";
    }

    // UI-only advisory (Lot 048, 48.5) -- never consulted by extraction. Compares the current, still
    // in-progress form state against KnownHeaderFieldNames.For(_sheetName), ordinally/case-sensitively
    // (matching the real resolver's own Dictionary<string, ...> lookup).
    private IReadOnlyList<string> GetMissingWellKnownNames()
    {
        var expected = KnownHeaderFieldNames.For(_sheetName);
        if (expected.Fields.Count == 0 && expected.Composites.Count == 0)
        {
            return [];
        }

        var presentFields = _headerFields.Select(f => f.Name).ToHashSet(StringComparer.Ordinal);
        var presentComposites = _headerComposites.Select(c => c.Name).ToHashSet(StringComparer.Ordinal);

        return
        [
            .. expected.Fields.Where(name => !presentFields.Contains(name)),
            .. expected.Composites.Where(name => !presentComposites.Contains(name)),
        ];
    }

    // Lot 056 (56.2): the single validation path for this form -- reused by the CTA click (Submit,
    // below) and by the root editor's implicit flush on "Save profile" (TryCommitAsync is the
    // inter-lot contract Lot 057 also reuses as-is to close a form on an implicit switch). A form
    // that was never touched (still exactly its just-reset/just-mounted state) is treated as "nothing
    // to commit" -- true, no side effect -- so the root editor can safely flush an always-rendered,
    // never-interacted-with add-sheet-rule form on every save without spuriously failing validation.
    private bool IsBlank() =>
        string.IsNullOrEmpty(_sheetName) && _firstBlockStartRow == 0 && _step == 0 &&
        string.IsNullOrEmpty(_stopFieldName) && _fields.Count == 0 &&
        _unconditionalColonneNames.Count == 0 && _pointRules.Count == 0 &&
        _headerFields.Count == 0 && _headerComposites.Count == 0;

    public async Task<bool> TryCommitAsync()
    {
        if (IsBlank())
        {
            return true;
        }

        _errorMessage = null;

        try
        {
            var locator = new RepeatingBlockLocator(_sheetName, _firstBlockStartRow, _step, _stopFieldName, _fields);

            // Header fields always re-derive Cell.Sheet from the current sheet name (decision 2, Lot
            // 048) -- so a sheet rename after a header field was added still lands consistently, and
            // the UI never exposes "read from another sheet" (which the domain allows but no seeded
            // profile ever uses).
            var headerFields = _headerFields
                .Select(f => new HeaderFieldRule(f.Name, new DirectCell(_sheetName, f.Cell.Range), f.StripReperePrefix, f.DateFormat))
                .ToList();

            // SheetExtractionRule stores these lists by reference (unlike PointRules, which it copies) --
            // pass snapshots so ResetForm()'s Clear() below can't reach back into the rule we just handed off.
            var rule = new SheetExtractionRule(
                _sheetName, locator, _pointRules, [.. _unconditionalColonneNames], headerFields, [.. _headerComposites]);

            await OnSubmit.InvokeAsync(rule);

            ResetForm();
            return true;
        }
        catch (Exception ex) when (ex is DomainValidationException or DomainArgumentOutOfRangeException or DomainRuleViolationException)
        {
            _errorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
            return false;
        }
    }

    private async Task Submit() => await TryCommitAsync();

    private async Task Cancel() => await OnCancel.InvokeAsync();

    private void ResetForm()
    {
        _sheetName = string.Empty;
        _firstBlockStartRow = 0;
        _step = 0;
        _stopFieldName = string.Empty;
        _fields.Clear();
        _unconditionalColonneNames.Clear();
        _pointRules.Clear();
        _headerFields.Clear();
        _headerComposites.Clear();
        _editingFieldIndex = null;
        _editingHeaderFieldIndex = null;
        _editingHeaderCompositeIndex = null;
        _newUnconditionalColonneName = string.Empty;
        _newPointRuleColonneName = string.Empty;
        _newPointRuleSourceFieldName = string.Empty;
        _newPointRuleOperator = ConditionOperator.Equals;
        _newPointRuleComparisonValue = string.Empty;
        _editingUnconditionalColonneIndex = null;
        _unconditionalColonneEditError = null;
        _editingPointRuleIndex = null;
        _pointRuleEditError = null;
    }
}
