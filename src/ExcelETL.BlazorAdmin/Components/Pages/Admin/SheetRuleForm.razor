@using ExcelETL.Application.Exceptions
@using ExcelETL.BlazorAdmin.Editing
@using ExcelETL.BlazorAdmin.Editing.Import
@using ExcelETL.BlazorAdmin.Formatting
@using ExcelETL.BlazorAdmin.Shared
@using ExcelETL.Domain.Extraction.Primitives

@inject BusinessExceptionLocalizer BusinessExceptionLocalizer
@inject IStringLocalizer<BlazorAdminMessages> Loc

@* Lot 075 (P3 drafts): every value of this form lives in Draft, owned by ImportProfileEditor. This
   component binds the rule's own fields, owns the edit state of its six nested lists, and validates
   through ImportProfileDraftMapper -- there is no local copy of the data left to flush or lose. *@

@if (!string.IsNullOrEmpty(Draft.Error))
{
    <div class="alert alert-danger" role="alert">@Draft.Error</div>
}
@* Constat 9 of lot 075: the pending point rule's error has always been shown here, at the top of the form. *@
@if (!string.IsNullOrEmpty(Draft.PendingPointRule.Error))
{
    <div class="alert alert-danger" role="alert">@Draft.PendingPointRule.Error</div>
}

@* Client ticket J2M76: every section is offered for every sheet, but each sheet's extraction only reads
   some of them -- say so where the user types, not in a code comment. No role="alert": these follow the
   sheet name as it is typed and would otherwise be announced on every keystroke. *@
@{
    var ignored = SheetRuleIgnoredSettings.For(Draft);
    // Lot 084: PROCEDURE walks its tasks itself, tolerantly, and never warns -- its "required" and
    // warning check boxes would have no effect.
    var isTaskSheet = ImportSheetUsage.For(Draft.SheetName)?.ItemKind == BlockItemKind.Task;
    var blockFieldNames = BlockFieldNames();
}
@if (ignored.SheetNotProcessed)
{
    <div id="@($"{IdPrefix}sheet-not-processed-warning")" class="alert alert-warning">
        @Loc["ImportProfileEditor_SheetNotProcessedWarning", Draft.SheetName, string.Join(", ", ImportSheetUsage.KnownSheetNames)]
    </div>
}

<div class="card bg-light mb-3">
<div class="card-body">
<h3 class="h5">@Loc["ImportProfileEditor_SheetGeneralSettingsHeading"]</h3>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}sheet-rule-name-input")" class="form-control" @bind="Draft.SheetName" @bind:after="MarkDirty"
               placeholder="@Loc["ImportProfileEditor_SheetNamePlaceholder"]" />
        <label for="@($"{IdPrefix}sheet-rule-name-input")">@Loc["ImportProfileEditor_SheetNameLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}sheet-rule-first-block-start-row-input")" type="number" class="form-control" @bind="Draft.FirstBlockStartRow" @bind:after="MarkDirty"
               placeholder="@Loc["ImportProfileEditor_FirstBlockStartRowPlaceholder"]" />
        <label for="@($"{IdPrefix}sheet-rule-first-block-start-row-input")">@Loc["ImportProfileEditor_FirstBlockStartRowLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}sheet-rule-step-input")" type="number" class="form-control" @bind="Draft.Step" @bind:after="MarkDirty"
               placeholder="@Loc["ImportProfileEditor_StepPlaceholder"]" />
        <label for="@($"{IdPrefix}sheet-rule-step-input")">@Loc["ImportProfileEditor_StepLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}sheet-rule-stop-field-name-input")" class="form-control" @bind="Draft.StopFieldName" @bind:after="MarkDirty"
               placeholder="@Loc["ImportProfileEditor_StopFieldNamePlaceholder"]" />
        <label for="@($"{IdPrefix}sheet-rule-stop-field-name-input")">@Loc["ImportProfileEditor_StopFieldNameLabel"]</label>
    </div>
    @if (ignored.IgnoredStopFieldFixedName is { } fixedStopField)
    {
        <div id="@($"{IdPrefix}stop-field-ignored-warning")" class="alert alert-warning mt-2 mb-0">
            @Loc["ImportProfileEditor_StopFieldIgnoredWarning", Draft.SheetName, fixedStopField]
        </div>
    }
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}sheet-rule-zero-energie-expected-value-input")" class="form-control" @bind="Draft.ZeroEnergieExpectedValue" @bind:after="MarkDirty"
               placeholder="@Loc["ImportProfileEditor_ZeroEnergieExpectedValuePlaceholder"]" />
        <label for="@($"{IdPrefix}sheet-rule-zero-energie-expected-value-input")">@Loc["ImportProfileEditor_ZeroEnergieExpectedValueLabel"]</label>
    </div>
    @if (ignored.ZeroEnergieExpectedValueIgnored)
    {
        <div id="@($"{IdPrefix}zero-energie-ignored-warning")" class="alert alert-warning mt-2 mb-0">
            @Loc["ImportProfileEditor_ZeroEnergieIgnoredWarning", Draft.SheetName]
        </div>
    }
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}sheet-rule-default-couleur-etiquette-input")" class="form-control" @bind="Draft.DefaultCouleurEtiquette" @bind:after="MarkDirty"
               placeholder="@Loc["ImportProfileEditor_DefaultCouleurEtiquettePlaceholder"]" />
        <label for="@($"{IdPrefix}sheet-rule-default-couleur-etiquette-input")">@Loc["ImportProfileEditor_DefaultCouleurEtiquetteLabel"]</label>
    </div>
    @if (ignored.DefaultCouleurIgnoredBecauseCell)
    {
        <div id="@($"{IdPrefix}default-couleur-ignored-warning")" class="alert alert-warning mt-2 mb-0">
            @Loc["ImportProfileEditor_DefaultCouleurIgnoredBecauseCellWarning"]
        </div>
    }
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}sheet-rule-couleur-etiquette-cell-input")" class="form-control" @bind="Draft.CouleurEtiquetteCellRange" @bind:after="MarkDirty"
               placeholder="@Loc["ImportProfileEditor_CouleurEtiquetteCellPlaceholder"]" />
        <label for="@($"{IdPrefix}sheet-rule-couleur-etiquette-cell-input")">@Loc["ImportProfileEditor_CouleurEtiquetteCellLabel"]</label>
    </div>
    @if (ignored.CouleurEtiquetteCellIgnored)
    {
        <div id="@($"{IdPrefix}couleur-etiquette-cell-ignored-warning")" class="alert alert-warning mt-2 mb-0">
            @Loc["ImportProfileEditor_CouleurEtiquetteCellIgnoredWarning"]
        </div>
    }
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}sheet-rule-allowed-couleurs-etiquette-input")" class="form-control" @bind="Draft.AllowedCouleursEtiquette" @bind:after="MarkDirty"
               placeholder="@Loc["ImportProfileEditor_AllowedCouleursEtiquettePlaceholder"]" />
        <label for="@($"{IdPrefix}sheet-rule-allowed-couleurs-etiquette-input")">@Loc["ImportProfileEditor_AllowedCouleursEtiquetteLabel"]</label>
    </div>
    @if (ignored.AllowedCouleursIgnoredWithoutCell)
    {
        <div id="@($"{IdPrefix}allowed-couleurs-ignored-warning")" class="alert alert-warning mt-2 mb-0">
            @Loc["ImportProfileEditor_AllowedCouleursIgnoredWithoutCellWarning"]
        </div>
    }
    @if (ignored.CouleurEtiquetteIgnored)
    {
        <div id="@($"{IdPrefix}couleur-etiquette-ignored-warning")" class="alert alert-warning mt-2 mb-0">
            @Loc["ImportProfileEditor_CouleurEtiquetteIgnoredWarning", Draft.SheetName]
        </div>
    }
</div>
</div>
</div>

<div class="card bg-light mb-3">
<div class="card-body">
<h3 class="h5">@Loc["ImportProfileEditor_FieldsHeading"]</h3>
@if (Draft.Fields.Count > 0)
{
    <ul class="block-field-list">
        @for (var j = 0; j < Draft.Fields.Count; j++)
        {
            var fieldIndex = j;
            var field = Draft.Fields[fieldIndex];
            @if (_fieldEdit.IsOpen(fieldIndex))
            {
                <li class="block-field-item-editing">
                    <BlockFieldForm IdPrefix="@($"{IdPrefix}block-field-{fieldIndex}-")"
                                    Draft="field"
                                    SubmitButtonId="@($"{IdPrefix}save-block-field-button-{fieldIndex}")"
                                    SubmitLabel="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                    ShowCancel="true"
                                    CancelButtonId="@($"{IdPrefix}cancel-block-field-button-{fieldIndex}")"
                                    OnCancel="() => _fieldEdit.Cancel(Draft.Fields)"
                                    ShowIsRequired="!isTaskSheet"
                                    OnDirty="MarkDirty"
                                    OnSubmit="() => SubmitField(fieldIndex)" />
                </li>
            }
            else
            {
                <li class="block-field-item">
                    <div class="block-field-info">
                        <span class="block-field-name">@field.Name</span>
                        <span class="block-field-range text-muted font-monospace">@field.AbsoluteRange</span>
                        @if (!field.IsRequired && !isTaskSheet)
                        {
                            <span id="@($"{IdPrefix}block-field-optional-badge-{fieldIndex}")" class="badge text-bg-light border">@Loc["ImportProfileEditor_FieldOptionalBadge"]</span>
                        }
                    </div>
                    <div class="block-field-actions">
                        <button id="@($"{IdPrefix}modify-block-field-button-{fieldIndex}")" type="button"
                                class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                aria-label="@Loc["ImportProfileEditor_ModifyButton"]"
                                title="@Loc["ImportProfileEditor_ModifyButton"]"
                                @onclick="() => _fieldEdit.Open(Draft.Fields, fieldIndex)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12z" />
                                <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                            </svg>
                        </button>
                        <button id="@($"{IdPrefix}delete-block-field-button-{fieldIndex}")" type="button"
                                class="btn btn-sm btn-outline-danger block-field-icon-btn"
                                aria-label="@Loc["ImportProfileEditor_DeleteButton"]"
                                title="@Loc["ImportProfileEditor_DeleteButton"]"
                                @onclick="() => Delete(Draft.Fields, fieldIndex, _fieldEdit)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                            </svg>
                        </button>
                    </div>
                </li>
            }
        }
    </ul>
}
<BlockFieldForm IdPrefix="@($"{IdPrefix}block-field-")"
                Draft="Draft.PendingField"
                SubmitButtonId="@($"{IdPrefix}add-block-field-button")"
                SubmitLabel="@Loc["ImportProfileEditor_AddFieldButton"]"
                ShowIsRequired="!isTaskSheet"
                OnDirty="MarkDirty"
                OnSubmit="() => SubmitField(null)" />
</div>
</div>

<div class="card bg-light mb-3">
<div class="card-body">
<h3 class="h5">@Loc["ImportProfileEditor_UnconditionalColonnesHeading"]</h3>
@if (Draft.UnconditionalColonneNames.Count > 0)
{
    <ul class="block-field-list">
        @for (var j = 0; j < Draft.UnconditionalColonneNames.Count; j++)
        {
            var itemIndex = j;
            var colonne = Draft.UnconditionalColonneNames[itemIndex];
            @if (_unconditionalColonneEdit.IsOpen(itemIndex))
            {
                <li class="block-field-item-editing">
                    @if (!string.IsNullOrEmpty(colonne.Error))
                    {
                        <div class="alert alert-danger" role="alert">@colonne.Error</div>
                    }
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <input id="@($"{IdPrefix}unconditional-colonne-edit-input-{itemIndex}")" class="form-control"
                                   @bind="colonne.Value" @bind:after="MarkDirty" />
                        </div>
                        <div class="col-auto block-field-actions">
                            <button id="@($"{IdPrefix}save-unconditional-colonne-button-{itemIndex}")" type="button"
                                    class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                    aria-label="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                    title="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                    @onclick="() => SubmitUnconditionalColonne(itemIndex)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022z" />
                                </svg>
                            </button>
                            <button id="@($"{IdPrefix}cancel-unconditional-colonne-edit-button-{itemIndex}")" type="button"
                                    class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                    aria-label="@Loc["ImportProfileEditor_CancelButton"]"
                                    title="@Loc["ImportProfileEditor_CancelButton"]"
                                    @onclick="() => _unconditionalColonneEdit.Cancel(Draft.UnconditionalColonneNames)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </li>
            }
            else
            {
                <li class="block-field-item">
                    <div class="block-field-info">
                        <span class="block-field-name">@colonne.Value</span>
                    </div>
                    <div class="block-field-actions">
                        <button id="@($"{IdPrefix}edit-unconditional-colonne-button-{itemIndex}")" type="button"
                                class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                aria-label="@Loc["ImportProfileEditor_ModifyButton"]"
                                title="@Loc["ImportProfileEditor_ModifyButton"]"
                                @onclick="() => _unconditionalColonneEdit.Open(Draft.UnconditionalColonneNames, itemIndex)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12z" />
                                <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                            </svg>
                        </button>
                        <button id="@($"{IdPrefix}delete-unconditional-colonne-button-{itemIndex}")" type="button"
                                class="btn btn-sm btn-outline-danger block-field-icon-btn"
                                aria-label="@Loc["ImportProfileEditor_DeleteButton"]"
                                title="@Loc["ImportProfileEditor_DeleteButton"]"
                                @onclick="() => Delete(Draft.UnconditionalColonneNames, itemIndex, _unconditionalColonneEdit)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                            </svg>
                        </button>
                    </div>
                </li>
            }
        }
    </ul>
}
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}unconditional-colonne-name-input")" @ref="_unconditionalColonneNameInputRef" class="form-control"
               @bind="Draft.PendingUnconditionalColonneName.Value" @bind:after="MarkDirty"
               @onkeydown="OnUnconditionalColonneRowKeyDownAsync" @onfocusout="OnUnconditionalColonneRowBlurAsync"
               placeholder="@Loc["ImportProfileEditor_ColonneNamePlaceholder"]" />
        <label for="@($"{IdPrefix}unconditional-colonne-name-input")">@Loc["ImportProfileEditor_ColonneNameLabel"]</label>
    </div>
</div>
<div class="right-aligned-actions">
    <button id="@($"{IdPrefix}add-unconditional-colonne-button")" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="AddUnconditionalColonne">
        @((MarkupString)AdminIconMarkup.Plus) @Loc["ImportProfileEditor_AddColonneButton"]
    </button>
</div>
</div>
</div>

<div class="card bg-light mb-3">
<div class="card-body">
<h3 class="h5">@Loc["ImportProfileEditor_PointRulesHeading"]</h3>
@if (!isTaskSheet)
{
    <div class="form-check mb-3">
        <input id="@($"{IdPrefix}sheet-rule-warn-when-no-conditional-point-checkbox")" type="checkbox" class="form-check-input"
               @bind="Draft.WarnWhenNoConditionalPoint" @bind:after="MarkDirty" />
        <label class="form-check-label" for="@($"{IdPrefix}sheet-rule-warn-when-no-conditional-point-checkbox")">@Loc["ImportProfileEditor_WarnWhenNoConditionalPointLabel"]</label>
    </div>
}
@if (ignored.ConditionalPointRulesIgnored)
{
    <div id="@($"{IdPrefix}point-rules-ignored-warning")" class="alert alert-warning">
        @Loc["ImportProfileEditor_PointRulesIgnoredWarning", Draft.SheetName, Loc["ImportProfileEditor_FieldPresencePointRulesHeading"]]
    </div>
}
@if (Draft.PointRules.Count > 0)
{
    <ul class="block-field-list">
        @for (var j = 0; j < Draft.PointRules.Count; j++)
        {
            var itemIndex = j;
            var pointRule = Draft.PointRules[itemIndex];
            @if (_pointRuleEdit.IsOpen(itemIndex))
            {
                <li class="block-field-item-editing">
                    @if (!string.IsNullOrEmpty(pointRule.Error))
                    {
                        <div class="alert alert-danger" role="alert">@pointRule.Error</div>
                    }
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <input id="@($"{IdPrefix}conditional-point-rule-edit-colonne-name-input-{itemIndex}")" class="form-control"
                                   @bind="pointRule.ColonneName" @bind:after="MarkDirty" />
                        </div>
                        <div class="col">
                            <select id="@($"{IdPrefix}conditional-point-rule-edit-source-field-input-{itemIndex}")" class="form-select"
                                    @bind="pointRule.SourceFieldName" @bind:after="MarkDirty">
                                @SourceFieldOptions(blockFieldNames, pointRule.SourceFieldName)
                            </select>
                        </div>
                        <div class="col">
                            <select id="@($"{IdPrefix}conditional-point-rule-edit-operator-select-{itemIndex}")" class="form-select"
                                    @bind="pointRule.Operator" @bind:after="() => OnOperatorChanged(pointRule)">
                                @OperatorOptions
                            </select>
                        </div>
                        @if (pointRule.Operator != ConditionOperator.IsNotBlank)
                        {
                            <div class="col">
                                <input id="@($"{IdPrefix}conditional-point-rule-edit-comparison-value-input-{itemIndex}")" class="form-control"
                                       @bind="pointRule.ComparisonValue" @bind:after="MarkDirty" />
                            </div>
                        }
                        <div class="col-auto block-field-actions">
                            <button id="@($"{IdPrefix}save-conditional-point-rule-button-{itemIndex}")" type="button"
                                    class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                    aria-label="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                    title="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                    @onclick="() => SubmitPointRule(itemIndex)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022z" />
                                </svg>
                            </button>
                            <button id="@($"{IdPrefix}cancel-conditional-point-rule-edit-button-{itemIndex}")" type="button"
                                    class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                    aria-label="@Loc["ImportProfileEditor_CancelButton"]"
                                    title="@Loc["ImportProfileEditor_CancelButton"]"
                                    @onclick="() => _pointRuleEdit.Cancel(Draft.PointRules)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </li>
            }
            else
            {
                <li class="block-field-item">
                    <div class="block-field-info">
                        <span class="block-field-name">@pointRule.ColonneName</span>
                        <span class="block-field-range text-muted font-monospace">@pointRule.SourceFieldName @pointRule.Operator @pointRule.ComparisonValue</span>
                    </div>
                    <div class="block-field-actions">
                        <button id="@($"{IdPrefix}edit-conditional-point-rule-button-{itemIndex}")" type="button"
                                class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                aria-label="@Loc["ImportProfileEditor_ModifyButton"]"
                                title="@Loc["ImportProfileEditor_ModifyButton"]"
                                @onclick="() => _pointRuleEdit.Open(Draft.PointRules, itemIndex)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
