<!-- Lot 056 (56.7): submission and cancel are now visually distinct in every mode -- the
     submission button is always solid btn-secondary (icon still Plus in add mode / Check in edit
     mode, Lot 041 unchanged); "Cancel" stays btn-outline-secondary. Previously, in edit mode
     (ShowCancel=true), both buttons were btn-outline-secondary and strictly indistinguishable
     (audit S2.3 / lot 053 deferral -- the exact 29/07 usability remark this lot closes). -->
<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="Submit">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        else
        {
            @((MarkupString)AdminIconMarkup.Plus)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="() => OnCancel.InvokeAsync()">
            @((MarkupString)AdminIconMarkup.X) @Loc["ImportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public SheetExtractionRuleDraft Draft { get; set; } = new();

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-sheet-rule-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-sheet-rule-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    // Raised only once the whole rule converts successfully; the owner knows whether Draft is an
    // already-added rule or its pending "Add" row, and updates its own state accordingly.
    [Parameter]
    public EventCallback OnSubmit { get; set; }

    // Lot 056 (56.3): raised on every mutation of this form's state so the root editor's "unsaved
    // changes" guard covers in-progress edits too.
    [Parameter]
    public EventCallback OnDirty { get; set; }

    // One edit state per nested list: which item is open and its value when opened, for Cancel.
    private readonly ListItemEditState<BlockFieldDefinitionDraft> _fieldEdit = new();
    private readonly ListItemEditState<StringItemDraft> _unconditionalColonneEdit = new();
    private readonly ListItemEditState<ConditionalPointRuleDraft> _pointRuleEdit = new();
    private readonly ListItemEditState<FieldPresencePointRuleDraft> _fieldPresenceEdit = new();
    private readonly ListItemEditState<HeaderFieldRuleDraft> _headerFieldEdit = new();
    private readonly ListItemEditState<HeaderCompositeRuleDraft> _headerCompositeEdit = new();

    private ElementReference _unconditionalColonneNameInputRef;

    private void MarkDirty() => OnDirty.InvokeAsync();

    private string Localize(Exception exception) =>
        exception is DraftValidationException validation
            ? Loc[validation.ResourceKey]
            : BusinessExceptionLocalizer.TryLocalize(exception) ?? exception.Message;

    private void Delete<TDraft>(List<TDraft> list, int index, ListItemEditState<TDraft> edit) where TDraft : class
    {
        DraftListActions.Delete(list, index, edit);
        MarkDirty();
    }

    private void SubmitField(int? index)
    {
        Draft.PendingField.Warning = null;
        var target = index is { } i ? Draft.Fields[i] : Draft.PendingField;
        if (!DraftListActions.Submit(Draft.Fields, index, Draft.PendingField, p => Draft.PendingField = p, _fieldEdit,
                d => ImportProfileDraftMapper.ConvertField(d, Draft.FirstBlockStartRow), Localize))
        {
            return;
        }

        if (index is null && IsBeyondPracticalRange(target.AbsoluteRange))
        {
            Draft.PendingField.Warning = Loc["ImportProfileEditor_ExcelRangeBeyondPracticalRangeWarning"];
        }

        MarkDirty();
    }

    // The Add button ignores a blank Colonne name silently (no error), as it always has; an existing
    // one cleared in place is an error, reported by the conversion.
    private void AddUnconditionalColonne()
    {
        if (!string.IsNullOrWhiteSpace(Draft.PendingUnconditionalColonneName.Value))
        {
            SubmitUnconditionalColonne(null);
        }
    }

    private void SubmitUnconditionalColonne(int? index)
    {
        if (DraftListActions.Submit(Draft.UnconditionalColonneNames, index, Draft.PendingUnconditionalColonneName,
                p => Draft.PendingUnconditionalColonneName = p, _unconditionalColonneEdit,
                ImportProfileDraftMapper.ConvertUnconditionalColonneName, Localize))
        {
            MarkDirty();
        }
    }

    // Lot 056 (56.4): a single-field row. Focus is only returned to the field when something was
    // actually added -- a blank-field blur (the user tabbing/clicking elsewhere) must not steal focus.
    private async Task OnUnconditionalColonneRowBlurAsync()
    {
        if (string.IsNullOrWhiteSpace(Draft.PendingUnconditionalColonneName.Value))
        {
            return;
        }

        AddUnconditionalColonne();
        await _unconditionalColonneNameInputRef.FocusAsync();
    }

    private async Task OnUnconditionalColonneRowKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await OnUnconditionalColonneRowBlurAsync();
        }
    }

    // Lot 084: the source is picked among the block's own field names (the pending field's too); a
    // name outside them, from a profile saved before the lot, stays selected and is marked unknown.
    private IReadOnlyList<string> BlockFieldNames() =>
        Draft.Fields.Select(f => f.Name).Append(Draft.PendingField.Name)
            .Where(name => !string.IsNullOrWhiteSpace(name)).Distinct(StringComparer.Ordinal).ToList();

    private RenderFragment SourceFieldOptions(IReadOnlyList<string> names, string current) => __builder =>
    {
        <option value="">@Loc["ImportProfileEditor_SourceFieldChoose"]</option>
        @foreach (var name in names)
        {
            <option value="@name">@name</option>
        }
        @if (!string.IsNullOrEmpty(current) && !names.Contains(current))
        {
            <option value="@current">@Loc["ImportProfileEditor_SourceFieldUnknown", current]</option>
        }
    };

    private RenderFragment OperatorOptions => __builder =>
    {
        <option value="@ConditionOperator.Equals">@Loc["ImportProfileEditor_Operator_Equals"]</option>
        <option value="@ConditionOperator.NotEquals">@Loc["ImportProfileEditor_Operator_NotEquals"]</option>
        <option value="@ConditionOperator.IsNotBlank">@Loc["ImportProfileEditor_Operator_IsNotBlank"]</option>
    };

    // IsNotBlank takes no value: the hidden input must not keep a stale one.
    private void OnOperatorChanged(ConditionalPointRuleDraft rule)
    {
        if (rule.Operator == ConditionOperator.IsNotBlank)
        {
            rule.ComparisonValue = string.Empty;
        }

        MarkDirty();
    }

    private void SubmitPointRule(int? index)
    {
        if (DraftListActions.Submit(Draft.PointRules, index, Draft.PendingPointRule, p => Draft.PendingPointRule = p, _pointRuleEdit,
                ImportProfileDraftMapper.ConvertPointRule, Localize))
        {
            MarkDirty();
        }
    }

    private void SubmitFieldPresencePointRule(int? index)
    {
        Draft.PendingFieldPresencePointRule.Warning = null;
        var target = index is { } i ? Draft.FieldPresencePointRules[i] : Draft.PendingFieldPresencePointRule;
        if (!DraftListActions.Submit(Draft.FieldPresencePointRules, index, Draft.PendingFieldPresencePointRule,
                p => Draft.PendingFieldPresencePointRule = p, _fieldPresenceEdit,
                d => ImportProfileDraftMapper.ConvertFieldPresencePointRule(d, Draft.FirstBlockStartRow), Localize))
        {
            return;
        }

        if (index is null && IsBeyondPracticalRange(target.AbsoluteRange))
        {
            Draft.PendingFieldPresencePointRule.Warning = Loc["ImportProfileEditor_ExcelRangeBeyondPracticalRangeWarning"];
        }

        MarkDirty();
    }

    private void SubmitHeaderField(int? index)
    {
        if (DraftListActions.Submit(Draft.HeaderFields, index, Draft.PendingHeaderField, p => Draft.PendingHeaderField = p, _headerFieldEdit,
                ImportProfileDraftMapper.ConvertHeaderField, Localize))
        {
            MarkDirty();
        }
    }

    private void SubmitHeaderComposite(int? index)
    {
        if (DraftListActions.Submit(Draft.HeaderComposites, index, Draft.PendingHeaderComposite, p => Draft.PendingHeaderComposite = p,
                _headerCompositeEdit, ImportProfileDraftMapper.ConvertHeaderComposite, Localize))
        {
            MarkDirty();
        }
    }

    private bool IsBeyondPracticalRange(string absoluteRange) =>
        BlockFieldRangeFormatter.FromAbsoluteRange(absoluteRange, Draft.FirstBlockStartRow).IsBeyondPracticalRange;

    private string FormatHeaderFieldSummary(HeaderFieldRuleDraft field)
    {
        var indicators = new List<string>();
        if (field.StripReperePrefix)
        {
            indicators.Add(Loc["ImportProfileEditor_HeaderFieldStripPrefixIndicator"]);
        }

        if (!string.IsNullOrWhiteSpace(field.DateFormat))
        {
            indicators.Add(Loc["ImportProfileEditor_HeaderFieldDateFormatIndicator", field.DateFormat]);
        }

        return indicators.Count == 0 ? field.Range : $"{field.Range} ({string.Join(", ", indicators)})";
    }

    // UI-only advisory (Lot 048, 48.5) -- never consulted by extraction. Compares the current form state
    // against KnownHeaderFieldNames.For(SheetName), ordinally/case-sensitively (matching the real
    // resolver's own Dictionary<string, ...> lookup).
    private IReadOnlyList<string> GetMissingWellKnownNames()
    {
        var expected = KnownHeaderFieldNames.For(Draft.SheetName);
        if (expected.Fields.Count == 0 && expected.Composites.Count == 0)
        {
            return [];
        }

        var presentFields = Draft.HeaderFields.Select(f => f.Name).ToHashSet(StringComparer.Ordinal);
        var presentComposites = Draft.HeaderComposites.Select(c => c.Name).ToHashSet(StringComparer.Ordinal);

        return
        [
            .. expected.Fields.Where(name => !presentFields.Contains(name)),
            .. expected.Composites.Where(name => !presentComposites.Contains(name)),
        ];
    }

    // The rule's own submit button: validates the whole rule, including its still-pending nested rows
    // (ImportProfileDraftMapper.ConvertSheetRule), and tells the owner only on success.
    private async Task Submit()
    {
        DraftListActions.ClearErrors(Draft);
        var result = ImportProfileDraftMapper.ConvertSheetRule(Draft);
        if (!result.IsSuccess)
        {
            DraftListActions.ApplyErrors(result.Errors, Localize);
            return;
        }

        await OnSubmit.InvokeAsync();
    }
}
