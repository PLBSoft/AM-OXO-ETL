<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}point-rule-colonne-name-input")" class="form-control" @bind="_newPointRuleColonneName"
               placeholder="@Loc["ImportProfileEditor_ColonneNamePlaceholder"]" />
        <label for="@($"{IdPrefix}point-rule-colonne-name-input")">@Loc["ImportProfileEditor_ColonneNameLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}point-rule-source-field-name-input")" class="form-control" @bind="_newPointRuleSourceFieldName"
               placeholder="@Loc["ImportProfileEditor_SourceFieldNamePlaceholder"]" />
        <label for="@($"{IdPrefix}point-rule-source-field-name-input")">@Loc["ImportProfileEditor_SourceFieldNameLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <select id="@($"{IdPrefix}point-rule-operator-select")" class="form-select" @bind="_newPointRuleOperator">
            <option value="@ConditionOperator.Equals">@Loc["ImportProfileEditor_Operator_Equals"]</option>
            <option value="@ConditionOperator.NotEquals">@Loc["ImportProfileEditor_Operator_NotEquals"]</option>
        </select>
        <label for="@($"{IdPrefix}point-rule-operator-select")">@Loc["ImportProfileEditor_OperatorLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}point-rule-comparison-value-input")" class="form-control" @bind="_newPointRuleComparisonValue"
               placeholder="@Loc["ImportProfileEditor_ComparisonValuePlaceholder"]" />
        <label for="@($"{IdPrefix}point-rule-comparison-value-input")">@Loc["ImportProfileEditor_ComparisonValueLabel"]</label>
    </div>
</div>
<div class="right-aligned-actions">
    <button id="@($"{IdPrefix}add-point-rule-button")" class="btn btn-outline-secondary w-100 mt-3" @onclick="AddPointRule">
        @Loc["ImportProfileEditor_AddPointRuleButton"]
    </button>
</div>
</div>
</div>

<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-outline-secondary w-100 mt-3" @onclick="Submit">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3" @onclick="Cancel">
            @Loc["ImportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter]
    public SheetExtractionRule? InitialRule { get; set; }

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-sheet-rule-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-sheet-rule-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback<SheetExtractionRule> OnSubmit { get; set; }

    private string _sheetName = string.Empty;
    private int _firstBlockStartRow;
    private int _step;
    private string _stopFieldName = string.Empty;
    private readonly List<BlockFieldDefinition> _fields = [];
    private readonly List<string> _unconditionalColonneNames = [];
    private readonly List<ConditionalPointRule> _pointRules = [];

    private int? _editingFieldIndex;

    private string _newUnconditionalColonneName = string.Empty;
    private string _newPointRuleColonneName = string.Empty;
    private string _newPointRuleSourceFieldName = string.Empty;
    private ConditionOperator _newPointRuleOperator = ConditionOperator.Equals;
    private string _newPointRuleComparisonValue = string.Empty;

    private int? _editingUnconditionalColonneIndex;
    private string _editingUnconditionalColonneValue = string.Empty;
    private string? _unconditionalColonneEditError;

    private int? _editingPointRuleIndex;
    private string _editingPointRuleColonneName = string.Empty;
    private string _editingPointRuleSourceFieldName = string.Empty;
    private ConditionOperator _editingPointRuleOperator = ConditionOperator.Equals;
    private string _editingPointRuleComparisonValue = string.Empty;
    private string? _pointRuleEditError;

    private string? _errorMessage;

    // Only ever runs once per mounted instance -- the parent gives an edit-mode instance a fresh
    // component identity (conditionally rendered inside an @if, not a persistently bound one), so
    // InitialRule never changes underneath an already-initialized instance.
    protected override void OnInitialized()
    {
        if (InitialRule is null)
        {
            return;
        }

        _sheetName = InitialRule.SheetName;
        _firstBlockStartRow = InitialRule.Locator.FirstBlockStartRow;
        _step = InitialRule.Locator.Step;
        _stopFieldName = InitialRule.Locator.StopFieldName;
        _fields.AddRange(InitialRule.Locator.Fields);
        _unconditionalColonneNames.AddRange(InitialRule.UnconditionalColonneNames);
        _pointRules.AddRange(InitialRule.PointRules);
    }

    private void AddBlockField(BlockFieldDefinition field) => _fields.Add(field);

    private void HandleSaveBlockField(int fieldIndex, BlockFieldDefinition updated)
    {
        _fields[fieldIndex] = updated;
        _editingFieldIndex = null;
    }

    private void DeleteBlockField(int fieldIndex)
    {
        _fields.RemoveAt(fieldIndex);
        if (_editingFieldIndex == fieldIndex)
        {
            _editingFieldIndex = null;
        }
    }

    private void AddUnconditionalColonneName()
    {
        if (string.IsNullOrWhiteSpace(_newUnconditionalColonneName))
        {
            return;
        }

        _unconditionalColonneNames.Add(_newUnconditionalColonneName);
        _newUnconditionalColonneName = string.Empty;
    }

    private void StartUnconditionalColonneEdit(int itemIndex)
    {
        _editingUnconditionalColonneIndex = itemIndex;
        _editingUnconditionalColonneValue = _unconditionalColonneNames[itemIndex];
        _unconditionalColonneEditError = null;
    }

    private void SaveUnconditionalColonneEdit(int itemIndex)
    {
        if (string.IsNullOrWhiteSpace(_editingUnconditionalColonneValue))
        {
            _unconditionalColonneEditError = Loc["ImportProfileEditor_EmptyColonneNameError"];
            return;
        }

        _unconditionalColonneNames[itemIndex] = _editingUnconditionalColonneValue;
        _editingUnconditionalColonneIndex = null;
        _unconditionalColonneEditError = null;
    }

    private void CancelUnconditionalColonneEdit()
    {
        _editingUnconditionalColonneIndex = null;
        _unconditionalColonneEditError = null;
    }

    private void DeleteUnconditionalColonneName(int itemIndex)
    {
        _unconditionalColonneNames.RemoveAt(itemIndex);
        if (_editingUnconditionalColonneIndex == itemIndex)
        {
            _editingUnconditionalColonneIndex = null;
        }
    }

    private void AddPointRule()
    {
        _errorMessage = null;

        try
        {
            _pointRules.Add(new ConditionalPointRule(
                _newPointRuleSourceFieldName, _newPointRuleOperator, _newPointRuleComparisonValue, _newPointRuleColonneName));
            _newPointRuleColonneName = string.Empty;
            _newPointRuleSourceFieldName = string.Empty;
            _newPointRuleOperator = ConditionOperator.Equals;
            _newPointRuleComparisonValue = string.Empty;
        }
        catch (DomainValidationException ex)
        {
            _errorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }

    private void StartPointRuleEdit(int itemIndex)
    {
        var rule = _pointRules[itemIndex];
        _editingPointRuleIndex = itemIndex;
        _editingPointRuleColonneName = rule.ColonneName;
        _editingPointRuleSourceFieldName = rule.SourceFieldName;
        _editingPointRuleOperator = rule.Operator;
        _editingPointRuleComparisonValue = rule.ComparisonValue;
        _pointRuleEditError = null;
    }

    private void SavePointRuleEdit(int itemIndex)
    {
        _pointRuleEditError = null;

        try
        {
            _pointRules[itemIndex] = new ConditionalPointRule(
                _editingPointRuleSourceFieldName, _editingPointRuleOperator, _editingPointRuleComparisonValue, _editingPointRuleColonneName);
            _editingPointRuleIndex = null;
        }
        catch (DomainValidationException ex)
        {
            _pointRuleEditError = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }

    private void CancelPointRuleEdit()
    {
        _editingPointRuleIndex = null;
        _pointRuleEditError = null;
    }

    private void DeletePointRule(int itemIndex)
    {
        _pointRules.RemoveAt(itemIndex);
        if (_editingPointRuleIndex == itemIndex)
        {
            _editingPointRuleIndex = null;
        }
    }

    private async Task Submit()
    {
        _errorMessage = null;

        try
        {
            var locator = new RepeatingBlockLocator(_sheetName, _firstBlockStartRow, _step, _stopFieldName, _fields);

            // SheetExtractionRule stores this list by reference (unlike PointRules, which it copies) --
            // pass a snapshot so ResetForm()'s Clear() below can't reach back into the rule we just handed off.
            var rule = new SheetExtractionRule(_sheetName, locator, _pointRules, [.. _unconditionalColonneNames]);

            await OnSubmit.InvokeAsync(rule);

            ResetForm();
        }
        catch (Exception ex) when (ex is DomainValidationException or DomainArgumentOutOfRangeException or DomainRuleViolationException)
        {
            _errorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }

    private async Task Cancel() => await OnCancel.InvokeAsync();

    private void ResetForm()
    {
        _sheetName = string.Empty;
        _firstBlockStartRow = 0;
        _step = 0;
        _stopFieldName = string.Empty;
        _fields.Clear();
        _unconditionalColonneNames.Clear();
        _pointRules.Clear();
        _editingFieldIndex = null;
        _newUnconditionalColonneName = string.Empty;
        _newPointRuleColonneName = string.Empty;
        _newPointRuleSourceFieldName = string.Empty;
        _newPointRuleOperator = ConditionOperator.Equals;
        _newPointRuleComparisonValue = string.Empty;
        _editingUnconditionalColonneIndex = null;
        _unconditionalColonneEditError = null;
        _editingPointRuleIndex = null;
        _pointRuleEditError = null;
    }
}
