@using ExcelETL.Application.Exceptions
@using ExcelETL.BlazorAdmin.Formatting
@using ExcelETL.Domain.Exceptions
@using ExcelETL.Domain.Extraction.Primitives
@using ExcelETL.Domain.Extraction.Profile

@inject BusinessExceptionLocalizer BusinessExceptionLocalizer
@inject IStringLocalizer<BlazorAdminMessages> Loc

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<div class="row g-2 mb-2">
    <div class="col">
        <label class="form-label" for="@($"{IdPrefix}sheet-rule-name-input")">@Loc["ImportProfileEditor_SheetNameLabel"]</label>
        <input id="@($"{IdPrefix}sheet-rule-name-input")" class="form-control" @bind="_sheetName"
               placeholder="@Loc["ImportProfileEditor_SheetNamePlaceholder"]" />
    </div>
    <div class="col">
        <label class="form-label" for="@($"{IdPrefix}sheet-rule-first-block-start-row-input")">@Loc["ImportProfileEditor_FirstBlockStartRowLabel"]</label>
        <input id="@($"{IdPrefix}sheet-rule-first-block-start-row-input")" type="number" class="form-control" @bind="_firstBlockStartRow"
               placeholder="@Loc["ImportProfileEditor_FirstBlockStartRowPlaceholder"]" />
    </div>
    <div class="col">
        <label class="form-label" for="@($"{IdPrefix}sheet-rule-step-input")">@Loc["ImportProfileEditor_StepLabel"]</label>
        <input id="@($"{IdPrefix}sheet-rule-step-input")" type="number" class="form-control" @bind="_step"
               placeholder="@Loc["ImportProfileEditor_StepPlaceholder"]" />
    </div>
    <div class="col">
        <label class="form-label" for="@($"{IdPrefix}sheet-rule-stop-field-name-input")">@Loc["ImportProfileEditor_StopFieldNameLabel"]</label>
        <input id="@($"{IdPrefix}sheet-rule-stop-field-name-input")" class="form-control" @bind="_stopFieldName"
               placeholder="@Loc["ImportProfileEditor_StopFieldNamePlaceholder"]" />
    </div>
</div>

<h5>@Loc["ImportProfileEditor_FieldsHeading"]</h5>
@if (_fields.Count > 0)
{
    <ul class="block-field-list">
        @for (var j = 0; j < _fields.Count; j++)
        {
            var fieldIndex = j;
            var field = _fields[fieldIndex];
            @if (_editingFieldIndex == fieldIndex)
            {
                <li class="block-field-item-editing">
                    <BlockFieldForm IdPrefix="@($"{IdPrefix}block-field-{fieldIndex}-")"
                                     InitialField="field"
                                     FirstBlockStartRow="_firstBlockStartRow"
                                     SubmitButtonId="@($"{IdPrefix}save-block-field-button-{fieldIndex}")"
                                     SubmitLabel="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                     ShowCancel="true"
                                     CancelButtonId="@($"{IdPrefix}cancel-block-field-button-{fieldIndex}")"
                                     OnCancel="() => _editingFieldIndex = null"
                                     OnSubmit="(BlockFieldDefinition updated) => HandleSaveBlockField(fieldIndex, updated)" />
                </li>
            }
            else
            {
                <li class="block-field-item">
                    <div class="block-field-info">
                        <span class="block-field-name">@field.Name</span>
                        <span class="block-field-range text-muted font-monospace">@BlockFieldRangeFormatter.ToAbsoluteRange(_firstBlockStartRow, field.ColumnRange, field.RowOffsetStart, field.RowOffsetEnd)</span>
                    </div>
                    <div class="block-field-actions">
                        <button id="@($"{IdPrefix}modify-block-field-button-{fieldIndex}")" type="button"
                                class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                aria-label="@Loc["ImportProfileEditor_ModifyButton"]"
                                @onclick="() => _editingFieldIndex = fieldIndex">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12z" />
                                <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                            </svg>
                        </button>
                        <button id="@($"{IdPrefix}delete-block-field-button-{fieldIndex}")" type="button"
                                class="btn btn-sm btn-outline-danger block-field-icon-btn"
                                aria-label="@Loc["ImportProfileEditor_DeleteButton"]"
                                @onclick="() => DeleteBlockField(fieldIndex)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                            </svg>
                        </button>
                    </div>
                </li>
            }
        }
    </ul>
}
<BlockFieldForm IdPrefix="@($"{IdPrefix}block-field-")"
                FirstBlockStartRow="_firstBlockStartRow"
                SubmitButtonId="@($"{IdPrefix}add-block-field-button")"
                SubmitLabel="@Loc["ImportProfileEditor_AddFieldButton"]"
                OnSubmit="AddBlockField" />

<h5>@Loc["ImportProfileEditor_UnconditionalColonnesHeading"]</h5>
@if (_unconditionalColonneNames.Count > 0)
{
    <p>@string.Join(", ", _unconditionalColonneNames)</p>
}
<div class="row g-2 mb-2">
    <div class="col">
        <input id="@($"{IdPrefix}unconditional-colonne-name-input")" class="form-control" @bind="_newUnconditionalColonneName"
               placeholder="@Loc["ImportProfileEditor_ColonneNamePlaceholder"]" />
    </div>
    <div class="col-auto">
        <button id="@($"{IdPrefix}add-unconditional-colonne-button")" class="btn btn-secondary" @onclick="AddUnconditionalColonneName">
            @Loc["ImportProfileEditor_AddColonneButton"]
        </button>
    </div>
</div>

<h5>@Loc["ImportProfileEditor_PointRulesHeading"]</h5>
@if (_pointRules.Count > 0)
{
    <ul>
        @foreach (var pointRule in _pointRules)
        {
            <li>@pointRule.ColonneName (@pointRule.SourceFieldName @pointRule.Operator @pointRule.ComparisonValue)</li>
        }
    </ul>
}
<div class="row g-2 mb-3">
    <div class="col">
        <input id="@($"{IdPrefix}point-rule-colonne-name-input")" class="form-control" @bind="_newPointRuleColonneName"
               placeholder="@Loc["ImportProfileEditor_ColonneNamePlaceholder"]" />
    </div>
    <div class="col">
        <input id="@($"{IdPrefix}point-rule-source-field-name-input")" class="form-control" @bind="_newPointRuleSourceFieldName"
               placeholder="@Loc["ImportProfileEditor_SourceFieldNamePlaceholder"]" />
    </div>
    <div class="col">
        <select id="@($"{IdPrefix}point-rule-operator-select")" class="form-select" @bind="_newPointRuleOperator">
            <option value="@ConditionOperator.Equals">@Loc["ImportProfileEditor_Operator_Equals"]</option>
            <option value="@ConditionOperator.NotEquals">@Loc["ImportProfileEditor_Operator_NotEquals"]</option>
        </select>
    </div>
    <div class="col">
        <input id="@($"{IdPrefix}point-rule-comparison-value-input")" class="form-control" @bind="_newPointRuleComparisonValue"
               placeholder="@Loc["ImportProfileEditor_ComparisonValuePlaceholder"]" />
    </div>
    <div class="col-auto">
        <button id="@($"{IdPrefix}add-point-rule-button")" class="btn btn-secondary" @onclick="AddPointRule">
            @Loc["ImportProfileEditor_AddPointRuleButton"]
        </button>
    </div>
</div>

<button id="@SubmitButtonId" class="btn btn-primary" @onclick="Submit">
    @SubmitLabel
</button>
@if (ShowCancel)
{
    <button id="@CancelButtonId" class="btn btn-secondary" @onclick="Cancel">
        @Loc["ImportProfileEditor_CancelButton"]
    </button>
}

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter]
    public SheetExtractionRule? InitialRule { get; set; }

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-sheet-rule-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-sheet-rule-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback<SheetExtractionRule> OnSubmit { get; set; }

    private string _sheetName = string.Empty;
    private int _firstBlockStartRow;
    private int _step;
    private string _stopFieldName = string.Empty;
    private readonly List<BlockFieldDefinition> _fields = [];
    private readonly List<string> _unconditionalColonneNames = [];
    private readonly List<ConditionalPointRule> _pointRules = [];

    private int? _editingFieldIndex;

    private string _newUnconditionalColonneName = string.Empty;
    private string _newPointRuleColonneName = string.Empty;
    private string _newPointRuleSourceFieldName = string.Empty;
    private ConditionOperator _newPointRuleOperator = ConditionOperator.Equals;
    private string _newPointRuleComparisonValue = string.Empty;

    private string? _errorMessage;

    // Only ever runs once per mounted instance -- the parent gives an edit-mode instance a fresh
    // component identity (conditionally rendered inside an @if, not a persistently bound one), so
    // InitialRule never changes underneath an already-initialized instance.
    protected override void OnInitialized()
    {
        if (InitialRule is null)
        {
            return;
        }

        _sheetName = InitialRule.SheetName;
        _firstBlockStartRow = InitialRule.Locator.FirstBlockStartRow;
        _step = InitialRule.Locator.Step;
        _stopFieldName = InitialRule.Locator.StopFieldName;
        _fields.AddRange(InitialRule.Locator.Fields);
        _unconditionalColonneNames.AddRange(InitialRule.UnconditionalColonneNames);
        _pointRules.AddRange(InitialRule.PointRules);
    }

    private void AddBlockField(BlockFieldDefinition field) => _fields.Add(field);

    private void HandleSaveBlockField(int fieldIndex, BlockFieldDefinition updated)
    {
        _fields[fieldIndex] = updated;
        _editingFieldIndex = null;
    }

    private void DeleteBlockField(int fieldIndex)
    {
        _fields.RemoveAt(fieldIndex);
        if (_editingFieldIndex == fieldIndex)
        {
            _editingFieldIndex = null;
        }
    }

    private void AddUnconditionalColonneName()
    {
        if (string.IsNullOrWhiteSpace(_newUnconditionalColonneName))
        {
            return;
        }

        _unconditionalColonneNames.Add(_newUnconditionalColonneName);
        _newUnconditionalColonneName = string.Empty;
    }

    private void AddPointRule()
    {
        _errorMessage = null;

        try
        {
            _pointRules.Add(new ConditionalPointRule(
                _newPointRuleSourceFieldName, _newPointRuleOperator, _newPointRuleComparisonValue, _newPointRuleColonneName));
            _newPointRuleColonneName = string.Empty;
            _newPointRuleSourceFieldName = string.Empty;
            _newPointRuleOperator = ConditionOperator.Equals;
            _newPointRuleComparisonValue = string.Empty;
        }
        catch (DomainValidationException ex)
        {
            _errorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }

    private async Task Submit()
    {
        _errorMessage = null;

        try
        {
            var locator = new RepeatingBlockLocator(_sheetName, _firstBlockStartRow, _step, _stopFieldName, _fields);

            // SheetExtractionRule stores this list by reference (unlike PointRules, which it copies) --
            // pass a snapshot so ResetForm()'s Clear() below can't reach back into the rule we just handed off.
            var rule = new SheetExtractionRule(_sheetName, locator, _pointRules, [.. _unconditionalColonneNames]);

            await OnSubmit.InvokeAsync(rule);

            ResetForm();
        }
        catch (Exception ex) when (ex is DomainValidationException or DomainArgumentOutOfRangeException or DomainRuleViolationException)
        {
            _errorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }

    private async Task Cancel() => await OnCancel.InvokeAsync();

    private void ResetForm()
    {
        _sheetName = string.Empty;
        _firstBlockStartRow = 0;
        _step = 0;
        _stopFieldName = string.Empty;
        _fields.Clear();
        _unconditionalColonneNames.Clear();
        _pointRules.Clear();
        _editingFieldIndex = null;
        _newUnconditionalColonneName = string.Empty;
        _newPointRuleColonneName = string.Empty;
        _newPointRuleSourceFieldName = string.Empty;
        _newPointRuleOperator = ConditionOperator.Equals;
        _newPointRuleComparisonValue = string.Empty;
    }
}
