@page "/export-profiles"
@attribute [Authorize(Roles = IdentitySeeder.AdminRoleName)]

@using ExcelETL.Application.Generation
@using ExcelETL.BlazorAdmin.Shared
@using ExcelETL.Domain.Generation.Profile
@using ExcelETL.Infrastructure.Identity
@using Microsoft.AspNetCore.Authorization

@inject IExportProfileStore ExportProfileStore
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject NavigationManager NavigationManager

<PageTitle>@Loc["ExportProfiles_PageTitle"]</PageTitle>

<h1>@Loc["ExportProfiles_PageTitle"]</h1>

<!-- Lot 030 (30.7): same "single row at every breakpoint, flex-fill" reversal as ImportProfiles.razor
     -- see the comment there for rationale. -->
<div class="right-aligned-actions d-flex gap-2 mb-3">
    <button id="test-export-profile-button" class="btn btn-secondary flex-fill" @onclick="TestProfile">
        @Loc["NavMenu_ExportProfileTest"]
    </button>
    <button id="create-export-profile-button" class="btn btn-primary flex-fill" @onclick="CreateProfile">
        @Loc["ExportProfiles_Create"]
    </button>
</div>

@if (_profiles is null)
{
    <p>@Loc["ExportProfiles_Loading"]</p>
}
else if (_profiles.Count == 0)
{
    <p>@Loc["ExportProfiles_NoEntries"]</p>
}
else
{
    <table class="table d-none d-md-table">
        <thead>
            <tr>
                <th>@Loc["ExportProfiles_Name"]</th>
                <th>@Loc["ExportProfiles_SheetCountHeader"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var profile in _profiles)
            {
                <tr>
                    <td>@profile.Name</td>
                    <td>@Loc["ExportProfiles_SheetCount", profile.SheetRules.Count]</td>
                    <td>
                        @if (_profileIdPendingDeletion == profile.Id)
                        {
                            <div id="@($"delete-export-profile-confirm-{profile.Id}")" class="right-aligned-actions">
                                <span class="text-danger me-auto">@Loc["ExportProfiles_ConfirmDeleteMessage", _profileNamePendingDeletion]</span>
                                <button id="@($"confirm-delete-export-profile-button-{profile.Id}")" type="button"
                                        class="btn btn-sm btn-danger"
                                        @onclick="() => ConfirmDeleteProfileAsync(profile.Id)">
                                    @Loc["ExportProfiles_ConfirmDeleteButton"]
                                </button>
                                <button id="@($"cancel-delete-export-profile-button-{profile.Id}")" type="button"
                                        class="btn btn-sm btn-secondary"
                                        @onclick="CancelDeleteProfile">
                                    @Loc["ExportProfiles_CancelDeleteButton"]
                                </button>
                            </div>
                        }
                        else
                        {
                            <button id="edit-export-profile-button-@profile.Id" type="button"
                                    class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                    aria-label="@Loc["ExportProfiles_Edit"]" title="@Loc["ExportProfiles_Edit"]"
                                    @onclick="() => EditProfile(profile)">
                                @((MarkupString)AdminIconMarkup.Pencil)
                            </button>
                            <button id="duplicate-export-profile-button-@profile.Id" type="button"
                                    class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                    aria-label="@Loc["ExportProfiles_Duplicate"]" title="@Loc["ExportProfiles_Duplicate"]"
                                    @onclick="() => DuplicateProfileAsync(profile)">
                                @((MarkupString)AdminIconMarkup.Copy)
                            </button>
                            <button id="delete-export-profile-button-@profile.Id" type="button"
                                    class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                    aria-label="@Loc["ExportProfiles_Delete", profile.Name]" title="@Loc["ExportProfiles_Delete", profile.Name]"
                                    @onclick="() => RequestDeleteProfile(profile)">
                                @((MarkupString)AdminIconMarkup.Trash)
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-md-none">
        @foreach (var profile in _profiles)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@profile.Name</h5>
                    <p class="card-text">@Loc["ExportProfiles_SheetCount", profile.SheetRules.Count]</p>
                    @if (_profileIdPendingDeletion == profile.Id)
                    {
                        <div id="@($"delete-export-profile-confirm-card-{profile.Id}")" class="right-aligned-actions">
                            <span class="text-danger me-auto">@Loc["ExportProfiles_ConfirmDeleteMessage", _profileNamePendingDeletion]</span>
                            <button id="@($"confirm-delete-export-profile-button-card-{profile.Id}")" type="button"
                                    class="btn btn-sm btn-danger"
                                    @onclick="() => ConfirmDeleteProfileAsync(profile.Id)">
                                @Loc["ExportProfiles_ConfirmDeleteButton"]
                            </button>
                            <button id="@($"cancel-delete-export-profile-button-card-{profile.Id}")" type="button"
                                    class="btn btn-sm btn-secondary"
                                    @onclick="CancelDeleteProfile">
                                @Loc["ExportProfiles_CancelDeleteButton"]
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="right-aligned-actions">
                            <button id="edit-export-profile-button-card-@profile.Id" type="button"
                                    class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                    aria-label="@Loc["ExportProfiles_Edit"]" title="@Loc["ExportProfiles_Edit"]"
                                    @onclick="() => EditProfile(profile)">
                                @((MarkupString)AdminIconMarkup.Pencil)
                            </button>
                            <button id="duplicate-export-profile-button-card-@profile.Id" type="button"
                                    class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                    aria-label="@Loc["ExportProfiles_Duplicate"]" title="@Loc["ExportProfiles_Duplicate"]"
                                    @onclick="() => DuplicateProfileAsync(profile)">
                                @((MarkupString)AdminIconMarkup.Copy)
                            </button>
                            <button id="delete-export-profile-button-card-@profile.Id" type="button"
                                    class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                    aria-label="@Loc["ExportProfiles_Delete", profile.Name]" title="@Loc["ExportProfiles_Delete", profile.Name]"
                                    @onclick="() => RequestDeleteProfile(profile)">
                                @((MarkupString)AdminIconMarkup.Trash)
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<ExportProfile>? _profiles;
    private Guid? _profileIdPendingDeletion;
    private string? _profileNamePendingDeletion;

    protected override async Task OnInitializedAsync() => await LoadProfilesAsync();

    private async Task LoadProfilesAsync() => _profiles = (await ExportProfileStore.GetAllAsync()).ToList();

    private void CreateProfile() => NavigationManager.NavigateTo("export-profiles/new");

    private void TestProfile() => NavigationManager.NavigateTo("export-profiles/test");

    private void EditProfile(ExportProfile profile) => NavigationManager.NavigateTo($"export-profiles/{profile.Id}/edit");

    private void RequestDeleteProfile(ExportProfile profile)
    {
        _profileIdPendingDeletion = profile.Id;
        _profileNamePendingDeletion = profile.Name;
    }

    private void CancelDeleteProfile()
    {
        _profileIdPendingDeletion = null;
        _profileNamePendingDeletion = null;
    }

    private async Task ConfirmDeleteProfileAsync(Guid id)
    {
        await ExportProfileStore.DeleteAsync(id);
        _profileIdPendingDeletion = null;
        _profileNamePendingDeletion = null;
        await LoadProfilesAsync();
    }

    private async Task DuplicateProfileAsync(ExportProfile profile)
    {
        var duplicateName = ProfileDuplicateNaming.BuildAvailableDuplicateName(
            profile.Name, Loc["ExportProfiles_DuplicateSuffix"].Value, _profiles!.Select(p => p.Name).ToList());
        var duplicate = new ExportProfile(duplicateName, profile.SheetRules);

        await ExportProfileStore.SaveAsync(duplicate);
        await LoadProfilesAsync();
    }
}
