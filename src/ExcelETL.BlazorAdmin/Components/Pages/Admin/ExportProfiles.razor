@page "/export-profiles"
@attribute [Authorize(Roles = IdentitySeeder.AdminRoleName)]

@using System.Text.RegularExpressions
@using ExcelETL.Application.Generation
@using ExcelETL.Domain.Generation.Profile
@using ExcelETL.Infrastructure.Identity
@using Microsoft.AspNetCore.Authorization

@inject IExportProfileStore ExportProfileStore
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject NavigationManager NavigationManager

<PageTitle>@Loc["ExportProfiles_PageTitle"]</PageTitle>

<h1>@Loc["ExportProfiles_PageTitle"]</h1>

<!-- V4: same "d-grid gap-2 d-md-flex" stacking idiom as ImportProfiles.razor -- see the comment
     there for rationale. -->
<div class="right-aligned-actions d-grid gap-2 d-md-flex mb-3">
    <button id="test-export-profile-button" class="btn btn-secondary w-100 mb-2" @onclick="TestProfile">
        @Loc["NavMenu_ExportProfileTest"]
    </button>
    <button id="create-export-profile-button" class="btn btn-primary w-100" @onclick="CreateProfile">
        @Loc["ExportProfiles_Create"]
    </button>
</div>

@if (_profiles is null)
{
    <p>@Loc["ExportProfiles_Loading"]</p>
}
else if (_profiles.Count == 0)
{
    <p>@Loc["ExportProfiles_NoEntries"]</p>
}
else
{
    <table class="table d-none d-md-table">
        <thead>
            <tr>
                <th>@Loc["ExportProfiles_Name"]</th>
                <th>@Loc["ExportProfiles_SheetCountHeader"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var profile in _profiles)
            {
                <tr>
                    <td>@profile.Name</td>
                    <td>@Loc["ExportProfiles_SheetCount", profile.SheetRules.Count]</td>
                    <td>
                        <button id="edit-export-profile-button-@profile.Id" type="button"
                                class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                aria-label="@Loc["ExportProfiles_Edit"]" title="@Loc["ExportProfiles_Edit"]"
                                @onclick="() => EditProfile(profile)">
                            @((MarkupString)PencilIconMarkup)
                        </button>
                        <button id="duplicate-export-profile-button-@profile.Id" type="button"
                                class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                aria-label="@Loc["ExportProfiles_Duplicate"]" title="@Loc["ExportProfiles_Duplicate"]"
                                @onclick="() => DuplicateProfileAsync(profile)">
                            @((MarkupString)CopyIconMarkup)
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-md-none">
        @foreach (var profile in _profiles)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@profile.Name</h5>
                    <p class="card-text">@Loc["ExportProfiles_SheetCount", profile.SheetRules.Count]</p>
                    <div class="right-aligned-actions">
                        <button id="edit-export-profile-button-card-@profile.Id" type="button"
                                class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                aria-label="@Loc["ExportProfiles_Edit"]" title="@Loc["ExportProfiles_Edit"]"
                                @onclick="() => EditProfile(profile)">
                            @((MarkupString)PencilIconMarkup)
                        </button>
                        <button id="duplicate-export-profile-button-card-@profile.Id" type="button"
                                class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                aria-label="@Loc["ExportProfiles_Duplicate"]" title="@Loc["ExportProfiles_Duplicate"]"
                                @onclick="() => DuplicateProfileAsync(profile)">
                            @((MarkupString)CopyIconMarkup)
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    // V3: same icon-only row actions as ImportProfiles.razor -- see the comment there for the
    // pencil-square/copy shape choice and .block-field-icon-btn reuse rationale.
    private const string PencilIconMarkup =
        """<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12z" /><path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" /></svg>""";

    private const string CopyIconMarkup =
        """<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z" /><path d="M2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1z" /></svg>""";

    private List<ExportProfile>? _profiles;

    protected override async Task OnInitializedAsync() => await LoadProfilesAsync();

    private async Task LoadProfilesAsync() => _profiles = (await ExportProfileStore.GetAllAsync()).ToList();

    private void CreateProfile() => NavigationManager.NavigateTo("export-profiles/new");

    private void TestProfile() => NavigationManager.NavigateTo("export-profiles/test");

    private void EditProfile(ExportProfile profile) => NavigationManager.NavigateTo($"export-profiles/{profile.Id}/edit");

    private async Task DuplicateProfileAsync(ExportProfile profile)
    {
        var duplicate = new ExportProfile(BuildAvailableDuplicateName(profile.Name), profile.SheetRules);

        await ExportProfileStore.SaveAsync(duplicate);
        await LoadProfilesAsync();
    }

    // See ImportProfiles.razor's BuildAvailableDuplicateName for the full rationale -- symmetric
    // auto-increment-suffix collision resolution (Lot 027, 27.4).
    private string BuildAvailableDuplicateName(string profileName)
    {
        var suffixText = Loc["ExportProfiles_DuplicateSuffix"].Value;
        var innerSuffix = suffixText.Trim().TrimStart('(').TrimEnd(')').Trim();

        var suffixPattern = new Regex($@"^(?<base>.+) \({Regex.Escape(innerSuffix)}(?: \d+)?\)$");
        var match = suffixPattern.Match(profileName);
        var baseName = match.Success ? match.Groups["base"].Value : profileName;

        var attempt = 1;
        while (true)
        {
            var candidate = attempt == 1
                ? $"{baseName} ({innerSuffix})"
                : $"{baseName} ({innerSuffix} {attempt})";

            var isTaken = _profiles!.Any(
                p => string.Equals(p.Name.Trim(), candidate.Trim(), StringComparison.OrdinalIgnoreCase));
            if (!isTaken)
            {
                return candidate;
            }

            attempt++;
        }
    }
}
