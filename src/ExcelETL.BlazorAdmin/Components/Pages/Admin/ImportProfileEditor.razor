@page "/import-profiles/new"
@page "/import-profiles/{Id:guid}/edit"
@attribute [Authorize]

@using ExcelETL.Application.Exceptions
@using ExcelETL.Application.Extraction.Oxo
@using ExcelETL.BlazorAdmin.Formatting
@using ExcelETL.BlazorAdmin.Shared
@using ExcelETL.Domain.Exceptions
@using ExcelETL.Domain.Extraction.Profile
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Routing

@inject IImportProfileStore ImportProfileStore
@inject BusinessExceptionLocalizer BusinessExceptionLocalizer
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject NavigationManager NavigationManager

<PageTitle>@(_editingId.HasValue ? Loc["ImportProfileEditor_EditPageTitle"] : Loc["ImportProfileEditor_PageTitle"])</PageTitle>

<!-- Lot 043 (43.1): warns before losing in-progress edits -- ConfirmExternalNavigation delegates
     to the browser's native dialog for tab-close/refresh/external navigation;
     OnBeforeInternalNavigation intercepts SPA navigation (sidebar links, etc.) and shows our own
     inline confirmation instead. Always rendered (harmless no-op when _hasUnsavedChanges is false). -->
<NavigationLock ConfirmExternalNavigation="_hasUnsavedChanges" OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" />

<!-- Lot 042 (42.3): matches ExportProfileEditor.razor's own container-fluid/px-3 wrapper (X6) --
     no functional reason found for the divergence, see 42.0's investigation; X6 was scoped only
     to the export screenshot at the time, never revisited for the import twin.
     Lot 053 (53.1): profile-editor-container caps this route at 1140px on wide screens (see
     app.css) -- shared verbatim with ExportProfileEditor.razor's own root container. -->
<!-- Lot 056 (56.5): Ctrl+Enter saves the profile from anywhere in the editor, through the same
     implicit-flush path as the CTA click (56.2). Plain Enter is deliberately left alone -- no
     preventDefault -- since there is no <form> element here to accidentally submit and every text
     input must keep behaving normally. -->
<div class="container-fluid px-3 profile-editor-container" @onkeydown="OnRootKeyDownAsync">

<h1>@(_editingId.HasValue ? Loc["ImportProfileEditor_EditPageTitle"] : Loc["ImportProfileEditor_PageTitle"])</h1>

<!-- X11 (Lot X): back link now lives in the shared top-row banner via SectionContent -- see
     PageBackNavLink.razor. Replaces the previous in-content btn-secondary button. -->
<PageBackNavLink Id="back-to-import-profiles-button" Label="@Loc["ImportProfileEditor_BackToListButton"]" OnClick="BackToList" />

@if (_showNavigationConfirmation)
{
    <div id="unsaved-changes-navigation-confirmation" class="alert alert-warning right-aligned-actions" role="alert">
        <span class="text-danger me-auto">@Loc["ImportProfileEditor_UnsavedChangesConfirmMessage"]</span>
        <button id="discard-changes-and-leave-button" class="btn btn-sm btn-danger" @onclick="DiscardChangesAndLeave">
            @Loc["ImportProfileEditor_DiscardChangesAndLeaveButton"]
        </button>
        <button id="stay-on-page-button" class="btn btn-sm btn-secondary" @onclick="StayOnPage">
            @Loc["ImportProfileEditor_StayOnPageButton"]
        </button>
    </div>
}

@if (_notFound)
{
    <div id="import-profile-not-found" class="alert alert-danger" role="alert">@Loc["ImportProfileEditor_ProfileNotFound"]</div>
}
else
{
@if (!string.IsNullOrEmpty(_profileErrorMessage))
{
    <div class="alert alert-danger" role="alert">@_profileErrorMessage</div>
}

<div class="mb-3">
    <div class="form-floating">
        <input id="profile-name-input" class="form-control" @bind="_name" @bind:after="MarkAsChanged" maxlength="@ImportProfile.MaxNameLength"
               placeholder="@Loc["ImportProfileEditor_NamePlaceholder"]" />
        <label for="profile-name-input">@Loc["ImportProfileEditor_NameLabel"]</label>
    </div>
</div>
<!-- Lot 053 (53.2): reopens 30.1's full-width stacking above 768px only, for these two short
     fields specifically -- "Nom du profil" above stays col-12 (identitaire principal, long by
     nature). Below 768px both columns collapse to col-12, unchanged from 30.1. -->
<div class="row g-3 mb-3">
    <div class="col-12 col-md-6">
        <div class="form-floating">
            <input id="profile-repere-prefix-input" class="form-control" @bind="_reperePrefix" @bind:after="MarkAsChanged"
                   placeholder="@Loc["ImportProfileEditor_ReperePrefixPlaceholder"]" />
            <label for="profile-repere-prefix-input">@Loc["ImportProfileEditor_ReperePrefixLabel"]</label>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="form-floating">
            <input id="profile-equipement-type-element-nom-input" class="form-control" @bind="_equipementTypeElementNom" @bind:after="MarkAsChanged"
                   placeholder="@Loc["ImportProfileEditor_EquipementTypeElementNomPlaceholder"]" />
            <label for="profile-equipement-type-element-nom-input">@Loc["ImportProfileEditor_EquipementTypeElementNomLabel"]</label>
        </div>
    </div>
</div>

<h2 class="h3">@Loc["ImportProfileEditor_DefaultTableauxHeading"]</h2>
<div class="card bg-light mb-3">
    <div class="card-body">
        @if (_defaultTableaux.Count > 0)
        {
            <ul class="block-field-list">
                @for (var j = 0; j < _defaultTableaux.Count; j++)
                {
                    var itemIndex = j;
                    @if (_editingDefaultTableauIndex == itemIndex)
                    {
                        <li class="block-field-item-editing">
                            @if (!string.IsNullOrEmpty(_defaultTableauEditError))
                            {
                                <div class="alert alert-danger" role="alert">@_defaultTableauEditError</div>
                            }
                            <div class="row g-2 align-items-end">
                                <div class="col">
                                    <input id="@($"default-tableau-edit-input-{itemIndex}")" class="form-control"
                                           @bind="_editingDefaultTableauValue" />
                                </div>
                                <div class="col-auto block-field-actions">
                                    <button id="@($"save-default-tableau-button-{itemIndex}")" type="button"
                                            class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                            aria-label="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                            title="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                            @onclick="() => SaveDefaultTableauEdit(itemIndex)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022z" />
                                        </svg>
                                    </button>
                                    <button id="@($"cancel-default-tableau-edit-button-{itemIndex}")" type="button"
                                            class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                            aria-label="@Loc["ImportProfileEditor_CancelButton"]"
                                            title="@Loc["ImportProfileEditor_CancelButton"]"
                                            @onclick="CancelDefaultTableauEdit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="block-field-item">
                            <div class="block-field-info">
                                <span class="block-field-name">@_defaultTableaux[itemIndex]</span>
                            </div>
                            <div class="block-field-actions">
                                <button id="@($"edit-default-tableau-button-{itemIndex}")" type="button"
                                        class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                        aria-label="@Loc["ImportProfileEditor_ModifyButton"]"
                                        title="@Loc["ImportProfileEditor_ModifyButton"]"
                                        @onclick="() => StartDefaultTableauEdit(itemIndex)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12z" />
                                        <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                                    </svg>
                                </button>
                                <button id="@($"delete-default-tableau-button-{itemIndex}")" type="button"
                                        class="btn btn-sm btn-outline-danger block-field-icon-btn"
                                        aria-label="@Loc["ImportProfileEditor_DeleteButton"]"
                                        title="@Loc["ImportProfileEditor_DeleteButton"]"
                                        @onclick="() => DeleteDefaultTableau(itemIndex)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                    </svg>
                                </button>
                            </div>
                        </li>
                    }
                }
            </ul>
        }
        <!-- Lot 053 (53.3/53.4): mono-field add form -- field and button share one row, the
             button at the row's natural right edge by construction (no .right-aligned-actions
             wrapper needed, per convention-ui-blazor-alignement-boutons.md's own carve-out for
             this exact case). Below 768px both stack full-width, unchanged from the lot V/30.3
             pattern.
             Lot 058 (58.2): align-items-end removed here (the actual cause of the button being
             shorter than the field, not a missing h-100) so the column can stretch to the row's
             full height; .field-inline-action then makes the button fill that height, but only
             at >=768px (see app.css) -- below that the two elements stack and the button keeps
             its natural height. -->
        <div class="row g-2">
            <div class="col-12 col-md">
                <div class="form-floating">
                    <input id="default-tableau-name-input" class="form-control" @bind="_newDefaultTableauName"
                           placeholder="@Loc["ImportProfileEditor_TableauNamePlaceholder"]" />
                    <label for="default-tableau-name-input">@Loc["ImportProfileEditor_TableauNameLabel"]</label>
                </div>
            </div>
            <div class="col-12 col-md-auto">
                <button id="add-default-tableau-button" class="btn btn-secondary w-100 w-md-auto field-inline-action" @onclick="AddDefaultTableau">
                    @((MarkupString)AdminIconMarkup.Plus) @Loc["ImportProfileEditor_AddTableauButton"]
                </button>
            </div>
        </div>
    </div>
</div>

<h2 class="h3">@Loc["ImportProfileEditor_DefaultApplicationNamesHeading"]</h2>
<div class="card bg-light mb-3">
    <div class="card-body">
        @if (_defaultApplicationNames.Count > 0)
        {
            <ul class="block-field-list">
                @for (var j = 0; j < _defaultApplicationNames.Count; j++)
                {
                    var itemIndex = j;
                    @if (_editingDefaultApplicationNameIndex == itemIndex)
                    {
                        <li class="block-field-item-editing">
                            @if (!string.IsNullOrEmpty(_defaultApplicationNameEditError))
                            {
                                <div class="alert alert-danger" role="alert">@_defaultApplicationNameEditError</div>
                            }
                            <div class="row g-2 align-items-end">
                                <div class="col">
                                    <input id="@($"default-application-name-edit-input-{itemIndex}")" class="form-control"
                                           @bind="_editingDefaultApplicationNameValue" />
                                </div>
                                <div class="col-auto block-field-actions">
                                    <button id="@($"save-default-application-name-button-{itemIndex}")" type="button"
                                            class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                            aria-label="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                            title="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                            @onclick="() => SaveDefaultApplicationNameEdit(itemIndex)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022z" />
                                        </svg>
                                    </button>
                                    <button id="@($"cancel-default-application-name-edit-button-{itemIndex}")" type="button"
                                            class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                            aria-label="@Loc["ImportProfileEditor_CancelButton"]"
                                            title="@Loc["ImportProfileEditor_CancelButton"]"
                                            @onclick="CancelDefaultApplicationNameEdit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="block-field-item">
                            <div class="block-field-info">
                                <span class="block-field-name">@_defaultApplicationNames[itemIndex]</span>
                            </div>
                            <div class="block-field-actions">
                                <button id="@($"edit-default-application-name-button-{itemIndex}")" type="button"
                                        class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                        aria-label="@Loc["ImportProfileEditor_ModifyButton"]"
                                        title="@Loc["ImportProfileEditor_ModifyButton"]"
                                        @onclick="() => StartDefaultApplicationNameEdit(itemIndex)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12z" />
                                        <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                                    </svg>
                                </button>
                                <button id="@($"delete-default-application-name-button-{itemIndex}")" type="button"
                                        class="btn btn-sm btn-outline-danger block-field-icon-btn"
                                        aria-label="@Loc["ImportProfileEditor_DeleteButton"]"
                                        title="@Loc["ImportProfileEditor_DeleteButton"]"
                                        @onclick="() => DeleteDefaultApplicationName(itemIndex)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                    </svg>
                                </button>
                            </div>
                        </li>
                    }
                }
            </ul>
        }
        <!-- Lot 053 (53.3/53.4): same mono-field add row treatment as Tableaux above.
             Lot 058 (58.2): same align-items-end removal + .field-inline-action treatment. -->
        <div class="row g-2">
            <div class="col-12 col-md">
                <div class="form-floating">
                    <input id="default-application-name-input" class="form-control" @bind="_newDefaultApplicationName"
                           placeholder="@Loc["ImportProfileEditor_ApplicationNamePlaceholder"]" />
                    <label for="default-application-name-input">@Loc["ImportProfileEditor_ApplicationNameLabel"]</label>
                </div>
            </div>
            <div class="col-12 col-md-auto">
                <button id="add-default-application-name-button" class="btn btn-secondary w-100 w-md-auto field-inline-action" @onclick="AddDefaultApplicationName">
                    @((MarkupString)AdminIconMarkup.Plus) @Loc["ImportProfileEditor_AddApplicationButton"]
                </button>
            </div>
        </div>
    </div>
</div>

<h2 class="h3">@Loc["ImportProfileEditor_SheetRulesHeading"]</h2>

@if (_sheetRules.Count == 0)
{
    <p>@Loc["ImportProfileEditor_NoSheetRulesYet"]</p>
}
else
{
    <ul class="sheet-rule-list sheet-rule-grid">
        @for (var i = 0; i < _sheetRules.Count; i++)
        {
            var index = i;
            var rule = _sheetRules[index];
            <li class="@(_openSheetRuleForm.EditIndex == index ? "sheet-rule-editing-item" : "sheet-rule-card")">
                @if (_openSheetRuleForm.EditIndex == index)
                {
                    <SheetRuleForm @ref="_editSheetRuleFormRef"
                                   IdPrefix="@($"edit-{index}-")"
                                   InitialRule="rule"
                                   SubmitButtonId="@($"save-sheet-rule-button-{index}")"
                                   SubmitLabel="@Loc["ImportProfileEditor_ApplySheetRuleButton"]"
                                   ShowCancel="true"
                                   CancelButtonId="@($"cancel-sheet-rule-button-{index}")"
                                   OnCancel="() => _openSheetRuleForm = SheetRuleFormOpenState.None"
                                   OnDirty="MarkAsChanged"
                                   OnSubmit="(SheetExtractionRule updated) => HandleSaveSheetRule(index, updated)" />
                }
                else
                {
                    <div class="sheet-rule-card-header">
                        <h3 class="sheet-rule-card-title h4">@rule.SheetName</h3>
                        <span class="sheet-rule-card-meta text-muted">@Loc["ImportProfileEditor_SheetMetadata", rule.Locator.FirstBlockStartRow, rule.Locator.Step, rule.Locator.StopFieldName]</span>
                    </div>
                    <ul class="block-field-list block-field-grid">
                        @foreach (var field in rule.Locator.Fields)
                        {
                            <li class="block-field-item">
                                <div class="block-field-info">
                                    <span class="block-field-name">@field.Name</span>
                                    <span class="block-field-range text-muted font-monospace">@BlockFieldRangeFormatter.ToAbsoluteRange(rule.Locator.FirstBlockStartRow, field.ColumnRange, field.RowOffsetStart, field.RowOffsetEnd)</span>
                                </div>
                            </li>
                        }
                    </ul>
                    <details class="sheet-rule-sublist-details" open="@_expandedSheetRuleDetails.Contains(index)">
                        <summary id="@($"sheet-rule-details-toggle-{index}")"
                                 @onclick="() => ToggleSheetRuleDetails(index)" @onclick:preventDefault="true">
                            @Loc["ImportProfileEditor_SheetRuleDetailsSummary", rule.UnconditionalColonneNames.Count, rule.PointRules.Count, rule.HeaderFields.Count, rule.HeaderComposites.Count]
                        </summary>
                        @if (_expandedSheetRuleDetails.Contains(index))
                        {
                            <div id="@($"sheet-rule-details-content-{index}")">
                                @if (rule.UnconditionalColonneNames.Count > 0)
                                {
                                    <h4 class="h5">@Loc["ImportProfileEditor_UnconditionalColonnesHeading"]</h4>
                                    <ul>
                                        @foreach (var colonneName in rule.UnconditionalColonneNames)
                                        {
                                            <li>@colonneName</li>
                                        }
                                    </ul>
                                }
                                @if (rule.PointRules.Count > 0)
                                {
                                    <h4 class="h5">@Loc["ImportProfileEditor_PointRulesHeading"]</h4>
                                    <ul>
                                        @foreach (var pointRule in rule.PointRules)
                                        {
                                            <li>@pointRule.ColonneName (@pointRule.SourceFieldName @pointRule.Operator @pointRule.ComparisonValue)</li>
                                        }
                                    </ul>
                                }
                                @if (rule.HeaderFields.Count > 0)
                                {
                                    <h4 class="h5">@Loc["ImportProfileEditor_HeaderFieldsHeading"]</h4>
                                    <ul>
                                        @foreach (var headerField in rule.HeaderFields)
                                        {
                                            <li>@headerField.Name (@headerField.Cell.Range)</li>
                                        }
                                    </ul>
                                }
                                @if (rule.HeaderComposites.Count > 0)
                                {
                                    <h4 class="h5">@Loc["ImportProfileEditor_HeaderCompositesHeading"]</h4>
                                    <ul>
                                        @foreach (var headerComposite in rule.HeaderComposites)
                                        {
                                            <li>@headerComposite.Name (@headerComposite.Template)</li>
                                        }
                                    </ul>
                                }
                                @if (rule.UnconditionalColonneNames.Count == 0 && rule.PointRules.Count == 0
                                       && rule.HeaderFields.Count == 0 && rule.HeaderComposites.Count == 0)
                                {
                                    <p>@Loc["ImportProfileEditor_NoSheetRuleSublistItems"]</p>
                                }
                            </div>
                        }
                    </details>
                    @if (_pendingDeleteIndex == index)
                    {
                        <div class="right-aligned-actions">
                            <span class="text-danger me-auto">@Loc["ImportProfileEditor_ConfirmDeleteSheetRuleMessage"]</span>
                            <button id="@($"confirm-delete-sheet-rule-button-{index}")" class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteSheetRule(index)">
                                @Loc["ImportProfileEditor_ConfirmDeleteButton"]
                            </button>
                            <button id="@($"cancel-delete-sheet-rule-button-{index}")" class="btn btn-sm btn-secondary" @onclick="() => _pendingDeleteIndex = null">
                                @Loc["ImportProfileEditor_CancelButton"]
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="right-aligned-actions">
                            <button id="@($"modify-sheet-rule-button-{index}")" type="button"
                                    class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                    aria-label="@Loc["ImportProfileEditor_ModifyButton"]" title="@Loc["ImportProfileEditor_ModifyButton"]"
                                    @onclick="() => RequestOpenEditAsync(index)">
                                @((MarkupString)AdminIconMarkup.Pencil)
                            </button>
                            <button id="@($"delete-sheet-rule-button-{index}")" type="button"
                                    class="btn btn-sm btn-outline-danger block-field-icon-btn"
                                    aria-label="@Loc["ImportProfileEditor_DeleteButton"]" title="@Loc["ImportProfileEditor_DeleteButton"]"
                                    @onclick="() => RequestDeleteSheetRuleAsync(index)">
                                @((MarkupString)AdminIconMarkup.Trash)
                            </button>
                        </div>
                    }
                }
            </li>
        }
    </ul>
}

<!-- Lot 057 (57.1): the card itself is always rendered (the visual anchor "this is where you add
     a sheet" never disappears); only its card-body -- the SheetRuleForm -- is conditional, behind
     a standalone toggle button (not SheetRuleForm's own ShowCancel, which would also change its
     submit button's icon/color, see the ticket's constat 3). A genuine conditional render (not CSS
     display:none) so reopening always remounts a fresh, empty SheetRuleForm instance. -->
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Loc["ImportProfileEditor_AddSheetHeading"]</span>
        <button id="toggle-add-sheet-rule-form-button" type="button" class="btn btn-sm btn-outline-secondary"
                @onclick="ToggleAddSheetRuleFormAsync">
            @if (_openSheetRuleForm.IsAdd)
            {
                @Loc["ImportProfileEditor_AddSheetToggleCloseButton"]
            }
            else
            {
                @((MarkupString)AdminIconMarkup.Plus) @Loc["ImportProfileEditor_AddSheetButton"]
            }
        </button>
    </div>
    <div class="card-body">
        @if (_openSheetRuleForm.IsAdd)
        {
            <SheetRuleForm @ref="_addSheetRuleFormRef" SubmitLabel="@Loc["ImportProfileEditor_AddSheetButton"]" OnDirty="MarkAsChanged" OnSubmit="HandleAddSheetRule" />
        }
    </div>
</div>

<!-- Lot 056 (56.6): sticky save bar -- the CTA and the unsaved-changes indicator stay visible at
     the bottom of the (long) editor at all times, so saving never costs a scroll-to-bottom. -->
<div class="profile-editor-save-bar">
    @if (_hasUnsavedChanges)
    {
        <span id="unsaved-changes-indicator" class="text-warning">@Loc["ImportProfileEditor_UnsavedChangesIndicator"]</span>
    }
    <div class="right-aligned-actions">
        <button id="save-profile-button" class="btn btn-primary w-100 w-md-auto btn-lg mt-4 mb-4"
                title="@Loc["ImportProfileEditor_SaveButtonShortcutHint"]" @onclick="SaveProfileAsync">
            @((MarkupString)AdminIconMarkup.Check) @Loc["ImportProfileEditor_SaveButton"]
        </button>
    </div>
</div>
}

</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private string _name = string.Empty;
    private string _reperePrefix = ImportProfile.DefaultReperePrefix;
    private string _equipementTypeElementNom = string.Empty;
    private Guid? _editingId;
    private bool _notFound;
    private string? _profileErrorMessage;

    private readonly List<string> _defaultTableaux = [];
    private readonly List<string> _defaultApplicationNames = [];
    private string _newDefaultTableauName = string.Empty;
    private string _newDefaultApplicationName = string.Empty;

    private int? _editingDefaultTableauIndex;
    private string _editingDefaultTableauValue = string.Empty;
    private string? _defaultTableauEditError;

    private int? _editingDefaultApplicationNameIndex;
    private string _editingDefaultApplicationNameValue = string.Empty;
    private string? _defaultApplicationNameEditError;

    private readonly List<SheetExtractionRule> _sheetRules = [];
    private int? _pendingDeleteIndex;
    private readonly HashSet<int> _expandedSheetRuleDetails = [];

    // Lot 057 (57.2): the single open-form state -- replaces the pre-057 pair of independent
    // fields (56.2's _editingIndex, 57.1's own add-open bool), whose combination could otherwise
    // silently contradict itself (e.g. both "editing index 2" and "add form open" true at once).
    // Exactly one of the three states holds at any time: none, add, or edit of a specific index --
    // enforced at the type level (only None/Add/Edit(n) can ever be constructed), not by two
    // mutable fields a caller could set independently.
    private readonly record struct SheetRuleFormOpenState(bool IsAdd, int? EditIndex)
    {
        public static readonly SheetRuleFormOpenState None = new(false, null);

        public static SheetRuleFormOpenState Add => new(true, null);

        public static SheetRuleFormOpenState Edit(int index) => new(false, index);
    }

    // Defaults to Add (creation mode, "/new" -- an empty screen with no indication of what to do
    // next would cost more than the accepted asymmetry with edit mode) and is set to None in
    // OnInitializedAsync when editing an existing profile (repli par défaut, Simon's 29/07 decision).
    private SheetRuleFormOpenState _openSheetRuleForm = SheetRuleFormOpenState.Add;

    // Lot 056 (56.2): references to the (at most one, since 57.2's mutual exclusion) currently-
    // rendered sheet-rule-form -- the add-mode instance or the edit-mode instance. "Save profile"
    // flushes whichever is open before persisting; TryCommitAsync() no-ops for a form that was
    // never touched.
    private SheetRuleForm? _addSheetRuleFormRef;
    private SheetRuleForm? _editSheetRuleFormRef;

    // Lot 043: a single global flag, not a per-field diff -- see the ticket's own KISS/YAGNI
    // rationale. Set by every mutation entry point below, cleared only on a successful save.
    private bool _hasUnsavedChanges;
    private bool _showNavigationConfirmation;
    private string? _pendingNavigationTarget;

    private void MarkAsChanged() => _hasUnsavedChanges = true;

    protected override async Task OnInitializedAsync()
    {
        if (!Id.HasValue)
        {
            return;
        }

        _openSheetRuleForm = SheetRuleFormOpenState.None;

        var profile = await ImportProfileStore.GetByIdAsync(Id.Value);
        if (profile is null)
        {
            _notFound = true;
            return;
        }

        _editingId = profile.Id;
        _name = profile.Name;
        _reperePrefix = profile.ReperePrefix;
        _equipementTypeElementNom = profile.EquipementTypeElementNom;
        _defaultTableaux.AddRange(profile.DefaultTableaux);
        _defaultApplicationNames.AddRange(profile.DefaultApplicationNames);
        _sheetRules.AddRange(profile.SheetRules);
    }

    private void BackToList() => NavigationManager.NavigateTo("import-profiles");

    private void AddDefaultTableau()
    {
        if (string.IsNullOrWhiteSpace(_newDefaultTableauName))
        {
            return;
        }

        _defaultTableaux.Add(_newDefaultTableauName);
        _newDefaultTableauName = string.Empty;
        MarkAsChanged();
    }

    private void AddDefaultApplicationName()
    {
        if (string.IsNullOrWhiteSpace(_newDefaultApplicationName))
        {
            return;
        }

        _defaultApplicationNames.Add(_newDefaultApplicationName);
        _newDefaultApplicationName = string.Empty;
        MarkAsChanged();
    }

    private void StartDefaultTableauEdit(int itemIndex)
    {
        _editingDefaultTableauIndex = itemIndex;
        _editingDefaultTableauValue = _defaultTableaux[itemIndex];
        _defaultTableauEditError = null;
    }

    private void SaveDefaultTableauEdit(int itemIndex)
    {
        if (string.IsNullOrWhiteSpace(_editingDefaultTableauValue))
        {
            _defaultTableauEditError = Loc["ImportProfileEditor_EmptyTableauNameError"];
            return;
        }

        _defaultTableaux[itemIndex] = _editingDefaultTableauValue;
        _editingDefaultTableauIndex = null;
        _defaultTableauEditError = null;
        MarkAsChanged();
    }

    private void CancelDefaultTableauEdit()
    {
        _editingDefaultTableauIndex = null;
        _defaultTableauEditError = null;
    }

    private void DeleteDefaultTableau(int itemIndex)
    {
        _defaultTableaux.RemoveAt(itemIndex);
        if (_editingDefaultTableauIndex == itemIndex)
        {
            _editingDefaultTableauIndex = null;
        }
        MarkAsChanged();
    }

    private void StartDefaultApplicationNameEdit(int itemIndex)
    {
        _editingDefaultApplicationNameIndex = itemIndex;
        _editingDefaultApplicationNameValue = _defaultApplicationNames[itemIndex];
        _defaultApplicationNameEditError = null;
    }

    private void SaveDefaultApplicationNameEdit(int itemIndex)
    {
        if (string.IsNullOrWhiteSpace(_editingDefaultApplicationNameValue))
        {
            _defaultApplicationNameEditError = Loc["ImportProfileEditor_EmptyApplicationNameError"];
            return;
        }

        _defaultApplicationNames[itemIndex] = _editingDefaultApplicationNameValue;
        _editingDefaultApplicationNameIndex = null;
        _defaultApplicationNameEditError = null;
        MarkAsChanged();
    }

    private void CancelDefaultApplicationNameEdit()
    {
        _editingDefaultApplicationNameIndex = null;
        _defaultApplicationNameEditError = null;
    }

    private void DeleteDefaultApplicationName(int itemIndex)
    {
        _defaultApplicationNames.RemoveAt(itemIndex);
        if (_editingDefaultApplicationNameIndex == itemIndex)
        {
            _editingDefaultApplicationNameIndex = null;
        }
        MarkAsChanged();
    }

    // Lot 057 (57.2): the one place that closes whichever sheet-rule form is currently open,
    // trying to commit it first via TryCommitAsync() (the single validation path from 56.2 -- this
    // lot reuses it as-is, per its own inter-lot contract). Returns false, leaving the form open
    // with its own alert, when the commit fails -- callers must not proceed to open a different
    // form (or a delete confirmation) in that case. A no-op (true) when nothing is open, or when
    // the open form was never touched (TryCommitAsync's own "blank form" short-circuit).
    private async Task<bool> TryCloseOpenFormAsync()
    {
        if (_openSheetRuleForm.EditIndex is not null && _editSheetRuleFormRef is not null)
        {
            return await _editSheetRuleFormRef.TryCommitAsync();
        }

        if (_openSheetRuleForm.IsAdd && _addSheetRuleFormRef is not null)
        {
            return await _addSheetRuleFormRef.TryCommitAsync();
        }

        return true;
    }

    // Opening any form (add or edit) also cancels a pending delete confirmation -- "one thing in
    // progress at a time" covers that case too (constat 5).
    private async Task RequestOpenEditAsync(int index)
    {
        if (!await TryCloseOpenFormAsync())
        {
            return;
        }

        _pendingDeleteIndex = null;
        _openSheetRuleForm = SheetRuleFormOpenState.Edit(index);
    }

    // The toggle's "close" state (already open) is an explicit abandon, matching "Cancel"'s own
    // semantics exactly -- no commit attempt, per the ticket's explicit distinction between an
    // implicit (flush-then-switch) and an explicit (discard) closure.
    private async Task ToggleAddSheetRuleFormAsync()
    {
        if (_openSheetRuleForm.IsAdd)
        {
            _openSheetRuleForm = SheetRuleFormOpenState.None;
            return;
        }

        if (!await TryCloseOpenFormAsync())
        {
            return;
        }

        _pendingDeleteIndex = null;
        _openSheetRuleForm = SheetRuleFormOpenState.Add;
    }

    // Requesting a delete first tries to close whichever form is open (flushing it) -- the
    // ticket's own "l'inverse est vrai aussi" requirement.
    private async Task RequestDeleteSheetRuleAsync(int index)
    {
        if (!await TryCloseOpenFormAsync())
        {
            return;
        }

        _pendingDeleteIndex = index;
    }

    private void HandleAddSheetRule(SheetExtractionRule rule)
    {
        _sheetRules.Add(rule);
        _openSheetRuleForm = SheetRuleFormOpenState.None;
        MarkAsChanged();
    }

    private void HandleSaveSheetRule(int index, SheetExtractionRule updated)
    {
        _sheetRules[index] = updated;
        _openSheetRuleForm = SheetRuleFormOpenState.None;
        MarkAsChanged();
    }

    private void ConfirmDeleteSheetRule(int index)
    {
        DeleteSheetRule(index);
        _pendingDeleteIndex = null;
    }

    private void DeleteSheetRule(int index)
    {
        _sheetRules.RemoveAt(index);
        if (_openSheetRuleForm.EditIndex == index)
        {
            _openSheetRuleForm = SheetRuleFormOpenState.None;
        }
        MarkAsChanged();
    }

    private void ToggleSheetRuleDetails(int index)
    {
        if (!_expandedSheetRuleDetails.Add(index))
        {
            _expandedSheetRuleDetails.Remove(index);
        }
    }

    // Lot 056 (56.5): Ctrl+Enter triggers the exact same save path as the CTA click, including the
    // implicit flush above. Plain Enter never saves -- it's reserved for 56.4's own row-level
    // validation inside a sub-list.
    private async Task OnRootKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args is { Key: "Enter", CtrlKey: true })
        {
            await SaveProfileAsync();
        }
    }

    private async Task SaveProfileAsync()
    {
        _profileErrorMessage = null;

        if (!await TryCloseOpenFormAsync())
        {
            return;
        }

        try
        {
            var profile = _editingId.HasValue
                ? new ImportProfile(
                    _editingId.Value, _name, _reperePrefix, _equipementTypeElementNom,
                    _defaultTableaux, _defaultApplicationNames, _sheetRules)
                : new ImportProfile(
                    _name, _reperePrefix, _equipementTypeElementNom, _defaultTableaux, _defaultApplicationNames, _sheetRules);

            await ImportProfileStore.SaveAsync(profile);
            _hasUnsavedChanges = false;
            NavigationManager.NavigateTo("import-profiles");
        }
        catch (DomainValidationException ex)
        {
            _profileErrorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
        catch (ProfileNameAlreadyExistsException ex)
        {
            _profileErrorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }

    private Task OnBeforeInternalNavigationAsync(LocationChangingContext context)
    {
        if (_hasUnsavedChanges)
        {
            context.PreventNavigation();
            _pendingNavigationTarget = context.TargetLocation;
            _showNavigationConfirmation = true;
        }

        return Task.CompletedTask;
    }

    private void DiscardChangesAndLeave()
    {
        _hasUnsavedChanges = false;
        _showNavigationConfirmation = false;
        var target = _pendingNavigationTarget;
        _pendingNavigationTarget = null;
        if (target is not null)
        {
            NavigationManager.NavigateTo(target);
        }
    }

    private void StayOnPage()
    {
        _showNavigationConfirmation = false;
        _pendingNavigationTarget = null;
    }

}
