<h2 class="h3">@Loc["ImportProfileEditor_SheetRulesHeading"]</h2>

@if (_draft.SheetRules.Count == 0)
{
    <p>@Loc["ImportProfileEditor_NoSheetRulesYet"]</p>
}
else
{
    <ul class="sheet-rule-list sheet-rule-grid">
        @for (var i = 0; i < _draft.SheetRules.Count; i++)
        {
            var index = i;
            var rule = _draft.SheetRules[index];
            <li class="@(_openSheetRuleForm.EditIndex == index ? "sheet-rule-editing-item" : "sheet-rule-card")">
                @if (_openSheetRuleForm.EditIndex == index)
                {
                    <SheetRuleForm IdPrefix="@($"edit-{index}-")"
                                   Draft="rule"
                                   SubmitButtonId="@($"save-sheet-rule-button-{index}")"
                                   SubmitLabel="@Loc["ImportProfileEditor_ApplySheetRuleButton"]"
                                   ShowCancel="true"
                                   CancelButtonId="@($"cancel-sheet-rule-button-{index}")"
                                   OnCancel="() => CancelSheetRuleEdit(index)"
                                   OnDirty="MarkAsChanged"
                                   OnSubmit="() => HandleSheetRuleSubmit(index)" />
                }
                else
                {
                    <div class="sheet-rule-card-header">
                        <h3 class="sheet-rule-card-title h4">@rule.SheetName</h3>
                        <span class="sheet-rule-card-meta text-muted">@Loc["ImportProfileEditor_SheetMetadata", rule.FirstBlockStartRow, rule.Step, rule.StopFieldName]</span>
                        @if (!string.IsNullOrWhiteSpace(rule.ZeroEnergieExpectedValue))
                        {
                            <span class="sheet-rule-card-meta text-muted">@Loc["ImportProfileEditor_ZeroEnergieExpectedValueSummary", rule.ZeroEnergieExpectedValue]</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(rule.DefaultCouleurEtiquette))
                        {
                            <span class="sheet-rule-card-meta text-muted">@Loc["ImportProfileEditor_DefaultCouleurEtiquetteSummary", rule.DefaultCouleurEtiquette]</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(rule.CouleurEtiquetteCellRange))
                        {
                            <span class="sheet-rule-card-meta text-muted">@Loc["ImportProfileEditor_CouleurEtiquetteCellSummary", rule.CouleurEtiquetteCellRange]</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(rule.AllowedCouleursEtiquette))
                        {
                            <span class="sheet-rule-card-meta text-muted">@Loc["ImportProfileEditor_AllowedCouleursEtiquetteSummary", rule.AllowedCouleursEtiquette]</span>
                        }
                    </div>
                    @if (SheetRuleIgnoredSettings.For(rule).AnyConfiguredSettingIgnored)
                    {
                        <div id="@($"sheet-rule-ignored-settings-warning-{index}")" class="alert alert-warning py-2">
                            @Loc["ImportProfileEditor_SheetRuleIgnoredSettingsWarning", rule.SheetName]
                        </div>
                    }
                    <ul class="block-field-list block-field-grid">
                        @foreach (var field in rule.Fields)
                        {
                            <li class="block-field-item">
                                <div class="block-field-info">
                                    <span class="block-field-name">@field.Name</span>
                                    <span class="block-field-range text-muted font-monospace">@field.AbsoluteRange</span>
                                </div>
                            </li>
                        }
                    </ul>
                    <details class="sheet-rule-sublist-details" open="@_expandedSheetRuleDetails.Contains(index)">
                        <summary id="@($"sheet-rule-details-toggle-{index}")"
                                 @onclick="() => ToggleSheetRuleDetails(index)" @onclick:preventDefault="true">
                            @Loc["ImportProfileEditor_SheetRuleDetailsSummary", rule.UnconditionalColonneNames.Count, rule.PointRules.Count, rule.HeaderFields.Count, rule.HeaderComposites.Count, rule.FieldPresencePointRules.Count]
                        </summary>
                        @if (_expandedSheetRuleDetails.Contains(index))
                        {
                            <div id="@($"sheet-rule-details-content-{index}")">
                                @if (rule.UnconditionalColonneNames.Count > 0)
                                {
                                    <h4 class="h5">@Loc["ImportProfileEditor_UnconditionalColonnesHeading"]</h4>
                                    <ul>
                                        @foreach (var colonneName in rule.UnconditionalColonneNames)
                                        {
                                            <li>@colonneName.Value</li>
                                        }
                                    </ul>
                                }
                                @if (rule.PointRules.Count > 0)
                                {
                                    <h4 class="h5">@Loc["ImportProfileEditor_PointRulesHeading"]</h4>
                                    <ul>
                                        @foreach (var pointRule in rule.PointRules)
                                        {
                                            <li>@pointRule.ColonneName (@pointRule.SourceFieldName @pointRule.Operator @pointRule.ComparisonValue)</li>
                                        }
                                    </ul>
                                }
                                @if (rule.FieldPresencePointRules.Count > 0)
                                {
                                    <h4 class="h5">@Loc["ImportProfileEditor_FieldPresencePointRulesHeading"]</h4>
                                    <ul>
                                        @foreach (var fieldPresenceRule in rule.FieldPresencePointRules)
                                        {
                                            <li>@fieldPresenceRule.ColonneName (@FieldPresencePointRuleFormatter.FormatCell(fieldPresenceRule.AbsoluteRange, fieldPresenceRule.ExpectedValue))</li>
                                        }
                                    </ul>
                                }
                                @if (rule.HeaderFields.Count > 0)
                                {
                                    <h4 class="h5">@Loc["ImportProfileEditor_HeaderFieldsHeading"]</h4>
                                    <ul>
                                        @foreach (var headerField in rule.HeaderFields)
                                        {
                                            <li>@headerField.Name (@headerField.Range)</li>
                                        }
                                    </ul>
                                }
                                @if (rule.HeaderComposites.Count > 0)
                                {
                                    <h4 class="h5">@Loc["ImportProfileEditor_HeaderCompositesHeading"]</h4>
                                    <ul>
                                        @foreach (var headerComposite in rule.HeaderComposites)
                                        {
                                            <li>@headerComposite.Name (@headerComposite.Template)</li>
                                        }
                                    </ul>
                                }
                                @if (rule.UnconditionalColonneNames.Count == 0 && rule.PointRules.Count == 0
                                       && rule.HeaderFields.Count == 0 && rule.HeaderComposites.Count == 0
                                       && rule.FieldPresencePointRules.Count == 0)
                                {
                                    <p>@Loc["ImportProfileEditor_NoSheetRuleSublistItems"]</p>
                                }
                            </div>
                        }
                    </details>
                    @if (_pendingDeleteIndex == index)
                    {
                        <div class="right-aligned-actions">
                            <span class="text-danger me-auto">@Loc["ImportProfileEditor_ConfirmDeleteSheetRuleMessage"]</span>
                            <button id="@($"confirm-delete-sheet-rule-button-{index}")" class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteSheetRule(index)">
                                @Loc["ImportProfileEditor_ConfirmDeleteButton"]
                            </button>
                            <button id="@($"cancel-delete-sheet-rule-button-{index}")" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center gap-1" @onclick="() => _pendingDeleteIndex = null">
                                @((MarkupString)AdminIconMarkup.X) @Loc["ImportProfileEditor_CancelButton"]
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="right-aligned-actions">
                            <button id="@($"modify-sheet-rule-button-{index}")" type="button"
                                    class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                    aria-label="@Loc["ImportProfileEditor_ModifyButton"]" title="@Loc["ImportProfileEditor_ModifyButton"]"
                                    @onclick="() => RequestOpenEdit(index)">
                                @((MarkupString)AdminIconMarkup.Pencil)
                            </button>
                            <button id="@($"delete-sheet-rule-button-{index}")" type="button"
                                    class="btn btn-sm btn-outline-danger block-field-icon-btn"
                                    aria-label="@Loc["ImportProfileEditor_DeleteButton"]" title="@Loc["ImportProfileEditor_DeleteButton"]"
                                    @onclick="() => RequestDeleteSheetRule(index)">
                                @((MarkupString)AdminIconMarkup.Trash)
                            </button>
                        </div>
                    }
                }
            </li>
        }
    </ul>
}

<!-- Lot 057 (57.1): the card itself is always rendered (the visual anchor "this is where you add
     a sheet" never disappears); only its card-body -- the SheetRuleForm -- is conditional, behind
     a standalone toggle button (not SheetRuleForm's own ShowCancel, which would also change its
     submit button's icon/color, see the ticket's constat 3). -->
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Loc["ImportProfileEditor_AddSheetHeading"]</span>
        <button id="toggle-add-sheet-rule-form-button" type="button" class="btn @(_openSheetRuleForm.IsAdd ? "btn-outline-secondary" : "btn-secondary") w-100 d-flex align-items-center justify-content-center gap-1"
                @onclick="ToggleAddSheetRuleForm">
            @if (_openSheetRuleForm.IsAdd)
            {
                @((MarkupString)AdminIconMarkup.X) @Loc["ImportProfileEditor_AddSheetToggleCloseButton"]
            }
            else
            {
                @((MarkupString)AdminIconMarkup.Plus) @Loc["ImportProfileEditor_AddSheetButton"]
            }
        </button>
    </div>
    <div class="card-body">
        @if (_openSheetRuleForm.IsAdd)
        {
            <SheetRuleForm Draft="_draft.PendingSheetRule" SubmitLabel="@Loc["ImportProfileEditor_AddSheetButton"]" OnDirty="MarkAsChanged" OnSubmit="() => HandleSheetRuleSubmit(null)" />
        }
    </div>
</div>

<!-- Lot 056 (56.6): sticky save bar -- the CTA and the unsaved-changes indicator stay visible at
     the bottom of the (long) editor at all times, so saving never costs a scroll-to-bottom. -->
<div class="profile-editor-save-bar">
    @if (_hasUnsavedChanges)
    {
        <span id="unsaved-changes-indicator" class="text-warning">@Loc["ImportProfileEditor_UnsavedChangesIndicator"]</span>
    }
    <div class="right-aligned-actions">
        <button id="save-profile-button" class="btn btn-primary w-100 w-md-auto btn-lg mt-4 mb-4 d-flex align-items-center justify-content-center gap-1"
                disabled="@(!_hasUnsavedChanges)"
                title="@(_hasUnsavedChanges ? Loc["ImportProfileEditor_SaveButtonShortcutHint"] : Loc["ImportProfileEditor_SaveButtonNoChangesHint"])"
                @onclick="SaveProfileAsync">
            @((MarkupString)AdminIconMarkup.Check) @Loc["ImportProfileEditor_SaveButton"]
        </button>
    </div>
</div>
}

</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    // Lot 075: the one draft of the whole profile (P3). Every input of this page and of its sub-forms
    // is bound straight into it; saving converts the whole tree (ImportProfileDraftMapper.ToDomain),
    // whichever form happens to be open.
    private ImportProfileDraft _draft = new();
    private Guid? _editingId;
    private bool _notFound;
    private string? _profileErrorMessage;

    private readonly ListItemEditState<StringItemDraft> _tableauEdit = new();
    private readonly ListItemEditState<StringItemDraft> _applicationEdit = new();
    private readonly ListItemEditState<TacheMultipleTypeLabelDraft> _labelEdit = new();

    private int? _pendingDeleteIndex;
    private readonly HashSet<int> _expandedSheetRuleDetails = [];

    // Taken when a sheet rule is opened for editing, restored on Cancel.
    private SheetExtractionRuleDraft? _sheetRuleEditSnapshot;

    // Lot 057 (57.2): the single open-form state -- exactly one of none, add, or edit of a specific
    // index, enforced at the type level.
    private readonly record struct SheetRuleFormOpenState(bool IsAdd, int? EditIndex)
    {
        public static readonly SheetRuleFormOpenState None = new(false, null);

        public static SheetRuleFormOpenState Add => new(true, null);

        public static SheetRuleFormOpenState Edit(int index) => new(false, index);
    }

    // Defaults to Add (creation mode, "/new" -- an empty screen with no indication of what to do
    // next would cost more than the accepted asymmetry with edit mode) and is set to None in
    // OnInitializedAsync when editing an existing profile (repli par défaut, Simon's 29/07 decision).
    private SheetRuleFormOpenState _openSheetRuleForm = SheetRuleFormOpenState.Add;

    // Lot 043: a single global flag, not a per-field diff -- see the ticket's own KISS/YAGNI
    // rationale. Set by every mutation entry point, cleared only on a successful save.
    private bool _hasUnsavedChanges;
    private bool _showNavigationConfirmation;
    private string? _pendingNavigationTarget;

    private void MarkAsChanged() => _hasUnsavedChanges = true;

    // What a pending "Add" row holds is saved with the profile, so typing in it is a change -- but a row
    // left (or put back) exactly empty is not (Lot 059: a rejected empty add raises no indicator).
    private void MarkPendingRowChanged<TDraft>(TDraft pending) where TDraft : notnull, new()
    {
        if (!DraftJson.IsPristine(pending))
        {
            MarkAsChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Id.HasValue)
        {
            return;
        }

        _openSheetRuleForm = SheetRuleFormOpenState.None;

        var profile = await ImportProfileStore.GetByIdAsync(Id.Value);
        if (profile is null)
        {
            _notFound = true;
            return;
        }

        _editingId = profile.Id;
        _draft = ImportProfileDraftMapper.FromDomain(profile);
    }

    private void BackToList() => NavigationManager.NavigateTo("import-profiles");

    private string Localize(Exception exception) =>
        exception is DraftValidationException validation
            ? Loc[validation.ResourceKey]
            : BusinessExceptionLocalizer.TryLocalize(exception) ?? exception.Message;

    private void Delete<TDraft>(List<TDraft> list, int index, ListItemEditState<TDraft> edit) where TDraft : class
    {
        DraftListActions.Delete(list, index, edit);
        MarkAsChanged();
    }

    // Root lists: an item is validated against the other items of its own list (duplicates, Lot 059/067).
    private void SubmitDefaultTableau(int? index)
    {
        var list = _draft.DefaultTableaux;
        if (DraftListActions.Submit(list, index, _draft.PendingDefaultTableau, p => _draft.PendingDefaultTableau = p, _tableauEdit,
                d => ImportProfileDraftMapper.ConvertDefaultTableau(d, list.Where(o => !ReferenceEquals(o, d))), Localize))
        {
            MarkAsChanged();
        }
    }

    private void SubmitDefaultApplicationName(int? index)
    {
        var list = _draft.DefaultApplicationNames;
        if (DraftListActions.Submit(list, index, _draft.PendingDefaultApplicationName, p => _draft.PendingDefaultApplicationName = p, _applicationEdit,
                d => ImportProfileDraftMapper.ConvertDefaultApplicationName(d, list.Where(o => !ReferenceEquals(o, d))), Localize))
        {
            MarkAsChanged();
        }
    }

    private void SubmitTacheMultipleTypeLabel(int? index)
    {
        var list = _draft.TacheMultipleTypeLabels;
        if (DraftListActions.Submit(list, index, _draft.PendingTacheMultipleTypeLabel, p => _draft.PendingTacheMultipleTypeLabel = p, _labelEdit,
                d => ImportProfileDraftMapper.ConvertTacheMultipleTypeLabel(d, list.Where(o => !ReferenceEquals(o, d))), Localize))
        {
            MarkAsChanged();
        }
    }

    // Lot 057 (57.2): the one place that closes whichever sheet-rule form is currently open, validating
    // it first through the mapper. Returns false, leaving the form open with its errors shown, when the
    // rule doesn't convert -- callers must not open another form (or a delete confirmation) then. A
    // pristine pending "Add" rule is a no-op; a non-pristine valid one is added to the list.
    private bool TryValidateOpenForm()
    {
        var ruleDraft = _openSheetRuleForm.EditIndex is { } index
            ? _draft.SheetRules[index]
            : _openSheetRuleForm.IsAdd && !DraftJson.IsPristine(_draft.PendingSheetRule) ? _draft.PendingSheetRule : null;
        if (ruleDraft is null)
        {
            return true;
        }

        DraftListActions.ClearErrors(ruleDraft);
        var result = ImportProfileDraftMapper.ConvertSheetRule(ruleDraft);
        if (!result.IsSuccess)
        {
            DraftListActions.ApplyErrors(result.Errors, Localize);
            return false;
        }

        if (ReferenceEquals(ruleDraft, _draft.PendingSheetRule))
        {
            _draft.SheetRules.Add(ruleDraft);
            _draft.PendingSheetRule = new SheetExtractionRuleDraft();
        }

        return true;
    }

    // Opening any form (add or edit) also cancels a pending delete confirmation -- "one thing in
    // progress at a time" covers that case too (constat 5 of lot 057).
    private void RequestOpenEdit(int index)
    {
        if (!TryValidateOpenForm())
        {
            return;
        }

        _pendingDeleteIndex = null;
        _sheetRuleEditSnapshot = DraftJson.Clone(_draft.SheetRules[index]);
        _openSheetRuleForm = SheetRuleFormOpenState.Edit(index);
    }

    // The toggle's "close" state (already open) is an explicit abandon, matching "Cancel"'s own
    // semantics exactly -- no validation, and what was typed is discarded.
    private void ToggleAddSheetRuleForm()
    {
        if (_openSheetRuleForm.IsAdd)
        {
            _draft.PendingSheetRule = new SheetExtractionRuleDraft();
            _openSheetRuleForm = SheetRuleFormOpenState.None;
            return;
        }

        if (!TryValidateOpenForm())
        {
            return;
        }

        _pendingDeleteIndex = null;
        _openSheetRuleForm = SheetRuleFormOpenState.Add;
    }

    // Requesting a delete first validates whichever form is open -- the ticket's own "l'inverse est
    // vrai aussi" requirement (lot 057).
    private void RequestDeleteSheetRule(int index)
    {
        if (!TryValidateOpenForm())
        {
            return;
        }

        _pendingDeleteIndex = index;
    }

    // SheetRuleForm has already converted the rule successfully before raising OnSubmit.
    private void HandleSheetRuleSubmit(int? index)
    {
        if (index is null)
        {
            _draft.SheetRules.Add(_draft.PendingSheetRule);
            _draft.PendingSheetRule = new SheetExtractionRuleDraft();
        }

        _sheetRuleEditSnapshot = null;
        _openSheetRuleForm = SheetRuleFormOpenState.None;
        MarkAsChanged();
    }

    private void CancelSheetRuleEdit(int index)
    {
        if (_sheetRuleEditSnapshot is not null)
        {
            _draft.SheetRules[index] = _sheetRuleEditSnapshot;
        }

        _sheetRuleEditSnapshot = null;
        _openSheetRuleForm = SheetRuleFormOpenState.None;
    }

    private void ConfirmDeleteSheetRule(int index)
    {
        _draft.SheetRules.RemoveAt(index);
        if (_openSheetRuleForm.EditIndex == index)
        {
            _openSheetRuleForm = SheetRuleFormOpenState.None;
        }

        _pendingDeleteIndex = null;
        MarkAsChanged();
    }

    private void ToggleSheetRuleDetails(int index)
    {
        if (!_expandedSheetRuleDetails.Add(index))
        {
            _expandedSheetRuleDetails.Remove(index);
        }
    }

    // Lot 056 (56.5): Ctrl+Enter triggers the exact same save path as the CTA click. Plain Enter never
    // saves -- it's reserved for 56.4's own row-level validation inside a sub-list.
    private async Task OnRootKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args is { Key: "Enter", CtrlKey: true } && _hasUnsavedChanges)
        {
            await SaveProfileAsync();
        }
    }

    private async Task SaveProfileAsync()
    {
        _profileErrorMessage = null;

        // Lot 075: the whole draft tree is converted here, whichever form is open or closed -- a row typed
        // but never added, or an item edit never confirmed, is saved (or blocks the save) like any other.
        DraftListActions.ClearErrors(_draft);
        var result = ImportProfileDraftMapper.ToDomain(_draft);
        if (!result.IsSuccess)
        {
            DraftListActions.ApplyErrors(result.Errors, Localize);

            // A failure on the root draft itself (name, prefix, no sheet rule...) shows its own message,
            // as before this lot; one on a nested item shows the generic banner, the specific message
            // being displayed next to that item.
            var rootLevelError = result.Errors.FirstOrDefault(e => ReferenceEquals(e.Draft, _draft));
            _profileErrorMessage = rootLevelError is not null
                ? Localize(rootLevelError.Exception)
                : Loc["ImportProfileEditor_PendingRowInvalidError"];
            return;
        }

        try
        {
            await ImportProfileStore.SaveAsync(result.Value!);
            _hasUnsavedChanges = false;
            NavigationManager.NavigateTo("import-profiles");
        }
        catch (DomainValidationException ex)
        {
            _profileErrorMessage = Localize(ex);
        }
        catch (ProfileNameAlreadyExistsException ex)
        {
            _profileErrorMessage = Localize(ex);
        }
    }

    private Task OnBeforeInternalNavigationAsync(LocationChangingContext context)
    {
        if (_hasUnsavedChanges)
        {
            context.PreventNavigation();
            _pendingNavigationTarget = context.TargetLocation;
            _showNavigationConfirmation = true;
        }

        return Task.CompletedTask;
    }

    private void DiscardChangesAndLeave()
    {
        _hasUnsavedChanges = false;
        _showNavigationConfirmation = false;
        var target = _pendingNavigationTarget;
        _pendingNavigationTarget = null;
        if (target is not null)
        {
            NavigationManager.NavigateTo(target);
        }
    }

    private void StayOnPage()
    {
        _showNavigationConfirmation = false;
        _pendingNavigationTarget = null;
    }
}
