@page "/import-profiles/new"
@page "/import-profiles/{Id:guid}/edit"
@attribute [Authorize(Roles = IdentitySeeder.AdminRoleName)]

@using ExcelETL.Application.Exceptions
@using ExcelETL.Application.Extraction.Oxo
@using ExcelETL.BlazorAdmin.Formatting
@using ExcelETL.Domain.Exceptions
@using ExcelETL.Domain.Extraction.Profile
@using ExcelETL.Infrastructure.Identity
@using Microsoft.AspNetCore.Authorization

@inject IImportProfileStore ImportProfileStore
@inject BusinessExceptionLocalizer BusinessExceptionLocalizer
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject NavigationManager NavigationManager

<PageTitle>@(_editingId.HasValue ? Loc["ImportProfileEditor_EditPageTitle"] : Loc["ImportProfileEditor_PageTitle"])</PageTitle>

<h1>@(_editingId.HasValue ? Loc["ImportProfileEditor_EditPageTitle"] : Loc["ImportProfileEditor_PageTitle"])</h1>

@if (_notFound)
{
    <div id="import-profile-not-found" class="alert alert-danger">@Loc["ImportProfileEditor_ProfileNotFound"]</div>
}
else
{
@if (!string.IsNullOrEmpty(_profileErrorMessage))
{
    <div class="alert alert-danger">@_profileErrorMessage</div>
}

<div class="row g-2 mb-3">
    <div class="col">
        <label class="form-label" for="profile-name-input">@Loc["ImportProfileEditor_NameLabel"]</label>
        <input id="profile-name-input" class="form-control" @bind="_name"
               placeholder="@Loc["ImportProfileEditor_NamePlaceholder"]" />
    </div>
    <div class="col">
        <label class="form-label" for="profile-repere-prefix-input">@Loc["ImportProfileEditor_ReperePrefixLabel"]</label>
        <input id="profile-repere-prefix-input" class="form-control" @bind="_reperePrefix"
               placeholder="@Loc["ImportProfileEditor_ReperePrefixPlaceholder"]" />
    </div>
    <div class="col">
        <label class="form-label" for="profile-equipement-type-element-nom-input">@Loc["ImportProfileEditor_EquipementTypeElementNomLabel"]</label>
        <input id="profile-equipement-type-element-nom-input" class="form-control" @bind="_equipementTypeElementNom"
               placeholder="@Loc["ImportProfileEditor_EquipementTypeElementNomPlaceholder"]" />
    </div>
</div>

<h3>@Loc["ImportProfileEditor_SheetRulesHeading"]</h3>

@if (_sheetRules.Count == 0)
{
    <p>@Loc["ImportProfileEditor_NoSheetRulesYet"]</p>
}
else
{
    <ul class="list-group mb-3">
        @for (var i = 0; i < _sheetRules.Count; i++)
        {
            var index = i;
            var rule = _sheetRules[index];
            <li class="list-group-item">
                @if (_editingIndex == index)
                {
                    <SheetRuleForm IdPrefix="@($"edit-{index}-")"
                                   InitialRule="rule"
                                   SubmitButtonId="@($"save-sheet-rule-button-{index}")"
                                   SubmitLabel="@Loc["ImportProfileEditor_SaveChangesButton"]"
                                   ShowCancel="true"
                                   CancelButtonId="@($"cancel-sheet-rule-button-{index}")"
                                   OnCancel="() => _editingIndex = null"
                                   OnSubmit="(SheetExtractionRule updated) => HandleSaveSheetRule(index, updated)" />
                }
                else
                {
                    @Loc["ImportProfileEditor_SheetSummary", rule.SheetName, rule.Locator.FirstBlockStartRow, rule.Locator.Step, rule.Locator.StopFieldName]
                    <ul class="block-field-list">
                        @foreach (var field in rule.Locator.Fields)
                        {
                            <li class="block-field-item">
                                <div class="block-field-info">
                                    <span class="block-field-name">@field.Name</span>
                                    <span class="block-field-range text-muted font-monospace">@BlockFieldRangeFormatter.ToAbsoluteRange(rule.Locator.FirstBlockStartRow, field.ColumnRange, field.RowOffsetStart, field.RowOffsetEnd)</span>
                                </div>
                            </li>
                        }
                    </ul>
                    @if (rule.UnconditionalColonneNames.Count > 0)
                    {
                        <h5>@Loc["ImportProfileEditor_UnconditionalColonnesHeading"]</h5>
                        <ul>
                            @foreach (var colonneName in rule.UnconditionalColonneNames)
                            {
                                <li>@colonneName</li>
                            }
                        </ul>
                    }
                    @if (rule.PointRules.Count > 0)
                    {
                        <h5>@Loc["ImportProfileEditor_PointRulesHeading"]</h5>
                        <ul>
                            @foreach (var pointRule in rule.PointRules)
                            {
                                <li>@pointRule.ColonneName (@pointRule.SourceFieldName @pointRule.Operator @pointRule.ComparisonValue)</li>
                            }
                        </ul>
                    }
                    <div class="mt-2">
                        <button id="@($"modify-sheet-rule-button-{index}")" class="btn btn-sm btn-secondary" @onclick="() => _editingIndex = index">
                            @Loc["ImportProfileEditor_ModifyButton"]
                        </button>
                        <button id="@($"delete-sheet-rule-button-{index}")" class="btn btn-sm btn-danger" @onclick="() => DeleteSheetRule(index)">
                            @Loc["ImportProfileEditor_DeleteButton"]
                        </button>
                    </div>
                }
            </li>
        }
    </ul>
}

<div class="card mb-3">
    <div class="card-header">@Loc["ImportProfileEditor_AddSheetHeading"]</div>
    <div class="card-body">
        <SheetRuleForm SubmitLabel="@Loc["ImportProfileEditor_AddSheetButton"]" OnSubmit="HandleAddSheetRule" />
    </div>
</div>

<button id="save-profile-button" class="btn btn-primary" @onclick="SaveProfileAsync">
    @Loc["ImportProfileEditor_SaveButton"]
</button>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private string _name = string.Empty;
    private string _reperePrefix = ImportProfile.DefaultReperePrefix;
    private string _equipementTypeElementNom = string.Empty;
    private Guid? _editingId;
    private bool _notFound;
    private string? _profileErrorMessage;

    private readonly List<SheetExtractionRule> _sheetRules = [];
    private int? _editingIndex;

    protected override async Task OnInitializedAsync()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var profile = await ImportProfileStore.GetByIdAsync(Id.Value);
        if (profile is null)
        {
            _notFound = true;
            return;
        }

        _editingId = profile.Id;
        _name = profile.Name;
        _reperePrefix = profile.ReperePrefix;
        _equipementTypeElementNom = profile.EquipementTypeElementNom;
        _sheetRules.AddRange(profile.SheetRules);
    }

    private void HandleAddSheetRule(SheetExtractionRule rule) => _sheetRules.Add(rule);

    private void HandleSaveSheetRule(int index, SheetExtractionRule updated)
    {
        _sheetRules[index] = updated;
        _editingIndex = null;
    }

    private void DeleteSheetRule(int index)
    {
        _sheetRules.RemoveAt(index);
        if (_editingIndex == index)
        {
            _editingIndex = null;
        }
    }

    private async Task SaveProfileAsync()
    {
        _profileErrorMessage = null;

        try
        {
            var profile = _editingId.HasValue
                ? new ImportProfile(_editingId.Value, _name, _reperePrefix, _equipementTypeElementNom, _sheetRules)
                : new ImportProfile(_name, _reperePrefix, _equipementTypeElementNom, _sheetRules);

            await ImportProfileStore.SaveAsync(profile);
            NavigationManager.NavigateTo("import-profiles");
        }
        catch (DomainValidationException ex)
        {
            _profileErrorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }

}
