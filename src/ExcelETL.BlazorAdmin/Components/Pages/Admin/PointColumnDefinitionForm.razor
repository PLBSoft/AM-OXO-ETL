@using ExcelETL.BlazorAdmin.Editing.Export
@using ExcelETL.BlazorAdmin.Shared

@inject IStringLocalizer<BlazorAdminMessages> Loc

@* Lot 074 (P3 draft pilot): pure leaf -- see ColumnDefinitionForm.razor's own header comment. *@

@if (!string.IsNullOrEmpty(Draft.Error))
{
    <div class="alert alert-danger" role="alert">@Draft.Error</div>
}

<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}nom-input")" class="form-control" @bind="Draft.ColonneNom" @bind:after="MarkDirty"
               placeholder="@Loc["ExportProfileEditor_ColonneNomPlaceholder"]" />
        <label for="@($"{IdPrefix}nom-input")">@Loc["ExportProfileEditor_ColonneNomLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}header-input")" class="form-control" @bind="Draft.Header" @bind:after="MarkDirty"
               placeholder="@Loc["ExportProfileEditor_HeaderPlaceholder"]" />
        <label for="@($"{IdPrefix}header-input")">@Loc["ExportProfileEditor_HeaderLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}mark-value-input")" class="form-control" @bind="Draft.MarkValue" @bind:after="MarkDirty"
               placeholder="@Loc["ExportProfileEditor_MarkValuePlaceholder"]" />
        <label for="@($"{IdPrefix}mark-value-input")">@Loc["ExportProfileEditor_MarkValueLabel"]</label>
    </div>
</div>

<!-- Lot 056 (56.7): submission and cancel are now visually distinct in every mode. -->
<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="() => OnSubmit.InvokeAsync()">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        else
        {
            @((MarkupString)AdminIconMarkup.Plus)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3" @onclick="() => OnCancel.InvokeAsync()">
            @Loc["ExportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public PointColumnDefinitionDraft Draft { get; set; } = new();

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-point-column-definition-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-point-column-definition-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnDirty { get; set; }

    private void MarkDirty() => OnDirty.InvokeAsync();
}
