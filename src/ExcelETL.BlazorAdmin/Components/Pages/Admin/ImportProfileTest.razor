@page "/import-profiles/test"
@attribute [Authorize(Roles = IdentitySeeder.AdminRoleName)]

@using ExcelETL.Application.Exceptions
@using ExcelETL.Application.Extraction.Oxo
@using ExcelETL.BlazorAdmin.Excel
@using ExcelETL.Domain.Extraction.Pivot
@using ExcelETL.Domain.Extraction.Profile
@using ExcelETL.Infrastructure.Excel
@using ExcelETL.Infrastructure.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject IImportProfileStore ImportProfileStore
@inject IImportPipelineOrchestrator ImportPipelineOrchestrator
@inject BusinessExceptionLocalizer BusinessExceptionLocalizer
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject NavigationManager NavigationManager

<PageTitle>@Loc["ImportProfileTest_PageTitle"]</PageTitle>

<!-- V8: page-to-page navigation (breadcrumb-equivalent), not a content action -- so an icon-only
     link is appropriate here even though convention-ui-blazor-icones-boutons.md says "no icon for
     a secondary action": that rule targets buttons operating on a form/card's own content
     (Cancel/Close), a distinct category from inter-page navigation. -->
<div class="page-banner">
    <button id="back-to-import-profiles-button" type="button" class="btn btn-link page-banner-back-link"
            aria-label="@Loc["ImportProfileTest_BackToListButton"]" title="@Loc["ImportProfileTest_BackToListButton"]"
            @onclick="BackToList">
        @((MarkupString)ArrowLeftIconMarkup)
        <span class="d-none d-md-inline">@Loc["ImportProfileTest_BackToListButton"]</span>
    </button>
</div>

<h1>@Loc["ImportProfileTest_PageTitle"]</h1>

<!-- V9: de-emphasized intro text. Still a single sentence (with an em-dash aside, not two
     sentences) per V7's investigation, so no bullet-list reformulation applies here. -->
<p class="text-muted small">@Loc["ImportProfileTest_Instructions"]</p>

@if (_profiles is null)
{
    <p>@Loc["ImportProfiles_Loading"]</p>
}
else
{
    var processing = _state == State.Processing;

    <div class="mb-3">
        <label class="form-label" for="test-profile-select">@Loc["ImportProfileTest_ProfileLabel"]</label>
        <select id="test-profile-select" class="form-select" @bind="_selectedProfileId" disabled="@processing">
            <option value="">@Loc["ImportProfileTest_ProfilePlaceholder"]</option>
            @foreach (var profile in _profiles)
            {
                <option value="@profile.Id">@profile.Name</option>
            }
        </select>
        @if (_profiles.Count == 0)
        {
            <div class="form-text">@Loc["ImportProfileTest_NoProfilesAvailable"]</div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label" for="test-file-input">@Loc["ImportProfileTest_FileLabel"]</label>
        <!-- V10: Bootstrap-native upload styling (no custom dropzone) -- InputFile stays displayed
             and clickable as-is (never hidden/overlaid), just wrapped in an input-group with an
             icon, per the ticket's own explicit decision to avoid a CSS-positioned overlay for a
             marginal UX gain. form-control-lg alone already covers the 44-48px touch target. -->
        <div class="input-group">
            <span class="input-group-text">@((MarkupString)FileUploadIconMarkup)</span>
            <InputFile id="test-file-input" class="form-control form-control-lg" accept=".xlsx" OnChange="OnInputFileChangeAsync" disabled="@processing" />
        </div>
    </div>

    @if (_state == State.Processing)
    {
        <div id="test-status" class="alert alert-info d-flex align-items-center gap-2">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>@Loc["ImportProfileTest_Processing"]</span>
        </div>
    }
    else if (_state == State.Error)
    {
        <div id="test-status" class="alert alert-danger">@_errorMessage</div>
    }
    else if (_result is not null)
    {
        if (_result.Equipement is null)
        {
            <div id="test-status" class="alert alert-danger">
                <h4>@Loc["ImportProfileTest_RejectedFileHeading"]</h4>
                <ul>
                    @foreach (var error in _result.Errors)
                    {
                        <li>@error.Sheet / @error.BlockIdentifier: @error.Message</li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div id="test-status" class="alert alert-success">
                <details class="test-table-details" open="@(!_collapsedSections.Contains("equipement"))">
                    <summary id="equipement-details-toggle" @onclick='() => ToggleSection("equipement")' @onclick:preventDefault="true">
                        @Loc["ImportProfileTest_EquipementHeading"]
                    </summary>
                    @if (!_collapsedSections.Contains("equipement"))
                    {
                        <div class="test-table-scroll">
                            <table id="equipement-table" class="table table-sm test-table">
                                <thead>
                                    <tr>
                                        <th>@Loc["ImportProfileTest_Repere"]</th>
                                        <th>@Loc["ImportProfileTest_Designation"]</th>
                                        <th>@Loc["ImportProfileTest_TypeElementNom"]</th>
                                        <th>@Loc["ImportProfileTest_Localisation"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@_result.Equipement.Repere</td>
                                        <td>@_result.Equipement.Designation</td>
                                        <td>@_result.Equipement.TypeElementNom</td>
                                        <td>@_result.Equipement.Localisation</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                </details>

                <details class="test-table-details" open="@(!_collapsedSections.Contains("isolements"))">
                    <summary id="isolements-details-toggle" @onclick='() => ToggleSection("isolements")' @onclick:preventDefault="true">
                        @Loc["ImportProfileTest_IsolementsHeading"]
                    </summary>
                    @if (!_collapsedSections.Contains("isolements"))
                    {
                        <div class="test-table-scroll">
                            <table id="isolements-table" class="table table-sm test-table">
                                <thead>
                                    <tr>
                                        <th>@Loc["ImportProfileTest_Repere"]</th>
                                        <th>@Loc["ImportProfileTest_Designation"]</th>
                                        <th>@Loc["ImportProfileTest_TypeElementNom"]</th>
                                        <th>@Loc["ImportProfileTest_PositionALaPose"]</th>
                                        <th>@Loc["ImportProfileTest_Localisation"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var isolement in _result.Isolements)
                                    {
                                        <tr>
                                            <td>@isolement.Repere</td>
                                            <td>@isolement.Designation</td>
                                            <td>@isolement.TypeElementNom</td>
                                            <td>@isolement.PositionALaPose</td>
                                            <td>@isolement.Localisation</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </details>

                <details class="test-table-details" open="@(!_collapsedSections.Contains("points"))">
                    <summary id="points-details-toggle" @onclick='() => ToggleSection("points")' @onclick:preventDefault="true">
                        @Loc["ImportProfileTest_PointsHeading"]
                    </summary>
                    @if (!_collapsedSections.Contains("points"))
                    {
                        <div class="test-table-scroll">
                            <table id="points-table" class="table table-sm test-table">
                                <thead>
                                    <tr>
                                        <th>@Loc["ImportProfileTest_ColonneNom"]</th>
                                        <th>@Loc["ImportProfileTest_ParentRepere"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var point in _result.Points)
                                    {
                                        <tr>
                                            <td>@point.ColonneNom</td>
                                            <td>@point.ParentRepere</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </details>

                <details class="test-table-details" open="@(!_collapsedSections.Contains("taches-multiples"))">
                    <summary id="taches-multiples-details-toggle" @onclick='() => ToggleSection("taches-multiples")' @onclick:preventDefault="true">
                        @Loc["ImportProfileTest_TachesMultiplesHeading"]
                    </summary>
                    @if (!_collapsedSections.Contains("taches-multiples"))
                    {
                        <div class="test-table-scroll">
                            <table id="taches-multiples-table" class="table table-sm test-table">
                                <thead>
                                    <tr>
                                        <th>@Loc["ImportProfileTest_Ordre"]</th>
                                        <th>@Loc["ImportProfileTest_Action"]</th>
                                        <th>@Loc["ImportProfileTest_Acteur"]</th>
                                        <th>@Loc["ImportProfileTest_Risques"]</th>
                                        <th>@Loc["ImportProfileTest_TypeTacheMultipleCode"]</th>
                                        <th>@Loc["ImportProfileTest_DateValidation"]</th>
                                        <th>@Loc["ImportProfileTest_EstFactice"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tache in _result.TachesMultiples)
                                    {
                                        <tr>
                                            <td>@tache.Ordre</td>
                                            <td>@tache.Action</td>
                                            <td>@tache.Acteur</td>
                                            <td>@tache.Risques</td>
                                            <td>@tache.TypeTacheMultipleCode</td>
                                            <td>@tache.DateValidation</td>
                                            <td>@tache.EstFactice</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </details>

                @if (_result.Errors.Count > 0)
                {
                    <details class="test-table-details" open="@(!_collapsedSections.Contains("warnings"))">
                        <summary id="warnings-details-toggle" @onclick='() => ToggleSection("warnings")' @onclick:preventDefault="true">
                            @Loc["ImportProfileTest_WarningsHeading"]
                        </summary>
                        @if (!_collapsedSections.Contains("warnings"))
                        {
                            <div class="test-table-scroll">
                                <table id="warnings-table" class="table table-sm test-table">
                                    <thead>
                                        <tr>
                                            <th>@Loc["ImportProfileTest_Sheet"]</th>
                                            <th>@Loc["ImportProfileTest_BlockIdentifier"]</th>
                                            <th>@Loc["ImportProfileTest_ErrorCode"]</th>
                                            <th>@Loc["ImportProfileTest_Message"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var warning in _result.Errors)
                                        {
                                            <tr>
                                                <td>@warning.Sheet</td>
                                                <td>@warning.BlockIdentifier</td>
                                                <td>@warning.Code</td>
                                                <td>@warning.Message</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </details>
                }
            </div>
        }
    }
}

@code {
    // Matches the Web API's UploadLimits.MaxExcelFileSizeBytes -- this page enforces the same limit,
    // while staying under Blazor Server's default SignalR message size (bypassed via
    // InputFile.OpenReadStream's own maxAllowedSize parameter).
    private const long MaxFileSizeBytes = 10 * 1024 * 1024;

    private enum State { Idle, Processing, Success, Error }

    // V10: inline SVG (bi-file-earmark-arrow-up shape) -- no bootstrap-icons font/CSS is loaded in
    // this project, see ImportProfiles.razor's own icon-button comment for the same rationale.
    private const string FileUploadIconMarkup =
        """<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5zm0 1v2A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z" /><path d="M8.5 11.5a.5.5 0 0 1-1 0V8.707L6.354 9.854a.5.5 0 1 1-.708-.708l2-2a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5 8.707z" /></svg>""";

    // V8: same inline-SVG rationale, bi-arrow-left shape.
    private const string ArrowLeftIconMarkup =
        """<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" /></svg>""";

    private void BackToList() => NavigationManager.NavigateTo("import-profiles");

    private List<ImportProfile>? _profiles;
    private Guid? _selectedProfileId;
    private State _state = State.Idle;
    private string? _errorMessage;
    private ImportResult? _result;
    private readonly HashSet<string> _collapsedSections = [];

    private void ToggleSection(string section)
    {
        if (!_collapsedSections.Add(section))
        {
            _collapsedSections.Remove(section);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _profiles = (await ImportProfileStore.GetAllAsync()).ToList();
    }

    private async Task OnInputFileChangeAsync(InputFileChangeEventArgs e)
    {
        if (_state == State.Processing)
        {
            return;
        }

        _result = null;

        if (_selectedProfileId is not { } profileId)
        {
            _state = State.Error;
            _errorMessage = Loc["ImportProfileTest_SelectProfilePrompt"];
            return;
        }

        var profile = _profiles!.First(p => p.Id == profileId);

        _state = State.Processing;
        _errorMessage = null;
        StateHasChanged();

        Stream? fileStream = null;

        try
        {
            fileStream = e.File.OpenReadStream(MaxFileSizeBytes);
            await using var buffered = await BrowserFileStreamBuffering.BufferToSeekableStreamAsync(fileStream);
            using var workbookReader = new ClosedXmlWorkbookReader(buffered);
            _result = ImportPipelineOrchestrator.Run(workbookReader, profile);
            _state = State.Success;
        }
        catch (Exception ex)
        {
            _state = State.Error;
            _errorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
        finally
        {
            if (fileStream is not null)
            {
                await fileStream.DisposeAsync();
            }
        }
    }
}
