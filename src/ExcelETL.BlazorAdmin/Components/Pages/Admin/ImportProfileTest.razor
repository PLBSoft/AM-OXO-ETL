@page "/import-profiles/test"
@attribute [Authorize(Roles = IdentitySeeder.AdminRoleName)]

@using ExcelETL.Application.Exceptions
@using ExcelETL.Application.Extraction.Oxo
@using ExcelETL.BlazorAdmin.Excel
@using ExcelETL.Domain.Extraction.Pivot
@using ExcelETL.Domain.Extraction.Profile
@using ExcelETL.Infrastructure.Excel
@using ExcelETL.Infrastructure.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject IImportProfileStore ImportProfileStore
@inject IImportPipelineOrchestrator ImportPipelineOrchestrator
@inject BusinessExceptionLocalizer BusinessExceptionLocalizer
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject NavigationManager NavigationManager

<PageTitle>@Loc["ImportProfileTest_PageTitle"]</PageTitle>

<h1>@Loc["ImportProfileTest_PageTitle"]</h1>

<button id="back-to-import-profiles-button" class="btn btn-secondary mb-3" @onclick="BackToList">
    @Loc["ImportProfileTest_BackToListButton"]
</button>

<p>@Loc["ImportProfileTest_Instructions"]</p>

@if (_profiles is null)
{
    <p>@Loc["ImportProfiles_Loading"]</p>
}
else
{
    var processing = _state == State.Processing;

    <div class="mb-3">
        <label class="form-label" for="test-profile-select">@Loc["ImportProfileTest_ProfileLabel"]</label>
        <select id="test-profile-select" class="form-select" @bind="_selectedProfileId" disabled="@processing">
            <option value="">@Loc["ImportProfileTest_ProfilePlaceholder"]</option>
            @foreach (var profile in _profiles)
            {
                <option value="@profile.Id">@profile.Name</option>
            }
        </select>
        @if (_profiles.Count == 0)
        {
            <div class="form-text">@Loc["ImportProfileTest_NoProfilesAvailable"]</div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label" for="test-file-input">@Loc["ImportProfileTest_FileLabel"]</label>
        <InputFile id="test-file-input" class="form-control" accept=".xlsx" OnChange="OnInputFileChangeAsync" disabled="@processing" />
    </div>

    @if (_state == State.Processing)
    {
        <div id="test-status" class="alert alert-info d-flex align-items-center gap-2">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>@Loc["ImportProfileTest_Processing"]</span>
        </div>
    }
    else if (_state == State.Error)
    {
        <div id="test-status" class="alert alert-danger">@_errorMessage</div>
    }
    else if (_result is not null)
    {
        if (_result.Equipement is null)
        {
            <div id="test-status" class="alert alert-danger">
                <h4>@Loc["ImportProfileTest_RejectedFileHeading"]</h4>
                <ul>
                    @foreach (var error in _result.Errors)
                    {
                        <li>@error.Sheet / @error.BlockIdentifier: @error.Message</li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div id="test-status" class="alert alert-success">
                <h3>@Loc["ImportProfileTest_EquipementHeading"]</h3>
                <table id="equipement-table" class="table table-sm">
                    <thead>
                        <tr>
                            <th>@Loc["ImportProfileTest_Repere"]</th>
                            <th>@Loc["ImportProfileTest_Designation"]</th>
                            <th>@Loc["ImportProfileTest_TypeElementNom"]</th>
                            <th>@Loc["ImportProfileTest_Localisation"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@_result.Equipement.Repere</td>
                            <td>@_result.Equipement.Designation</td>
                            <td>@_result.Equipement.TypeElementNom</td>
                            <td>@_result.Equipement.Localisation</td>
                        </tr>
                    </tbody>
                </table>

                <h3>@Loc["ImportProfileTest_IsolementsHeading"]</h3>
                <table id="isolements-table" class="table table-sm">
                    <thead>
                        <tr>
                            <th>@Loc["ImportProfileTest_Repere"]</th>
                            <th>@Loc["ImportProfileTest_Designation"]</th>
                            <th>@Loc["ImportProfileTest_TypeElementNom"]</th>
                            <th>@Loc["ImportProfileTest_PositionALaPose"]</th>
                            <th>@Loc["ImportProfileTest_Localisation"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var isolement in _result.Isolements)
                        {
                            <tr>
                                <td>@isolement.Repere</td>
                                <td>@isolement.Designation</td>
                                <td>@isolement.TypeElementNom</td>
                                <td>@isolement.PositionALaPose</td>
                                <td>@isolement.Localisation</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <h3>@Loc["ImportProfileTest_PointsHeading"]</h3>
                <table id="points-table" class="table table-sm">
                    <thead>
                        <tr>
                            <th>@Loc["ImportProfileTest_ColonneNom"]</th>
                            <th>@Loc["ImportProfileTest_ParentRepere"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in _result.Points)
                        {
                            <tr>
                                <td>@point.ColonneNom</td>
                                <td>@point.ParentRepere</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <h3>@Loc["ImportProfileTest_TachesMultiplesHeading"]</h3>
                <table id="taches-multiples-table" class="table table-sm">
                    <thead>
                        <tr>
                            <th>@Loc["ImportProfileTest_Ordre"]</th>
                            <th>@Loc["ImportProfileTest_Action"]</th>
                            <th>@Loc["ImportProfileTest_Acteur"]</th>
                            <th>@Loc["ImportProfileTest_Risques"]</th>
                            <th>@Loc["ImportProfileTest_TypeTacheMultipleCode"]</th>
                            <th>@Loc["ImportProfileTest_DateValidation"]</th>
                            <th>@Loc["ImportProfileTest_EstFactice"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tache in _result.TachesMultiples)
                        {
                            <tr>
                                <td>@tache.Ordre</td>
                                <td>@tache.Action</td>
                                <td>@tache.Acteur</td>
                                <td>@tache.Risques</td>
                                <td>@tache.TypeTacheMultipleCode</td>
                                <td>@tache.DateValidation</td>
                                <td>@tache.EstFactice</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (_result.Errors.Count > 0)
                {
                    <h3>@Loc["ImportProfileTest_WarningsHeading"]</h3>
                    <table id="warnings-table" class="table table-sm">
                        <thead>
                            <tr>
                                <th>@Loc["ImportProfileTest_Sheet"]</th>
                                <th>@Loc["ImportProfileTest_BlockIdentifier"]</th>
                                <th>@Loc["ImportProfileTest_ErrorCode"]</th>
                                <th>@Loc["ImportProfileTest_Message"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var warning in _result.Errors)
                            {
                                <tr>
                                    <td>@warning.Sheet</td>
                                    <td>@warning.BlockIdentifier</td>
                                    <td>@warning.Code</td>
                                    <td>@warning.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    }
}

@code {
    // Matches the Web API's UploadLimits.MaxExcelFileSizeBytes -- this page enforces the same limit,
    // while staying under Blazor Server's default SignalR message size (bypassed via
    // InputFile.OpenReadStream's own maxAllowedSize parameter).
    private const long MaxFileSizeBytes = 10 * 1024 * 1024;

    private enum State { Idle, Processing, Success, Error }

    private void BackToList() => NavigationManager.NavigateTo("import-profiles");

    private List<ImportProfile>? _profiles;
    private Guid? _selectedProfileId;
    private State _state = State.Idle;
    private string? _errorMessage;
    private ImportResult? _result;

    protected override async Task OnInitializedAsync()
    {
        _profiles = (await ImportProfileStore.GetAllAsync()).ToList();
    }

    private async Task OnInputFileChangeAsync(InputFileChangeEventArgs e)
    {
        if (_state == State.Processing)
        {
            return;
        }

        _result = null;

        if (_selectedProfileId is not { } profileId)
        {
            _state = State.Error;
            _errorMessage = Loc["ImportProfileTest_SelectProfilePrompt"];
            return;
        }

        var profile = _profiles!.First(p => p.Id == profileId);

        _state = State.Processing;
        _errorMessage = null;
        StateHasChanged();

        Stream? fileStream = null;

        try
        {
            fileStream = e.File.OpenReadStream(MaxFileSizeBytes);
            await using var buffered = await BrowserFileStreamBuffering.BufferToSeekableStreamAsync(fileStream);
            using var workbookReader = new ClosedXmlWorkbookReader(buffered);
            _result = ImportPipelineOrchestrator.Run(workbookReader, profile);
            _state = State.Success;
        }
        catch (Exception ex)
        {
            _state = State.Error;
            _errorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
        finally
        {
            if (fileStream is not null)
            {
                await fileStream.DisposeAsync();
            }
        }
    }
}
