@page "/import-profiles"
@page "/"
@attribute [Authorize(Roles = IdentitySeeder.AdminRoleName)]

@using ExcelETL.Application.Extraction.Oxo
@using ExcelETL.BlazorAdmin.Shared
@using ExcelETL.Domain.Extraction.Profile
@using ExcelETL.Infrastructure.Identity
@using Microsoft.AspNetCore.Authorization

@inject IImportProfileStore ImportProfileStore
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject NavigationManager NavigationManager

<PageTitle>@Loc["ImportProfiles_PageTitle"]</PageTitle>

<h1>@Loc["ImportProfiles_PageTitle"]</h1>

<!-- Lot 030 (30.7): reopens V4/X2's mobile stacking decision on explicit client request -- the two
     buttons now stay on one row at every breakpoint, sharing the available width equally
     (flex-fill) instead of each going full-width on its own line. If a button's label doesn't fit
     on one line at the resulting width, it wraps to two lines *inside* the button (native <button>
     behavior, no extra CSS) -- an accepted trade-off, distinct from the original bug (two buttons
     on two lines). -->
<div class="right-aligned-actions d-flex gap-2 mb-3">
    <button id="test-import-profile-button" class="btn btn-secondary flex-fill" @onclick="TestProfile">
        @Loc["NavMenu_ImportProfileTest"]
    </button>
    <button id="create-profile-button" class="btn btn-primary flex-fill" @onclick="CreateProfile">
        @Loc["ImportProfiles_Create"]
    </button>
</div>

@if (_profiles is null)
{
    <p>@Loc["ImportProfiles_Loading"]</p>
}
else if (_profiles.Count == 0)
{
    <p>@Loc["ImportProfiles_NoEntries"]</p>
}
else
{
    <table class="table d-none d-md-table">
        <thead>
            <tr>
                <th>@Loc["ImportProfiles_Name"]</th>
                <th>@Loc["ImportProfiles_EquipementTypeElementNom"]</th>
                <th>@Loc["ImportProfiles_SheetCountHeader"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var profile in _profiles)
            {
                <tr>
                    <td>@profile.Name</td>
                    <td>@profile.EquipementTypeElementNom</td>
                    <td>@Loc["ImportProfiles_SheetCount", profile.SheetRules.Count]</td>
                    <td>
                        @if (_profileIdPendingDeletion == profile.Id)
                        {
                            <div id="@($"delete-profile-confirm-{profile.Id}")" class="right-aligned-actions">
                                <span class="text-danger me-auto">@Loc["ImportProfiles_ConfirmDeleteMessage", _profileNamePendingDeletion]</span>
                                <button id="@($"confirm-delete-profile-button-{profile.Id}")" type="button"
                                        class="btn btn-sm btn-danger"
                                        @onclick="() => ConfirmDeleteProfileAsync(profile.Id)">
                                    @Loc["ImportProfiles_ConfirmDeleteButton"]
                                </button>
                                <button id="@($"cancel-delete-profile-button-{profile.Id}")" type="button"
                                        class="btn btn-sm btn-secondary"
                                        @onclick="CancelDeleteProfile">
                                    @Loc["ImportProfiles_CancelDeleteButton"]
                                </button>
                            </div>
                        }
                        else
                        {
                            <button id="edit-profile-button-@profile.Id" type="button"
                                    class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                    aria-label="@Loc["ImportProfiles_Edit"]" title="@Loc["ImportProfiles_Edit"]"
                                    @onclick="() => EditProfile(profile)">
                                @((MarkupString)AdminIconMarkup.Pencil)
                            </button>
                            <button id="duplicate-profile-button-@profile.Id" type="button"
                                    class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                    aria-label="@Loc["ImportProfiles_Duplicate"]" title="@Loc["ImportProfiles_Duplicate"]"
                                    @onclick="() => DuplicateProfileAsync(profile)">
                                @((MarkupString)AdminIconMarkup.Copy)
                            </button>
                            <button id="delete-profile-button-@profile.Id" type="button"
                                    class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                    aria-label="@Loc["ImportProfiles_Delete", profile.Name]" title="@Loc["ImportProfiles_Delete", profile.Name]"
                                    @onclick="() => RequestDeleteProfile(profile)">
                                @((MarkupString)AdminIconMarkup.Trash)
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-md-none">
        @foreach (var profile in _profiles)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@profile.Name</h5>
                    <p class="card-text mb-1">
                        <strong>@Loc["ImportProfiles_EquipementTypeElementNom"]:</strong> @profile.EquipementTypeElementNom
                    </p>
                    <p class="card-text">@Loc["ImportProfiles_SheetCount", profile.SheetRules.Count]</p>
                    @if (_profileIdPendingDeletion == profile.Id)
                    {
                        <div id="@($"delete-profile-confirm-card-{profile.Id}")" class="right-aligned-actions">
                            <span class="text-danger me-auto">@Loc["ImportProfiles_ConfirmDeleteMessage", _profileNamePendingDeletion]</span>
                            <button id="@($"confirm-delete-profile-button-card-{profile.Id}")" type="button"
                                    class="btn btn-sm btn-danger"
                                    @onclick="() => ConfirmDeleteProfileAsync(profile.Id)">
                                @Loc["ImportProfiles_ConfirmDeleteButton"]
                            </button>
                            <button id="@($"cancel-delete-profile-button-card-{profile.Id}")" type="button"
                                    class="btn btn-sm btn-secondary"
                                    @onclick="CancelDeleteProfile">
                                @Loc["ImportProfiles_CancelDeleteButton"]
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="right-aligned-actions">
                            <button id="edit-profile-button-card-@profile.Id" type="button"
                                    class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                    aria-label="@Loc["ImportProfiles_Edit"]" title="@Loc["ImportProfiles_Edit"]"
                                    @onclick="() => EditProfile(profile)">
                                @((MarkupString)AdminIconMarkup.Pencil)
                            </button>
                            <button id="duplicate-profile-button-card-@profile.Id" type="button"
                                    class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                    aria-label="@Loc["ImportProfiles_Duplicate"]" title="@Loc["ImportProfiles_Duplicate"]"
                                    @onclick="() => DuplicateProfileAsync(profile)">
                                @((MarkupString)AdminIconMarkup.Copy)
                            </button>
                            <button id="delete-profile-button-card-@profile.Id" type="button"
                                    class="btn btn-outline-secondary btn-sm block-field-icon-btn"
                                    aria-label="@Loc["ImportProfiles_Delete", profile.Name]" title="@Loc["ImportProfiles_Delete", profile.Name]"
                                    @onclick="() => RequestDeleteProfile(profile)">
                                @((MarkupString)AdminIconMarkup.Trash)
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<ImportProfile>? _profiles;
    private Guid? _profileIdPendingDeletion;
    private string? _profileNamePendingDeletion;

    protected override async Task OnInitializedAsync() => await LoadProfilesAsync();

    private async Task LoadProfilesAsync() => _profiles = (await ImportProfileStore.GetAllAsync()).ToList();

    private void CreateProfile() => NavigationManager.NavigateTo("import-profiles/new");

    private void TestProfile() => NavigationManager.NavigateTo("import-profiles/test");

    private void EditProfile(ImportProfile profile) => NavigationManager.NavigateTo($"import-profiles/{profile.Id}/edit");

    private void RequestDeleteProfile(ImportProfile profile)
    {
        _profileIdPendingDeletion = profile.Id;
        _profileNamePendingDeletion = profile.Name;
    }

    private void CancelDeleteProfile()
    {
        _profileIdPendingDeletion = null;
        _profileNamePendingDeletion = null;
    }

    private async Task ConfirmDeleteProfileAsync(Guid id)
    {
        await ImportProfileStore.DeleteAsync(id);
        _profileIdPendingDeletion = null;
        _profileNamePendingDeletion = null;
        await LoadProfilesAsync();
    }

    private async Task DuplicateProfileAsync(ImportProfile profile)
    {
        var duplicateName = ProfileDuplicateNaming.BuildAvailableDuplicateName(
            profile.Name, Loc["ImportProfiles_DuplicateSuffix"].Value, _profiles!.Select(p => p.Name).ToList());
        var duplicate = new ImportProfile(
            duplicateName,
            profile.ReperePrefix,
            profile.EquipementTypeElementNom,
            profile.DefaultTableaux,
            profile.DefaultApplicationNames,
            profile.SheetRules);

        await ImportProfileStore.SaveAsync(duplicate);
        await LoadProfilesAsync();
    }
}
