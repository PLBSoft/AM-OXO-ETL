@using ExcelETL.BlazorAdmin.Editing.Import
@using ExcelETL.BlazorAdmin.Shared

@inject IStringLocalizer<BlazorAdminMessages> Loc

@* Add/edit sub-form for a FieldPresencePointRule ("create this Colonne's Point only when this cell
   of the block is filled in" -- or, with an expected value, "holds exactly this text", e.g. PLATINES'
   RECEPTION DEBUT MAD when H19 = DEBUT MAD). The cell is entered as an absolute Excel range of the first
   block. Lot 075 (P3 drafts): a pure leaf -- every value lives in Draft, owned and validated by
   SheetRuleForm (ImportProfileDraftMapper.ConvertFieldPresencePointRule). The blur-to-add trigger sits on
   the last field, the optional expected value. *@

@if (!string.IsNullOrEmpty(Draft.Error))
{
    <div class="alert alert-danger" role="alert">@Draft.Error</div>
}
@if (!string.IsNullOrEmpty(Draft.Warning))
{
    <div class="alert alert-warning">@Draft.Warning</div>
}

<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}colonne-name-input")" @ref="_colonneNameInputRef" class="form-control" @bind="Draft.ColonneName" @bind:after="MarkDirty"
               @onkeydown="OnRowKeyDownAsync"
               placeholder="@Loc["ImportProfileEditor_ColonneNamePlaceholder"]" />
        <label for="@($"{IdPrefix}colonne-name-input")">@Loc["ImportProfileEditor_ColonneNameLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}absolute-range-input")" class="form-control" @bind="Draft.AbsoluteRange" @bind:after="MarkDirty"
               @onkeydown="OnRowKeyDownAsync"
               placeholder="@Loc["ImportProfileEditor_AbsoluteRangePlaceholder"]" />
        <label for="@($"{IdPrefix}absolute-range-input")">@Loc["ImportProfileEditor_AbsoluteRangeLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}expected-value-input")" class="form-control" @bind="Draft.ExpectedValue" @bind:after="MarkDirty"
               @onkeydown="OnRowKeyDownAsync" @onfocusout="OnLastFieldBlurAsync"
               placeholder="@Loc["ImportProfileEditor_FieldPresenceExpectedValuePlaceholder"]" />
        <label for="@($"{IdPrefix}expected-value-input")">@Loc["ImportProfileEditor_FieldPresenceExpectedValueLabel"]</label>
    </div>
    <div class="form-text">@Loc["ImportProfileEditor_FieldPresenceExpectedValueHint"]</div>
</div>

<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="Submit">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        else
        {
            @((MarkupString)AdminIconMarkup.Plus)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3" @onclick="() => OnCancel.InvokeAsync()">
            @Loc["ImportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public FieldPresencePointRuleDraft Draft { get; set; } = new();

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-field-presence-rule-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-field-presence-rule-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnDirty { get; set; }

    private ElementReference _colonneNameInputRef;

    private void MarkDirty() => OnDirty.InvokeAsync();

    // Lot 056 (56.4): same submit/focus and blur/Enter contract as BlockFieldForm.
    private async Task Submit()
    {
        await OnSubmit.InvokeAsync();
        if (Draft.Error is null)
        {
            await _colonneNameInputRef.FocusAsync();
        }
    }

    private bool IsRowFullyFilled() => !string.IsNullOrWhiteSpace(Draft.ColonneName) && !string.IsNullOrWhiteSpace(Draft.AbsoluteRange);

    private async Task OnLastFieldBlurAsync()
    {
        if (IsRowFullyFilled())
        {
            await Submit();
        }
    }

    private async Task OnRowKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && IsRowFullyFilled())
        {
            await Submit();
        }
    }
}
