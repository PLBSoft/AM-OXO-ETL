@using ExcelETL.Application.Exceptions
@using ExcelETL.BlazorAdmin.Formatting
@using ExcelETL.BlazorAdmin.Shared
@using ExcelETL.Domain.Exceptions
@using ExcelETL.Domain.Extraction.Primitives

@inject BusinessExceptionLocalizer BusinessExceptionLocalizer
@inject IStringLocalizer<BlazorAdminMessages> Loc

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
@if (!string.IsNullOrEmpty(_warningMessage))
{
    <div class="alert alert-warning">@_warningMessage</div>
}

<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}name-input")" class="form-control" @bind="_name"
               placeholder="@Loc["ImportProfileEditor_FieldNamePlaceholder"]" />
        <label for="@($"{IdPrefix}name-input")">@Loc["ImportProfileEditor_FieldNameLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}absolute-range-input")" class="form-control" @bind="_absoluteRange"
               placeholder="@Loc["ImportProfileEditor_AbsoluteRangePlaceholder"]" />
        <label for="@($"{IdPrefix}absolute-range-input")">@Loc["ImportProfileEditor_AbsoluteRangeLabel"]</label>
    </div>
</div>

<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-outline-secondary w-100 mt-3" @onclick="Submit">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3" @onclick="Cancel">
            @Loc["ImportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter]
    public BlockFieldDefinition? InitialField { get; set; }

    // Needed to translate between the field's stored relative offsets and the absolute Excel range
    // shown/entered here -- the parent SheetRuleForm owns FirstBlockStartRow, this component has no
    // locator context of its own. See BlockFieldRangeFormatter.
    [Parameter]
    public int FirstBlockStartRow { get; set; }

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-block-field-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-block-field-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback<BlockFieldDefinition> OnSubmit { get; set; }

    private string _name = string.Empty;
    private string _absoluteRange = string.Empty;
    private string? _errorMessage;
    private string? _warningMessage;

    // Only ever runs once per mounted instance -- same reasoning as SheetRuleForm.OnInitialized:
    // the parent gives an edit-mode instance a fresh component identity, so InitialField never
    // changes underneath an already-initialized instance. FirstBlockStartRow is already set by the
    // time this runs (Blazor sets parameters before the first OnInitialized call).
    protected override void OnInitialized()
    {
        if (InitialField is null)
        {
            return;
        }

        _name = InitialField.Name;
        _absoluteRange = BlockFieldRangeFormatter.ToAbsoluteRange(
            FirstBlockStartRow, InitialField.ColumnRange, InitialField.RowOffsetStart, InitialField.RowOffsetEnd);
    }

    private async Task Submit()
    {
        _errorMessage = null;
        _warningMessage = null;

        var parseResult = BlockFieldRangeFormatter.FromAbsoluteRange(_absoluteRange, FirstBlockStartRow);
        if (!parseResult.IsSuccess)
        {
            _errorMessage = Loc["ImportProfileEditor_InvalidExcelRangeError"];
            return;
        }

        try
        {
            var field = new BlockFieldDefinition(
                _name, parseResult.ColumnRange, parseResult.RowOffsetStart, parseResult.RowOffsetEnd);

            await OnSubmit.InvokeAsync(field);

            if (parseResult.IsBeyondPracticalRange)
            {
                _warningMessage = Loc["ImportProfileEditor_ExcelRangeBeyondPracticalRangeWarning"];
            }

            ResetForm();
        }
        catch (DomainValidationException ex)
        {
            _errorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }

    private async Task Cancel() => await OnCancel.InvokeAsync();

    private void ResetForm()
    {
        _name = string.Empty;
        _absoluteRange = string.Empty;
    }
}
