@using ExcelETL.BlazorAdmin.Editing.Import
@using ExcelETL.BlazorAdmin.Shared

@inject IStringLocalizer<BlazorAdminMessages> Loc

@* Lot 075 (P3 drafts): a pure leaf -- every value lives in Draft, owned by SheetRuleForm, which converts
   and validates it (ImportProfileDraftMapper.ConvertField) and decides what a successful submit means for
   the slot this Draft came from (an already-added field, or the pending "Add" row). *@

@if (!string.IsNullOrEmpty(Draft.Error))
{
    <div class="alert alert-danger" role="alert">@Draft.Error</div>
}
@if (!string.IsNullOrEmpty(Draft.Warning))
{
    <div class="alert alert-warning">@Draft.Warning</div>
}

<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}name-input")" @ref="_nameInputRef" class="form-control" @bind="Draft.Name" @bind:after="MarkDirty"
               @onkeydown="OnRowKeyDownAsync"
               placeholder="@Loc["ImportProfileEditor_FieldNamePlaceholder"]" />
        <label for="@($"{IdPrefix}name-input")">@Loc["ImportProfileEditor_FieldNameLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}absolute-range-input")" class="form-control" @bind="Draft.AbsoluteRange" @bind:after="MarkDirty"
               @onkeydown="OnRowKeyDownAsync" @onfocusout="OnLastFieldBlurAsync"
               placeholder="@Loc["ImportProfileEditor_AbsoluteRangePlaceholder"]" />
        <label for="@($"{IdPrefix}absolute-range-input")">@Loc["ImportProfileEditor_AbsoluteRangeLabel"]</label>
    </div>
</div>
@* Lot 084 (G4): not shown on PROCEDURE, whose service walks its tasks itself, tolerantly. *@
@if (ShowIsRequired)
{
    <div class="form-check mb-3">
        <input id="@($"{IdPrefix}is-required-checkbox")" type="checkbox" class="form-check-input"
               @bind="Draft.IsRequired" @bind:after="MarkDirty" />
        <label class="form-check-label" for="@($"{IdPrefix}is-required-checkbox")">@Loc["ImportProfileEditor_FieldIsRequiredLabel"]</label>
    </div>
}

<!-- Lot 056 (56.7): submission and cancel are now visually distinct in every mode -- the
     submission button is always solid btn-secondary (icon still Plus in add mode / Check in edit
     mode, Lot 041 unchanged); "Cancel" stays btn-outline-secondary. Previously both were
     btn-outline-secondary in edit mode, indistinguishable (audit S2.3 / lot 053 deferral). -->
<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="Submit">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        else
        {
            @((MarkupString)AdminIconMarkup.Plus)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="() => OnCancel.InvokeAsync()">
            @((MarkupString)AdminIconMarkup.X) @Loc["ImportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public BlockFieldDefinitionDraft Draft { get; set; } = new();

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-block-field-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-block-field-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public bool ShowIsRequired { get; set; } = true;

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnDirty { get; set; }

    private ElementReference _nameInputRef;

    private void MarkDirty() => OnDirty.InvokeAsync();

    // The owner sets Draft.Error when the submit fails. Lot 056 (56.4): after a successful submit, focus
    // returns to the row's first field for a rapid, mouse-free "type, type, next" entry rhythm.
    private async Task Submit()
    {
        await OnSubmit.InvokeAsync();
        if (Draft.Error is null)
        {
            await _nameInputRef.FocusAsync();
        }
    }

    // Lot 056 (56.4): validation on blur of the row's last field, or Enter anywhere in the row -- but
    // only when every field of the row is already filled in. A partially-filled row produces no add and
    // no error message on blur (a normal "click elsewhere" gesture must never surface a red alert); the
    // button click remains a fully equivalent, always-available third path.
    private bool IsRowFullyFilled() => !string.IsNullOrWhiteSpace(Draft.Name) && !string.IsNullOrWhiteSpace(Draft.AbsoluteRange);

    private async Task OnLastFieldBlurAsync()
    {
        if (IsRowFullyFilled())
        {
            await Submit();
        }
    }

    private async Task OnRowKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && IsRowFullyFilled())
        {
            await Submit();
        }
    }
}
