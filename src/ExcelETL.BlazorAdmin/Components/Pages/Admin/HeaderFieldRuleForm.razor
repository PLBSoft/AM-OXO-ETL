@using ExcelETL.BlazorAdmin.Editing.Import
@using ExcelETL.BlazorAdmin.Shared

@inject IStringLocalizer<BlazorAdminMessages> Loc

@* Lot 075 (P3 drafts): a pure leaf -- every value lives in Draft, owned and validated by SheetRuleForm
   (ImportProfileDraftMapper.ConvertHeaderField). No sheet input: a header field always reads its rule's
   own sheet (Lot 048 decision 2, part of the model itself since lot 084, G13). *@

@if (!string.IsNullOrEmpty(Draft.Error))
{
    <div class="alert alert-danger" role="alert">@Draft.Error</div>
}

<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}header-field-name-input")" class="form-control" @bind="Draft.Name" @bind:after="MarkDirty"
               placeholder="@Loc["ImportProfileEditor_HeaderFieldNamePlaceholder"]" />
        <label for="@($"{IdPrefix}header-field-name-input")">@Loc["ImportProfileEditor_HeaderFieldNameLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}header-field-range-input")" class="form-control" @bind="Draft.Range" @bind:after="MarkDirty"
               placeholder="@Loc["ImportProfileEditor_HeaderFieldRangePlaceholder"]" />
        <label for="@($"{IdPrefix}header-field-range-input")">@Loc["ImportProfileEditor_HeaderFieldRangeLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}header-field-date-format-input")" class="form-control" @bind="Draft.DateFormat" @bind:after="MarkDirty"
               placeholder="@Loc["ImportProfileEditor_HeaderFieldDateFormatPlaceholder"]" />
        <label for="@($"{IdPrefix}header-field-date-format-input")">@Loc["ImportProfileEditor_HeaderFieldDateFormatLabel"]</label>
    </div>
    <div class="form-text">@Loc["ImportProfileEditor_HeaderFieldDateFormatHint"]</div>
</div>
<div class="mb-3 form-check">
    <input id="@($"{IdPrefix}header-field-strip-prefix-checkbox")" type="checkbox" class="form-check-input" @bind="Draft.StripReperePrefix" @bind:after="MarkDirty" />
    <label class="form-check-label" for="@($"{IdPrefix}header-field-strip-prefix-checkbox")">@Loc["ImportProfileEditor_HeaderFieldStripPrefixLabel"]</label>
</div>

<!-- Lot 056 (56.7): submission and cancel are now visually distinct in every mode -- the
     submission button is always solid btn-secondary (icon still Plus in add mode / Check in edit
     mode, Lot 041 unchanged); "Cancel" stays btn-outline-secondary. Previously both were
     btn-outline-secondary in edit mode, indistinguishable (audit S2.3 / lot 053 deferral). -->
<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="() => OnSubmit.InvokeAsync()">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        else
        {
            @((MarkupString)AdminIconMarkup.Plus)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="() => OnCancel.InvokeAsync()">
            @((MarkupString)AdminIconMarkup.X) @Loc["ImportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public HeaderFieldRuleDraft Draft { get; set; } = new();

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-header-field-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-header-field-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnDirty { get; set; }

    private void MarkDirty() => OnDirty.InvokeAsync();
}
