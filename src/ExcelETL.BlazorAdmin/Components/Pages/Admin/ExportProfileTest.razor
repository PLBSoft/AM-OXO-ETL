@page "/export-profiles/test"
@attribute [Authorize(Roles = IdentitySeeder.AdminRoleName)]

@using ExcelETL.Application.Exceptions
@using ExcelETL.Application.Extraction.Oxo
@using ExcelETL.Application.Generation
@using ExcelETL.BlazorAdmin.Excel
@using ExcelETL.Domain.Extraction.Pivot
@using ExcelETL.Domain.Extraction.Profile
@using ExcelETL.Domain.Generation.Profile
@using ExcelETL.Infrastructure.Excel
@using ExcelETL.Infrastructure.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject IImportProfileStore ImportProfileStore
@inject IImportPipelineOrchestrator ImportPipelineOrchestrator
@inject IExportProfileStore ExportProfileStore
@inject ISheetGenerationEngine SheetGenerationEngine
@inject IWorkbookWriter WorkbookWriter
@inject BusinessExceptionLocalizer BusinessExceptionLocalizer
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject NavigationManager NavigationManager

<PageTitle>@Loc["ExportProfileTest_PageTitle"]</PageTitle>

<!-- X11 (Lot X): back link now lives in the shared top-row banner via SectionContent -- see
     PageBackNavLink.razor / ImportProfileTest.razor's identical comment. -->
<PageBackNavLink Id="back-to-export-profiles-button" Label="@Loc["ExportProfileTest_BackToListButton"]" OnClick="BackToList" />

<h1>@Loc["ExportProfileTest_PageTitle"]</h1>

<!-- V9: same de-emphasized single-sentence intro treatment as ImportProfileTest.razor. -->
<p class="text-muted small">@Loc["ExportProfileTest_Instructions"]</p>

@if (_importProfiles is null || _exportProfiles is null)
{
    <p>@Loc["ExportProfileTest_Loading"]</p>
}
else
{
    var processing = _state == State.Processing;

    <div class="mb-3">
        <label class="form-label" for="export-test-import-profile-select">@Loc["ExportProfileTest_ImportProfileLabel"]</label>
        <select id="export-test-import-profile-select" class="form-select form-select-lg" @bind="_selectedImportProfileId" disabled="@processing">
            <option value="">@Loc["ExportProfileTest_ImportProfilePlaceholder"]</option>
            @foreach (var profile in _importProfiles)
            {
                <option value="@profile.Id">@profile.Name</option>
            }
        </select>
        @if (_importProfiles.Count == 0)
        {
            <div class="form-text">@Loc["ExportProfileTest_NoImportProfilesAvailable"]</div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label" for="export-test-file-input">@Loc["ExportProfileTest_FileLabel"]</label>
        <!-- V10: same Bootstrap-native upload styling as ImportProfileTest.razor -- see its comment.
             Lot 033: `multiple` accepts 1-N files transparently, mirroring the import page. -->
        <div class="input-group">
            <span class="input-group-text">@((MarkupString)FileUploadIconMarkup)</span>
            <InputFile id="export-test-file-input" class="form-control form-control-lg" accept=".xlsx" multiple OnChange="OnInputFileChangeAsync" disabled="@processing" />
        </div>
    </div>

    <!-- Lot 040 (40.2): same stable aria-live wrapper as ImportProfileTest.razor -- see its comment. -->
    <div id="export-test-status-region" aria-live="polite">
    @if (_state == State.Processing)
    {
        <div id="export-test-status" class="alert alert-info d-flex align-items-center gap-2">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>@Loc["ExportProfileTest_Processing"]</span>
        </div>
    }
    else if (_state == State.Error)
    {
        <div id="export-test-status" class="alert alert-danger" role="alert">@_importErrorMessage</div>
    }
    else if (_batchResults is not null)
    {
        <div id="export-batch-results">
            <p id="batch-summary">@BuildBatchSummaryText()</p>

            @if (_batchResults.Any(r => r.Status is BatchFileStatus.Ok or BatchFileStatus.Warning))
            {
                <div class="mb-3">
                    <label class="form-label" for="export-test-export-profile-select">@Loc["ExportProfileTest_ExportProfileLabel"]</label>
                    <select id="export-test-export-profile-select" class="form-select form-select-lg" @bind="_selectedExportProfileId">
                        <option value="">@Loc["ExportProfileTest_ExportProfilePlaceholder"]</option>
                        @foreach (var profile in _exportProfiles)
                        {
                            <option value="@profile.Id">@profile.Name</option>
                        }
                    </select>
                    @if (_exportProfiles.Count == 0)
                    {
                        <div class="form-text">@Loc["ExportProfileTest_NoExportProfilesAvailable"]</div>
                    }
                </div>

                <!-- V12: primary action button only -- full width below md, natural width from md up. -->
                <button id="generate-workbook-button" class="btn btn-primary btn-lg w-100 w-md-auto mb-3" @onclick="GenerateWorkbooksForBatch">
                    @Loc["ExportProfileTest_GenerateButton"]
                </button>

                @if (!string.IsNullOrEmpty(_generationErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">@_generationErrorMessage</div>
                }
            }

            @{ var singleFile = _batchResults.Count == 1; }

            @foreach (var (fileResult, index) in _batchResults.Select((r, i) => (r, i)))
            {
                var suffix = singleFile ? "" : $"-{index}";
                var isFileCollapsed = _collapsedFileSections.Contains(index);

                <details class="test-table-details batch-file-details" open="@(!isFileCollapsed)">
                    <summary id="file-details-toggle-@index" @onclick="() => ToggleFileSection(index)" @onclick:preventDefault="true">
                        <span class="batch-file-name">@fileResult.FileName</span>
                        <span class="badge @GetStatusBadgeClass(fileResult.Status)">@GetStatusLabel(fileResult.Status)</span>
                    </summary>
                    @if (!isFileCollapsed)
                    {
                        <div class="batch-file-content">
                            @if (fileResult.Status == BatchFileStatus.TechnicalError)
                            {
                                <div id="@($"technical-error{suffix}")" class="alert alert-secondary">
                                    <h4>@Loc["ExportProfileTest_StatusTechnicalError"]</h4>
                                    <p>@fileResult.TechnicalErrorMessage</p>
                                </div>
                            }
                            else if (fileResult.ImportResult!.Equipement is null)
                            {
                                <div id="@($"rejected{suffix}")" class="alert alert-danger" role="alert">
                                    <h4>@Loc["ExportProfileTest_RejectedFileHeading"]</h4>
                                    <ul>
                                        @foreach (var error in fileResult.ImportResult.Errors)
                                        {
                                            <li>@error.Sheet / @error.BlockIdentifier: @error.Message</li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                var result = fileResult.ImportResult;

                                @if (result.Errors.Count > 0)
                                {
                                    <details class="test-table-details" open="@(!_collapsedSections.Contains($"{index}:warnings"))">
                                        <summary id="@($"warnings-details-toggle{suffix}")" @onclick='() => ToggleSection(index, "warnings")' @onclick:preventDefault="true">
                                            @Loc["ExportProfileTest_WarningsHeading", result.Errors.Count]
                                        </summary>
                                        @if (!_collapsedSections.Contains($"{index}:warnings"))
                                        {
                                            <div class="generated-sheet-scroll">
                                                <table id="@($"warnings-table{suffix}")" class="table table-sm table-striped generated-sheet-table">
                                                    <thead>
                                                        <tr>
                                                            <th>@Loc["ExportProfileTest_Sheet"]</th>
                                                            <th>@Loc["ExportProfileTest_BlockIdentifier"]</th>
                                                            <th>@Loc["ExportProfileTest_ErrorCode"]</th>
                                                            <th>@Loc["ExportProfileTest_Message"]</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var warning in result.Errors)
                                                        {
                                                            <tr>
                                                                <td>@warning.Sheet</td>
                                                                <td>@warning.BlockIdentifier</td>
                                                                <td>@warning.Code</td>
                                                                <td>@warning.Message</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </details>
                                }

                                @if (!string.IsNullOrEmpty(fileResult.GenerationErrorMessage))
                                {
                                    <div class="alert alert-danger" role="alert">@fileResult.GenerationErrorMessage</div>
                                }

                                @if (fileResult.GeneratedWorkbook is not null)
                                {
                                    <!-- V13: result block as a card component (shadow + success-tinted
                                         background) instead of a plain alert, same treatment as
                                         ImportProfileTest.razor -- one per generated file. -->
                                    <div class="card shadow-sm bg-success-subtle">
                                      <div class="card-body">
                                        <a id="@($"download-generated-workbook-link{suffix}")" class="btn btn-success w-100 btn-lg mb-3"
                                           href="@fileResult.DownloadDataUrl" download="@fileResult.DownloadFileName">
                                            @Loc["ExportProfileTest_DownloadLinkText"]
                                        </a>

                                        @foreach (var sheet in fileResult.GeneratedWorkbook.Sheets)
                                        {
                                            <details class="test-table-details" open="@(!_collapsedSections.Contains($"{index}:{sheet.Name}"))">
                                                <summary id="@($"generated-sheet-{sheet.Name}-details-toggle{suffix}")" @onclick="() => ToggleSection(index, sheet.Name)" @onclick:preventDefault="true">
                                                    @Loc["ExportProfileTest_SheetNameWithCount", sheet.Name, GetGeneratedSheetItemCount(fileResult, sheet)]
                                                </summary>
                                                @if (!_collapsedSections.Contains($"{index}:{sheet.Name}"))
                                                {
                                                    <div class="generated-sheet-scroll">
                                                        <table id="@($"generated-sheet-{sheet.Name}-table{suffix}")" class="table table-sm table-striped generated-sheet-table">
                                                            <thead>
                                                                <tr>
                                                                    @foreach (var header in sheet.Headers)
                                                                    {
                                                                        <th>@header</th>
                                                                    }
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var row in sheet.Rows)
                                                                {
                                                                    <tr>
                                                                        @foreach (var cell in row.Cells)
                                                                        {
                                                                            <td>@cell</td>
                                                                        }
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </details>
                                        }
                                      </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </details>
            }
        </div>
    }
    </div>
}

@code {
    private enum State { Idle, Processing, Success, Error }

    // V10: same icon shape as ImportProfileTest.razor -- see its comment.
    private const string FileUploadIconMarkup =
        """<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5zm0 1v2A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z" /><path d="M8.5 11.5a.5.5 0 0 1-1 0V8.707L6.354 9.854a.5.5 0 1 1-.708-.708l2-2a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5 8.707z" /></svg>""";

    private void BackToList() => NavigationManager.NavigateTo("export-profiles");

    // Lot 033 (33.4): the import step itself is shared with ImportProfileTest.razor via
    // BatchImportProcessing -- see that class's own comment. This page's result type extends the
    // shared one with generation state filled in by a later, separate pass
    // (GenerateWorkbooksForBatch) once an export profile is picked -- a plain mutable class, not a
    // record, since those extra fields are set after construction.
    private sealed class ExportBatchFileResult
    {
        public required string FileName { get; init; }
        public required BatchFileStatus Status { get; init; }
        public ImportResult? ImportResult { get; init; }
        public string? TechnicalErrorMessage { get; init; }
        public GeneratedWorkbook? GeneratedWorkbook { get; set; }
        public string? DownloadDataUrl { get; set; }
        public string? DownloadFileName { get; set; }
        public string? GenerationErrorMessage { get; set; }

        public static ExportBatchFileResult From(BatchImportProcessing.Result result) => new()
        {
            FileName = result.FileName,
            Status = result.Status,
            ImportResult = result.ImportResult,
            TechnicalErrorMessage = result.TechnicalErrorMessage
        };
    }

    private List<ImportProfile>? _importProfiles;
    private List<ExportProfile>? _exportProfiles;
    private Guid? _selectedImportProfileId;
    private Guid? _selectedExportProfileId;
    private State _state = State.Idle;
    private string? _importErrorMessage;
    private List<ExportBatchFileResult>? _batchResults;
    private string? _generationErrorMessage;
    private ExportProfile? _generatedExportProfile;
    private readonly HashSet<string> _collapsedSections = [];
    private readonly HashSet<int> _collapsedFileSections = [];

    private void ToggleSection(int index, string section)
    {
        var key = $"{index}:{section}";
        if (!_collapsedSections.Add(key))
        {
            _collapsedSections.Remove(key);
        }
    }

    private void ToggleFileSection(int index)
    {
        if (!_collapsedFileSections.Add(index))
        {
            _collapsedFileSections.Remove(index);
        }
    }

    private static string GetStatusBadgeClass(BatchFileStatus status) => status switch
    {
        BatchFileStatus.Ok => "bg-success",
        BatchFileStatus.Warning => "bg-warning text-dark",
        BatchFileStatus.Rejected => "bg-danger",
        BatchFileStatus.TechnicalError => "bg-dark",
        _ => "bg-secondary"
    };

    private string GetStatusLabel(BatchFileStatus status) => status switch
    {
        BatchFileStatus.Ok => Loc["ExportProfileTest_StatusOk"],
        BatchFileStatus.Warning => Loc["ExportProfileTest_StatusWarning"],
        BatchFileStatus.Rejected => Loc["ExportProfileTest_StatusRejected"],
        BatchFileStatus.TechnicalError => Loc["ExportProfileTest_StatusTechnicalError"],
        _ => string.Empty
    };

    private string BuildBatchSummaryText()
    {
        var results = _batchResults!;
        var okCount = results.Count(r => r.Status == BatchFileStatus.Ok);
        var warningCount = results.Count(r => r.Status == BatchFileStatus.Warning);
        var rejectedCount = results.Count(r => r.Status == BatchFileStatus.Rejected);
        var technicalErrorCount = results.Count(r => r.Status == BatchFileStatus.TechnicalError);

        var parts = new List<string>();
        if (okCount > 0)
        {
            parts.Add(Loc["ExportProfileTest_BatchStatusOkCount", okCount]);
        }
        if (warningCount > 0)
        {
            parts.Add(Loc["ExportProfileTest_BatchStatusWarningCount", warningCount]);
        }
        if (rejectedCount > 0)
        {
            parts.Add(Loc["ExportProfileTest_BatchStatusRejectedCount", rejectedCount]);
        }
        if (technicalErrorCount > 0)
        {
            parts.Add(Loc["ExportProfileTest_BatchStatusTechnicalErrorCount", technicalErrorCount]);
        }

        return $"{Loc["ExportProfileTest_BatchSummaryHeading", results.Count]} {string.Join(", ", parts)}";
    }

    // A sheet's item count depends on which pivot fed it, which GeneratedSheet itself doesn't carry
    // (it's just headers/rows) -- resolved via the ExportProfile rule that produced it instead, scoped
    // to the one file's own ImportResult. Equipement/Isolement rules always produce exactly one
    // physically-named sheet (SheetName as-is); anything left over is, by elimination, a
    // PivotSource.TacheMultiple dynamic sheet, matched back to its TypeTacheMultipleCode group via the
    // same sanitizer the engine used to name it (Lot T3/T4).
    private int GetGeneratedSheetItemCount(ExportBatchFileResult fileResult, GeneratedSheet sheet)
    {
        if (fileResult.ImportResult is null || _generatedExportProfile is null)
        {
            return 0;
        }

        var rule = _generatedExportProfile.SheetRules.FirstOrDefault(
            r => r.SheetName == sheet.Name && r.PivotSource is PivotSource.Equipement or PivotSource.Isolement);

        if (rule is { PivotSource: PivotSource.Equipement })
        {
            return fileResult.ImportResult.Equipement is null ? 0 : 1;
        }

        if (rule is { PivotSource: PivotSource.Isolement })
        {
            return fileResult.ImportResult.Isolements.Count;
        }

        return fileResult.ImportResult.TachesMultiples.Count(
            tache => tache.Ordre.HasValue && ExcelSheetNameSanitizer.Sanitize(tache.TypeTacheMultipleCode) == sheet.Name);
    }

    protected override async Task OnInitializedAsync()
    {
        _importProfiles = (await ImportProfileStore.GetAllAsync()).ToList();
        _exportProfiles = (await ExportProfileStore.GetAllAsync()).ToList();
    }

    private async Task OnInputFileChangeAsync(InputFileChangeEventArgs e)
    {
        if (_state == State.Processing)
        {
            return;
        }

        _batchResults = null;
        _generationErrorMessage = null;
        _generatedExportProfile = null;

        if (_selectedImportProfileId is not { } importProfileId)
        {
            _state = State.Error;
            _importErrorMessage = Loc["ExportProfileTest_SelectImportProfilePrompt"];
            return;
        }

        var countFailure = BatchFileValidator.ValidateCount(e.FileCount);
        if (countFailure is not null)
        {
            _state = State.Error;
            _importErrorMessage = Loc["ExportProfileTest_BatchTooManyFilesError", countFailure.SelectedFileCount, BatchUploadLimits.MaxFilesPerBatch];
            return;
        }

        var files = e.GetMultipleFiles(BatchUploadLimits.MaxFilesPerBatch);

        var sizeFailure = BatchFileValidator.ValidateSizes(files);
        if (sizeFailure is not null)
        {
            _state = State.Error;
            _importErrorMessage = sizeFailure.Reason == BatchValidationFailureReason.FileTooLarge
                ? Loc["ExportProfileTest_BatchFileTooLargeError",
                    string.Join(", ", sizeFailure.OversizedFiles.Select(f => $"{f.Name} ({BatchFileValidator.FormatMegabytes(f.Size)} MB)")),
                    BatchFileValidator.FormatMegabytes(BatchUploadLimits.MaxFileSizeBytes)]
                : Loc["ExportProfileTest_BatchTotalSizeTooLargeError",
                    BatchFileValidator.FormatMegabytes(sizeFailure.TotalSizeBytes),
                    BatchFileValidator.FormatMegabytes(BatchUploadLimits.MaxTotalBatchSizeBytes)];
            return;
        }

        var importProfile = _importProfiles!.First(p => p.Id == importProfileId);

        _state = State.Processing;
        _importErrorMessage = null;
        StateHasChanged();

        // Lot 033: sequential by decision -- see ImportProfileTest.razor's identical comment.
        var results = new List<ExportBatchFileResult>();
        foreach (var file in files)
        {
            var processed = await BatchImportProcessing.ProcessAsync(file, importProfile, ImportPipelineOrchestrator, BusinessExceptionLocalizer);
            results.Add(ExportBatchFileResult.From(processed));
        }

        _batchResults = results;
        _collapsedFileSections.Clear();
        if (results.Count > 1)
        {
            _collapsedFileSections.UnionWith(Enumerable.Range(0, results.Count));
        }

        _state = State.Success;
    }

    // Lot 033: one Export profile applies to the whole batch -- generates every non-rejected,
    // non-technical-error file in the batch, each into its own download link/sheet preview. A
    // per-file exception here (rare) is isolated the same way as the import step: it's recorded on
    // that file's own GenerationErrorMessage, the rest of the batch is unaffected.
    private void GenerateWorkbooksForBatch()
    {
        if (_batchResults is null)
        {
            return;
        }

        if (_selectedExportProfileId is not { } exportProfileId)
        {
            _generationErrorMessage = Loc["ExportProfileTest_SelectExportProfilePrompt"];
            return;
        }

        _generationErrorMessage = null;
        var exportProfile = _exportProfiles!.First(p => p.Id == exportProfileId);
        _generatedExportProfile = exportProfile;

        foreach (var fileResult in _batchResults)
        {
            if (fileResult.Status is BatchFileStatus.Rejected or BatchFileStatus.TechnicalError)
            {
                continue;
            }

            try
            {
                var generatedWorkbook = SheetGenerationEngine.Generate(fileResult.ImportResult!, exportProfile);

                using var stream = new MemoryStream();
                WorkbookWriter.Write(generatedWorkbook, stream);

                fileResult.GeneratedWorkbook = generatedWorkbook;
                fileResult.DownloadFileName = $"{Path.GetFileNameWithoutExtension(fileResult.FileName)}_export.xlsx";
                fileResult.DownloadDataUrl =
                    $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{Convert.ToBase64String(stream.ToArray())}";
                fileResult.GenerationErrorMessage = null;
            }
            catch (Exception ex)
            {
                fileResult.GeneratedWorkbook = null;
                fileResult.DownloadDataUrl = null;
                fileResult.GenerationErrorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
            }
        }
    }
}
