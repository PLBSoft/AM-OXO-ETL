@page "/export-profiles/test"
@attribute [Authorize(Roles = IdentitySeeder.AdminRoleName)]

@using ExcelETL.Application.Exceptions
@using ExcelETL.Application.Extraction.Oxo
@using ExcelETL.Application.Generation
@using ExcelETL.BlazorAdmin.Excel
@using ExcelETL.Domain.Extraction.Pivot
@using ExcelETL.Domain.Extraction.Profile
@using ExcelETL.Domain.Generation.Profile
@using ExcelETL.Infrastructure.Excel
@using ExcelETL.Infrastructure.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject IImportProfileStore ImportProfileStore
@inject IImportPipelineOrchestrator ImportPipelineOrchestrator
@inject IExportProfileStore ExportProfileStore
@inject ISheetGenerationEngine SheetGenerationEngine
@inject IWorkbookWriter WorkbookWriter
@inject BusinessExceptionLocalizer BusinessExceptionLocalizer
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject NavigationManager NavigationManager

<PageTitle>@Loc["ExportProfileTest_PageTitle"]</PageTitle>

<!-- V8: same page-to-page navigation banner as ImportProfileTest.razor -- see its comment. -->
<div class="page-banner">
    <button id="back-to-export-profiles-button" type="button" class="btn btn-link page-banner-back-link"
            aria-label="@Loc["ExportProfileTest_BackToListButton"]" title="@Loc["ExportProfileTest_BackToListButton"]"
            @onclick="BackToList">
        @((MarkupString)ArrowLeftIconMarkup)
        <span class="d-none d-md-inline">@Loc["ExportProfileTest_BackToListButton"]</span>
    </button>
</div>

<h1>@Loc["ExportProfileTest_PageTitle"]</h1>

<p>@Loc["ExportProfileTest_Instructions"]</p>

@if (_importProfiles is null || _exportProfiles is null)
{
    <p>@Loc["ExportProfileTest_Loading"]</p>
}
else
{
    var processing = _state == State.Processing;

    <div class="mb-3">
        <label class="form-label" for="export-test-import-profile-select">@Loc["ExportProfileTest_ImportProfileLabel"]</label>
        <select id="export-test-import-profile-select" class="form-select" @bind="_selectedImportProfileId" disabled="@processing">
            <option value="">@Loc["ExportProfileTest_ImportProfilePlaceholder"]</option>
            @foreach (var profile in _importProfiles)
            {
                <option value="@profile.Id">@profile.Name</option>
            }
        </select>
        @if (_importProfiles.Count == 0)
        {
            <div class="form-text">@Loc["ExportProfileTest_NoImportProfilesAvailable"]</div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label" for="export-test-file-input">@Loc["ExportProfileTest_FileLabel"]</label>
        <!-- V10: same Bootstrap-native upload styling as ImportProfileTest.razor -- see its comment. -->
        <div class="input-group">
            <span class="input-group-text">@((MarkupString)FileUploadIconMarkup)</span>
            <InputFile id="export-test-file-input" class="form-control form-control-lg" accept=".xlsx" OnChange="OnInputFileChangeAsync" disabled="@processing" />
        </div>
    </div>

    @if (_state == State.Processing)
    {
        <div id="export-test-status" class="alert alert-info d-flex align-items-center gap-2">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>@Loc["ExportProfileTest_Processing"]</span>
        </div>
    }
    else if (_state == State.Error)
    {
        <div id="export-test-status" class="alert alert-danger">@_importErrorMessage</div>
    }
    else if (_importResult is not null)
    {
        if (_importResult.Equipement is null)
        {
            <div id="export-test-status" class="alert alert-danger">
                <h4>@Loc["ExportProfileTest_RejectedFileHeading"]</h4>
                <ul>
                    @foreach (var error in _importResult.Errors)
                    {
                        <li>@error.Sheet / @error.BlockIdentifier: @error.Message</li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label" for="export-test-export-profile-select">@Loc["ExportProfileTest_ExportProfileLabel"]</label>
                <select id="export-test-export-profile-select" class="form-select" @bind="_selectedExportProfileId">
                    <option value="">@Loc["ExportProfileTest_ExportProfilePlaceholder"]</option>
                    @foreach (var profile in _exportProfiles)
                    {
                        <option value="@profile.Id">@profile.Name</option>
                    }
                </select>
                @if (_exportProfiles.Count == 0)
                {
                    <div class="form-text">@Loc["ExportProfileTest_NoExportProfilesAvailable"]</div>
                }
            </div>

            <button id="generate-workbook-button" class="btn btn-primary mb-3" @onclick="GenerateWorkbook">
                @Loc["ExportProfileTest_GenerateButton"]
            </button>

            @if (!string.IsNullOrEmpty(_generationErrorMessage))
            {
                <div class="alert alert-danger">@_generationErrorMessage</div>
            }

            @if (_generatedWorkbook is not null)
            {
                <div class="alert alert-success">
                    <a id="download-generated-workbook-link" class="btn btn-secondary mb-3"
                       href="@_downloadDataUrl" download="@_downloadFileName">
                        @Loc["ExportProfileTest_DownloadLinkText"]
                    </a>

                    @foreach (var sheet in _generatedWorkbook.Sheets)
                    {
                        <details class="test-table-details" open="@(!_collapsedSections.Contains(sheet.Name))">
                            <summary id="generated-sheet-@(sheet.Name)-details-toggle" @onclick="() => ToggleSection(sheet.Name)" @onclick:preventDefault="true">
                                @Loc["ExportProfileTest_SheetNameWithCount", sheet.Name, GetGeneratedSheetItemCount(sheet)]
                            </summary>
                            @if (!_collapsedSections.Contains(sheet.Name))
                            {
                                <div class="generated-sheet-scroll">
                                    <table id="generated-sheet-@(sheet.Name)-table" class="table table-sm table-striped generated-sheet-table">
                                        <thead>
                                            <tr>
                                                @foreach (var header in sheet.Headers)
                                                {
                                                    <th>@header</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in sheet.Rows)
                                            {
                                                <tr>
                                                    @foreach (var cell in row.Cells)
                                                    {
                                                        <td>@cell</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </details>
                    }
                </div>
            }
        }
    }
}

@code {
    // Matches ImportProfileTest.razor's own cap (Web API's UploadLimits.MaxExcelFileSizeBytes).
    private const long MaxFileSizeBytes = 10 * 1024 * 1024;

    private enum State { Idle, Processing, Success, Error }

    // V10: same icon shape as ImportProfileTest.razor -- see its comment.
    private const string FileUploadIconMarkup =
        """<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5zm0 1v2A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z" /><path d="M8.5 11.5a.5.5 0 0 1-1 0V8.707L6.354 9.854a.5.5 0 1 1-.708-.708l2-2a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5 8.707z" /></svg>""";

    // V8: same icon shape/rationale as ImportProfileTest.razor -- see its comment.
    private const string ArrowLeftIconMarkup =
        """<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" /></svg>""";

    private void BackToList() => NavigationManager.NavigateTo("export-profiles");

    private List<ImportProfile>? _importProfiles;
    private List<ExportProfile>? _exportProfiles;
    private Guid? _selectedImportProfileId;
    private Guid? _selectedExportProfileId;
    private State _state = State.Idle;
    private string? _importErrorMessage;
    private ImportResult? _importResult;
    private string? _generationErrorMessage;
    private GeneratedWorkbook? _generatedWorkbook;
    private ExportProfile? _generatedExportProfile;
    private string? _downloadDataUrl;
    private string? _downloadFileName;
    private readonly HashSet<string> _collapsedSections = [];

    private void ToggleSection(string section)
    {
        if (!_collapsedSections.Add(section))
        {
            _collapsedSections.Remove(section);
        }
    }

    // A sheet's item count depends on which pivot fed it, which GeneratedSheet itself doesn't carry
    // (it's just headers/rows) -- resolved via the ExportProfile rule that produced it instead.
    // Equipement/Isolement rules always produce exactly one physically-named sheet (SheetName as-is);
    // anything left over is, by elimination, a PivotSource.TacheMultiple dynamic sheet, matched back to
    // its TypeTacheMultipleCode group via the same sanitizer the engine used to name it (Lot T3/T4).
    private int GetGeneratedSheetItemCount(GeneratedSheet sheet)
    {
        if (_importResult is null || _generatedExportProfile is null)
        {
            return 0;
        }

        var rule = _generatedExportProfile.SheetRules.FirstOrDefault(
            r => r.SheetName == sheet.Name && r.PivotSource is PivotSource.Equipement or PivotSource.Isolement);

        if (rule is { PivotSource: PivotSource.Equipement })
        {
            return _importResult.Equipement is null ? 0 : 1;
        }

        if (rule is { PivotSource: PivotSource.Isolement })
        {
            return _importResult.Isolements.Count;
        }

        // TacheMultiple: exclude "ligne de mise en page" rows (EstFactice, blank Ordre) from the count.
        return _importResult.TachesMultiples.Count(
            tache => tache.Ordre.HasValue && ExcelSheetNameSanitizer.Sanitize(tache.TypeTacheMultipleCode) == sheet.Name);
    }

    protected override async Task OnInitializedAsync()
    {
        _importProfiles = (await ImportProfileStore.GetAllAsync()).ToList();
        _exportProfiles = (await ExportProfileStore.GetAllAsync()).ToList();
    }

    private async Task OnInputFileChangeAsync(InputFileChangeEventArgs e)
    {
        if (_state == State.Processing)
        {
            return;
        }

        _importResult = null;
        _generatedWorkbook = null;
        _generatedExportProfile = null;
        _generationErrorMessage = null;
        _downloadDataUrl = null;

        if (_selectedImportProfileId is not { } importProfileId)
        {
            _state = State.Error;
            _importErrorMessage = Loc["ExportProfileTest_SelectImportProfilePrompt"];
            return;
        }

        var importProfile = _importProfiles!.First(p => p.Id == importProfileId);

        _state = State.Processing;
        _importErrorMessage = null;
        StateHasChanged();

        Stream? fileStream = null;

        try
        {
            fileStream = e.File.OpenReadStream(MaxFileSizeBytes);
            await using var buffered = await BrowserFileStreamBuffering.BufferToSeekableStreamAsync(fileStream);
            using var workbookReader = new ClosedXmlWorkbookReader(buffered);
            _importResult = ImportPipelineOrchestrator.Run(workbookReader, importProfile);
            _state = State.Success;
        }
        catch (Exception ex)
        {
            _state = State.Error;
            _importErrorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
        finally
        {
            if (fileStream is not null)
            {
                await fileStream.DisposeAsync();
            }
        }
    }

    private void GenerateWorkbook()
    {
        _generationErrorMessage = null;
        _generatedWorkbook = null;
        _generatedExportProfile = null;
        _downloadDataUrl = null;

        if (_importResult?.Equipement is null)
        {
            return;
        }

        if (_selectedExportProfileId is not { } exportProfileId)
        {
            _generationErrorMessage = Loc["ExportProfileTest_SelectExportProfilePrompt"];
            return;
        }

        var exportProfile = _exportProfiles!.First(p => p.Id == exportProfileId);

        try
        {
            _generatedWorkbook = SheetGenerationEngine.Generate(_importResult, exportProfile);
            _generatedExportProfile = exportProfile;

            using var stream = new MemoryStream();
            WorkbookWriter.Write(_generatedWorkbook, stream);
            _downloadFileName = TargetWorkbookFileNameBuilder.Build(_importResult.Equipement.Repere, DateTime.UtcNow);
            _downloadDataUrl =
                $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{Convert.ToBase64String(stream.ToArray())}";
        }
        catch (Exception ex)
        {
            _generatedWorkbook = null;
            _generatedExportProfile = null;
            _generationErrorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }
}
