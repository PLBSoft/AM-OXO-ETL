@page "/export-profiles/new"
@page "/export-profiles/{Id:guid}/edit"
@attribute [Authorize]

@using ExcelETL.Application.Exceptions
@using ExcelETL.Application.Generation
@using ExcelETL.BlazorAdmin.Editing
@using ExcelETL.BlazorAdmin.Editing.Export
@using ExcelETL.BlazorAdmin.Shared
@using ExcelETL.Domain.Exceptions
@using ExcelETL.Domain.Generation.Profile
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Routing

@inject IExportProfileStore ExportProfileStore
@inject BusinessExceptionLocalizer BusinessExceptionLocalizer
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject NavigationManager NavigationManager

@* Lot 074 (P3 draft pilot, docs/tickets/tickets-tdd-lot-074-pilote-brouillon-editeur-profil-export.md):
   this page owns the single ExportProfileDraft (_draft) for the whole editing session. Every field's
   value lives directly on the draft tree the instant it's typed -- there is no per-form local state
   left to "flush" before a save, which is what removes defect A (a typed-but-never-explicitly-
   submitted row silently lost) by construction. ExportProfileDraftMapper.ToDomain/ConvertSheetRule
   are called directly here (and by SheetGenerationRuleForm for its own nested items) -- no @ref is
   needed anywhere in this editor any more. *@

<PageTitle>@(_editingId.HasValue ? Loc["ExportProfileEditor_EditPageTitle"] : Loc["ExportProfileEditor_PageTitle"])</PageTitle>

<!-- Lot 043 (43.2): mirror of ImportProfileEditor.razor's own NavigationLock (43.1) -- same
     mechanism, same IDs, per the ticket's explicit parity requirement. -->
<NavigationLock ConfirmExternalNavigation="_hasUnsavedChanges" OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" />

<!-- Lot 053 (53.1): profile-editor-container caps this route at 1140px on wide screens (see
     app.css) -- shared verbatim with ImportProfileEditor.razor's own root container. -->
<!-- Lot 056 (56.5): mirror of ImportProfileEditor.razor's own Ctrl+Enter shortcut. -->
<div class="container-fluid px-3 profile-editor-container" @onkeydown="OnRootKeyDownAsync">

<h1>@(_editingId.HasValue ? Loc["ExportProfileEditor_EditPageTitle"] : Loc["ExportProfileEditor_PageTitle"])</h1>

<!-- X11 (Lot X): back link now lives in the shared top-row banner via SectionContent -- see
     PageBackNavLink.razor. Replaces the previous in-content btn-secondary button. -->
<PageBackNavLink Id="back-to-export-profiles-button" Label="@Loc["ExportProfileEditor_BackToListButton"]" OnClick="BackToList" />

@if (_showNavigationConfirmation)
{
    <div id="unsaved-changes-navigation-confirmation" class="alert alert-warning right-aligned-actions" role="alert">
        <span class="text-danger me-auto">@Loc["ExportProfileEditor_UnsavedChangesConfirmMessage"]</span>
        <button id="discard-changes-and-leave-button" class="btn btn-sm btn-danger" @onclick="DiscardChangesAndLeave">
            @Loc["ExportProfileEditor_DiscardChangesAndLeaveButton"]
        </button>
        <button id="stay-on-page-button" class="btn btn-sm btn-secondary" @onclick="StayOnPage">
            @Loc["ExportProfileEditor_StayOnPageButton"]
        </button>
    </div>
}

@if (_notFound)
{
    <div id="export-profile-not-found" class="alert alert-danger" role="alert">@Loc["ExportProfileEditor_ProfileNotFound"]</div>
}
else
{
    @if (!string.IsNullOrEmpty(_profileErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@_profileErrorMessage</div>
    }

    <div class="mb-3">
        <div class="form-floating">
            <input id="export-profile-name-input" class="form-control" @bind="_draft.Name" @bind:after="MarkAsChanged" maxlength="@ExportProfile.MaxNameLength"
                   placeholder="@Loc["ExportProfileEditor_NamePlaceholder"]" />
            <label for="export-profile-name-input">@Loc["ExportProfileEditor_NameLabel"]</label>
        </div>
    </div>

    <h2 class="h3">@Loc["ExportProfileEditor_SheetRulesHeading"]</h2>

    @if (_draft.SheetRules.Count == 0)
    {
        <p>@Loc["ExportProfileEditor_NoSheetRulesYet"]</p>
    }
    else
    {
        <ul class="sheet-rule-list sheet-rule-grid">
            @for (var i = 0; i < _draft.SheetRules.Count; i++)
            {
                var index = i;
                var rule = _draft.SheetRules[index];
                <li class="@(_openSheetRuleForm.EditIndex == index ? "sheet-rule-editing-item" : "sheet-rule-card")">
                    @if (_openSheetRuleForm.EditIndex == index)
                    {
                        <SheetGenerationRuleForm IdPrefix="@($"edit-{index}-")"
                                                  Draft="rule"
                                                  SubmitButtonId="@($"save-sheet-generation-rule-button-{index}")"
                                                  SubmitLabel="@Loc["ExportProfileEditor_ApplySheetRuleButton"]"
                                                  ShowCancel="true"
                                                  CancelButtonId="@($"cancel-sheet-generation-rule-button-{index}")"
                                                  OnCancel="() => CancelSheetRuleEdit(index)"
                                                  OnDirty="MarkAsChanged"
                                                  OnSubmit="() => HandleSheetRuleSubmit(index)" />
                    }
                    else
                    {
                        <div class="sheet-rule-card-header">
                            <h3 class="sheet-rule-card-title h4">@rule.SheetName</h3>
                            <span class="sheet-rule-card-meta text-muted">@Loc["ExportProfileEditor_SheetMetadata", rule.PivotSource]</span>
                        </div>
                        <details class="sheet-rule-sublist-details" open="@_expandedSheetRuleDetails.Contains(index)">
                            <summary id="@($"sheet-rule-details-toggle-{index}")"
                                     @onclick="() => ToggleSheetRuleDetails(index)" @onclick:preventDefault="true">
                                @Loc["ExportProfileEditor_SheetRuleDetailsSummary", rule.Columns.Count, rule.PointColumns.Count]
                            </summary>
                            @if (_expandedSheetRuleDetails.Contains(index))
                            {
                                <div id="@($"sheet-rule-details-content-{index}")">
                                    @if (rule.Columns.Count > 0 || rule.PointColumns.Count > 0)
                                    {
                                        <ul class="block-field-list block-field-grid">
                                            @foreach (var column in rule.Columns)
                                            {
                                                <li class="block-field-item">
                                                    <div class="block-field-info">
                                                        <span class="block-field-name">@column.Header</span>
                                                        <span class="block-field-range text-muted font-monospace">@(string.IsNullOrEmpty(column.SourceValue) ? Loc["ExportProfileEditor_SourceNotMapped"] : column.SourceValue)</span>
                                                    </div>
                                                </li>
                                            }
                                            @foreach (var pointColumn in rule.PointColumns)
                                            {
                                                <li class="block-field-item">
                                                    <div class="block-field-info">
                                                        <span class="block-field-name">@pointColumn.Header</span>
                                                        <span class="block-field-range text-muted font-monospace">@pointColumn.ColonneNom · @pointColumn.MarkValue</span>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p>@Loc["ExportProfileEditor_NoSheetRuleSublistItems"]</p>
                                    }
                                </div>
                            }
                        </details>
                        @if (_pendingDeleteIndex == index)
                        {
                            <div class="right-aligned-actions">
                                <span class="text-danger me-auto">@Loc["ExportProfileEditor_ConfirmDeleteSheetRuleMessage"]</span>
                                <button id="@($"confirm-delete-sheet-generation-rule-button-{index}")" class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteSheetRule(index)">
                                    @Loc["ExportProfileEditor_ConfirmDeleteButton"]
                                </button>
                                <button id="@($"cancel-delete-sheet-generation-rule-button-{index}")" class="btn btn-sm btn-secondary" @onclick="() => _pendingDeleteIndex = null">
                                    @Loc["ExportProfileEditor_CancelButton"]
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="right-aligned-actions">
                                <button id="@($"modify-sheet-generation-rule-button-{index}")" type="button"
                                        class="btn btn-sm btn-outline-secondary block-field-icon-btn"
                                        aria-label="@Loc["ExportProfileEditor_ModifyButton"]" title="@Loc["ExportProfileEditor_ModifyButton"]"
                                        @onclick="() => RequestOpenEditAsync(index)">
                                    @((MarkupString)AdminIconMarkup.Pencil)
                                </button>
                                <button id="@($"delete-sheet-generation-rule-button-{index}")" type="button"
                                        class="btn btn-sm btn-outline-danger block-field-icon-btn"
                                        aria-label="@Loc["ExportProfileEditor_DeleteButton"]" title="@Loc["ExportProfileEditor_DeleteButton"]"
                                        @onclick="() => RequestDeleteSheetRuleAsync(index)">
                                    @((MarkupString)AdminIconMarkup.Trash)
                                </button>
                            </div>
                        }
                    }
                </li>
            }
        </ul>
    }

    <!-- Lot 057 (57.1): mirror of ImportProfileEditor.razor's own repliable add-sheet-rule card. -->
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@Loc["ExportProfileEditor_AddSheetHeading"]</span>
            <button id="toggle-add-sheet-generation-rule-form-button" type="button" class="btn btn-secondary w-100 d-flex align-items-center justify-content-center gap-1"
                    @onclick="ToggleAddSheetRuleFormAsync">
                @if (_openSheetRuleForm.IsAdd)
                {
                    @Loc["ExportProfileEditor_AddSheetToggleCloseButton"]
                }
                else
                {
                    @((MarkupString)AdminIconMarkup.Plus) @Loc["ExportProfileEditor_AddSheetButton"]
                }
            </button>
        </div>
        <div class="card-body">
            @if (_openSheetRuleForm.IsAdd)
            {
                <SheetGenerationRuleForm Draft="_draft.PendingSheetRule" SubmitLabel="@Loc["ExportProfileEditor_AddSheetButton"]" OnDirty="MarkAsChanged" OnSubmit="() => HandleSheetRuleSubmit(null)" />
            }
        </div>
    </div>

    <!-- Lot 056 (56.6): mirror of ImportProfileEditor.razor's own sticky save bar. -->
    <div class="profile-editor-save-bar">
        @if (_hasUnsavedChanges)
        {
            <span id="unsaved-changes-indicator" class="text-warning">@Loc["ExportProfileEditor_UnsavedChangesIndicator"]</span>
        }
        <div class="right-aligned-actions">
            <button id="save-export-profile-button" class="btn btn-primary w-100 w-md-auto btn-lg mt-4 mb-4 d-flex align-items-center justify-content-center gap-1"
                    disabled="@(!_hasUnsavedChanges)"
                    title="@(_hasUnsavedChanges ? Loc["ExportProfileEditor_SaveButtonShortcutHint"] : Loc["ExportProfileEditor_SaveButtonNoChangesHint"])"
                    @onclick="SaveProfileAsync">
                @((MarkupString)AdminIconMarkup.Check) @Loc["ExportProfileEditor_SaveButton"]
            </button>
        </div>
    </div>
}

</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private ExportProfileDraft _draft = new();
    private Guid? _editingId;
    private bool _notFound;
    private string? _profileErrorMessage;

    private int? _pendingDeleteIndex;
    private readonly HashSet<int> _expandedSheetRuleDetails = [];

    // Taken at "Modify" click time (DraftJson.Clone), restored into the list on Cancel -- see
    // SheetGenerationRuleForm.razor's own identical mechanism for its nested items.
    private SheetGenerationRuleDraft? _sheetRuleEditSnapshot;

    // Lot 057 (57.2): mirror of ImportProfileEditor.razor's own single open-form state.
    private readonly record struct SheetRuleFormOpenState(bool IsAdd, int? EditIndex)
    {
        public static readonly SheetRuleFormOpenState None = new(false, null);

        public static SheetRuleFormOpenState Add => new(true, null);

        public static SheetRuleFormOpenState Edit(int index) => new(false, index);
    }

    private SheetRuleFormOpenState _openSheetRuleForm = SheetRuleFormOpenState.Add;

    // Lot 043 (43.2): mirror of ImportProfileEditor.razor's own state/logic (43.1).
    private bool _hasUnsavedChanges;
    private bool _showNavigationConfirmation;
    private string? _pendingNavigationTarget;

    private void MarkAsChanged() => _hasUnsavedChanges = true;

    protected override async Task OnInitializedAsync()
    {
        if (!Id.HasValue)
        {
            return;
        }

        _openSheetRuleForm = SheetRuleFormOpenState.None;

        var profile = await ExportProfileStore.GetByIdAsync(Id.Value);
        if (profile is null)
        {
            _notFound = true;
            return;
        }

        _editingId = profile.Id;
        _draft = ExportProfileDraftMapper.FromDomain(profile);
    }

    private void BackToList() => NavigationManager.NavigateTo("export-profiles");

    private string Localize(Exception exception) => BusinessExceptionLocalizer.TryLocalize(exception) ?? exception.Message;

    private void ApplyErrors(IReadOnlyList<DraftConversionError> errors)
    {
        foreach (var error in errors)
        {
            if (error.Draft is IDraftWithError withError)
            {
                withError.Error = Localize(error.Exception);
            }
        }
    }

    // Lot 057 (57.2): mirror of ImportProfileEditor.razor's own mutual-exclusion helper -- validates
    // whichever sheet-rule form is currently open directly against ExportProfileDraftMapper (no
    // @ref needed, unlike the pre-migration architecture): an Edit-mode rule is validated in place;
    // a still-pristine pending Add rule is a no-op; a non-pristine, valid pending Add rule is
    // promoted into the list exactly as if "Add sheet rule" had been clicked.
    private bool TryValidateAndCloseCurrentForm()
    {
        if (_openSheetRuleForm.EditIndex is int index)
        {
            var result = ExportProfileDraftMapper.ConvertSheetRule(_draft.SheetRules[index]);
            if (!result.IsSuccess)
            {
                ApplyErrors(result.Errors);
                return false;
            }

            _draft.SheetRules[index].Error = null;
            return true;
        }

        if (_openSheetRuleForm.IsAdd)
        {
            if (DraftJson.IsPristine(_draft.PendingSheetRule))
            {
                return true;
            }

            var result = ExportProfileDraftMapper.ConvertSheetRule(_draft.PendingSheetRule);
            if (!result.IsSuccess)
            {
                ApplyErrors(result.Errors);
                return false;
            }

            _draft.SheetRules.Add(_draft.PendingSheetRule);
            _draft.PendingSheetRule = new SheetGenerationRuleDraft();
            return true;
        }

        return true;
    }

    private void RequestOpenEditAsync(int index)
    {
        if (!TryValidateAndCloseCurrentForm())
        {
            return;
        }

        _pendingDeleteIndex = null;
        _sheetRuleEditSnapshot = DraftJson.Clone(_draft.SheetRules[index]);
        _draft.SheetRules[index].Error = null;
        _openSheetRuleForm = SheetRuleFormOpenState.Edit(index);
    }

    private void ToggleAddSheetRuleFormAsync()
    {
        if (_openSheetRuleForm.IsAdd)
        {
            // Closing the add-sheet-rule form via the toggle is this form's only "Cancel"
            // equivalent (ShowCancel is false in add mode) -- discards whatever was typed, exactly
            // like SheetGenerationRuleForm's own per-item Cancel restores rather than keeps a
            // pending edit. Under the pre-migration architecture this discard happened implicitly
            // (the child component was unmounted); the draft now needs it done explicitly, since
            // nothing else would ever clear a merely-closed pending sheet rule.
            _draft.PendingSheetRule = new SheetGenerationRuleDraft();
            _openSheetRuleForm = SheetRuleFormOpenState.None;
            return;
        }

        if (!TryValidateAndCloseCurrentForm())
        {
            return;
        }

        _pendingDeleteIndex = null;
        _openSheetRuleForm = SheetRuleFormOpenState.Add;
    }

    private void RequestDeleteSheetRuleAsync(int index)
    {
        if (!TryValidateAndCloseCurrentForm())
        {
            return;
        }

        _pendingDeleteIndex = index;
    }

    // This form's own top-level Submit button already validated the rule via
    // ExportProfileDraftMapper.ConvertSheetRule (see SheetGenerationRuleForm.Submit) before raising
    // OnSubmit -- this handler only performs the list mutation the successful validation implies.
    private void HandleSheetRuleSubmit(int? index)
    {
        if (index.HasValue)
        {
            _openSheetRuleForm = SheetRuleFormOpenState.None;
            _sheetRuleEditSnapshot = null;
        }
        else
        {
            _draft.SheetRules.Add(_draft.PendingSheetRule);
            _draft.PendingSheetRule = new SheetGenerationRuleDraft();
            _openSheetRuleForm = SheetRuleFormOpenState.None;
        }

        MarkAsChanged();
    }

    private void CancelSheetRuleEdit(int index)
    {
        if (_sheetRuleEditSnapshot is not null)
        {
            _draft.SheetRules[index] = _sheetRuleEditSnapshot;
        }

        _sheetRuleEditSnapshot = null;
        _openSheetRuleForm = SheetRuleFormOpenState.None;
    }

    private void ConfirmDeleteSheetRule(int index)
    {
        DeleteSheetRule(index);
        _pendingDeleteIndex = null;
    }

    private void DeleteSheetRule(int index)
    {
        _draft.SheetRules.RemoveAt(index);
        if (_openSheetRuleForm.EditIndex == index)
        {
            _openSheetRuleForm = SheetRuleFormOpenState.None;
        }
        MarkAsChanged();
    }

    private void ToggleSheetRuleDetails(int index)
    {
        if (!_expandedSheetRuleDetails.Add(index))
        {
            _expandedSheetRuleDetails.Remove(index);
        }
    }

    // Lot 056 (56.5): mirror of ImportProfileEditor.razor's own Ctrl+Enter handler.
    private async Task OnRootKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args is { Key: "Enter", CtrlKey: true } && _hasUnsavedChanges)
        {
            await SaveProfileAsync();
        }
    }

    private async Task SaveProfileAsync()
    {
        _profileErrorMessage = null;

        // Lot 074 (074.3): the whole draft tree is walked here regardless of which sub-form
        // happens to be visually open or closed -- there is no "flush the open form" step left,
        // since every field already lives in _draft the instant it's typed. This is what fixes L4
        // (a pending row filled but never explicitly "Add"-ed) without any special-casing.
        var result = ExportProfileDraftMapper.ToDomain(_draft);
        if (!result.IsSuccess)
        {
            ApplyErrors(result.Errors);

            // A failure attached directly to the root draft (Name empty/too long, no sheet rules)
            // shows its own real message, exactly as before this lot -- one only ever attached to a
            // nested item (a pending row the user never explicitly submitted) shows the generic
            // banner instead, since the specific message is already displayed inline on that item.
            var rootLevelError = result.Errors.FirstOrDefault(e => ReferenceEquals(e.Draft, _draft));
            _profileErrorMessage = rootLevelError is not null
                ? Localize(rootLevelError.Exception)
                : Loc["ExportProfileEditor_PendingRowInvalidError"];
            return;
        }

        try
        {
            await ExportProfileStore.SaveAsync(result.Value!);
            _hasUnsavedChanges = false;
            NavigationManager.NavigateTo("export-profiles");
        }
        catch (DomainValidationException ex)
        {
            _profileErrorMessage = Localize(ex);
        }
        catch (ProfileNameAlreadyExistsException ex)
        {
            _profileErrorMessage = Localize(ex);
        }
    }

    private Task OnBeforeInternalNavigationAsync(LocationChangingContext context)
    {
        if (_hasUnsavedChanges)
        {
            context.PreventNavigation();
            _pendingNavigationTarget = context.TargetLocation;
            _showNavigationConfirmation = true;
        }

        return Task.CompletedTask;
    }

    private void DiscardChangesAndLeave()
    {
        _hasUnsavedChanges = false;
        _showNavigationConfirmation = false;
        var target = _pendingNavigationTarget;
        _pendingNavigationTarget = null;
        if (target is not null)
        {
            NavigationManager.NavigateTo(target);
        }
    }

    private void StayOnPage()
    {
        _showNavigationConfirmation = false;
        _pendingNavigationTarget = null;
    }
}
