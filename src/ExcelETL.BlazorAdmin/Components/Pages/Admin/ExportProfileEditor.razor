@page "/export-profiles/new"
@page "/export-profiles/{Id:guid}/edit"
@attribute [Authorize(Roles = IdentitySeeder.AdminRoleName)]

@using ExcelETL.Application.Exceptions
@using ExcelETL.Application.Generation
@using ExcelETL.Domain.Exceptions
@using ExcelETL.Domain.Generation.Profile
@using ExcelETL.Infrastructure.Identity
@using Microsoft.AspNetCore.Authorization

@inject IExportProfileStore ExportProfileStore
@inject BusinessExceptionLocalizer BusinessExceptionLocalizer
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject NavigationManager NavigationManager

<PageTitle>@(_editingId.HasValue ? Loc["ExportProfileEditor_EditPageTitle"] : Loc["ExportProfileEditor_PageTitle"])</PageTitle>

<h1>@(_editingId.HasValue ? Loc["ExportProfileEditor_EditPageTitle"] : Loc["ExportProfileEditor_PageTitle"])</h1>

<button id="back-to-export-profiles-button" class="btn btn-secondary mb-3" @onclick="BackToList">
    @Loc["ExportProfileEditor_BackToListButton"]
</button>

@if (_notFound)
{
    <div id="export-profile-not-found" class="alert alert-danger">@Loc["ExportProfileEditor_ProfileNotFound"]</div>
}
else
{
    @if (!string.IsNullOrEmpty(_profileErrorMessage))
    {
        <div class="alert alert-danger">@_profileErrorMessage</div>
    }

    <div class="row g-2 mb-3">
        <div class="col">
            <label class="form-label" for="export-profile-name-input">@Loc["ExportProfileEditor_NameLabel"]</label>
            <input id="export-profile-name-input" class="form-control" @bind="_name"
                   placeholder="@Loc["ExportProfileEditor_NamePlaceholder"]" />
        </div>
    </div>

    <h3>@Loc["ExportProfileEditor_SheetRulesHeading"]</h3>

    @if (_sheetRules.Count == 0)
    {
        <p>@Loc["ExportProfileEditor_NoSheetRulesYet"]</p>
    }
    else
    {
        <ul class="sheet-rule-list">
            @for (var i = 0; i < _sheetRules.Count; i++)
            {
                var index = i;
                var rule = _sheetRules[index];
                <li class="@(_editingIndex == index ? "sheet-rule-editing-item" : "sheet-rule-card")">
                    @if (_editingIndex == index)
                    {
                        <SheetGenerationRuleForm IdPrefix="@($"edit-{index}-")"
                                                  InitialRule="rule"
                                                  SubmitButtonId="@($"save-sheet-generation-rule-button-{index}")"
                                                  SubmitLabel="@Loc["ExportProfileEditor_SaveChangesButton"]"
                                                  ShowCancel="true"
                                                  CancelButtonId="@($"cancel-sheet-generation-rule-button-{index}")"
                                                  OnCancel="() => _editingIndex = null"
                                                  OnSubmit="(SheetGenerationRule updated) => HandleSaveSheetRule(index, updated)" />
                    }
                    else
                    {
                        <div class="sheet-rule-card-header">
                            <h4 class="sheet-rule-card-title">@rule.SheetName</h4>
                            <span class="sheet-rule-card-meta text-muted">@Loc["ExportProfileEditor_SheetMetadata", rule.PivotSource]</span>
                        </div>
                        <ul class="block-field-list">
                            @foreach (var column in rule.ColumnDefinitions)
                            {
                                <li class="block-field-item">
                                    <div class="block-field-info">
                                        <span class="block-field-name">@column.Header</span>
                                        <span class="block-field-range text-muted font-monospace">@(column.Source is null ? Loc["ExportProfileEditor_SourceNotMapped"] : column.Source.Value.ToString())</span>
                                    </div>
                                </li>
                            }
                            @foreach (var pointColumn in rule.PointColumnDefinitions)
                            {
                                <li class="block-field-item">
                                    <div class="block-field-info">
                                        <span class="block-field-name">@pointColumn.Header</span>
                                        <span class="block-field-range text-muted font-monospace">@pointColumn.ColonneNom · @pointColumn.MarkValue</span>
                                    </div>
                                </li>
                            }
                        </ul>
                        @if (_pendingDeleteIndex == index)
                        {
                            <div class="right-aligned-actions mt-2">
                                <span class="text-danger me-auto">@Loc["ExportProfileEditor_ConfirmDeleteSheetRuleMessage"]</span>
                                <button id="@($"confirm-delete-sheet-generation-rule-button-{index}")" class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteSheetRule(index)">
                                    @Loc["ExportProfileEditor_ConfirmDeleteButton"]
                                </button>
                                <button id="@($"cancel-delete-sheet-generation-rule-button-{index}")" class="btn btn-sm btn-secondary" @onclick="() => _pendingDeleteIndex = null">
                                    @Loc["ExportProfileEditor_CancelButton"]
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="right-aligned-actions mt-2">
                                <button id="@($"modify-sheet-generation-rule-button-{index}")" class="btn btn-sm btn-secondary" @onclick="() => _editingIndex = index">
                                    @Loc["ExportProfileEditor_ModifyButton"]
                                </button>
                                <button id="@($"delete-sheet-generation-rule-button-{index}")" class="btn btn-sm btn-danger" @onclick="() => _pendingDeleteIndex = index">
                                    @Loc["ExportProfileEditor_DeleteButton"]
                                </button>
                            </div>
                        }
                    }
                </li>
            }
        </ul>
    }

    <div class="card mb-3">
        <div class="card-header">@Loc["ExportProfileEditor_AddSheetHeading"]</div>
        <div class="card-body">
            <SheetGenerationRuleForm SubmitLabel="@Loc["ExportProfileEditor_AddSheetButton"]" OnSubmit="HandleAddSheetRule" />
        </div>
    </div>

    <div class="right-aligned-actions">
        <button id="save-export-profile-button" class="btn btn-primary" @onclick="SaveProfileAsync">
            @Loc["ExportProfileEditor_SaveButton"]
        </button>
    </div>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private string _name = string.Empty;
    private Guid? _editingId;
    private bool _notFound;
    private string? _profileErrorMessage;

    private readonly List<SheetGenerationRule> _sheetRules = [];
    private int? _editingIndex;
    private int? _pendingDeleteIndex;

    protected override async Task OnInitializedAsync()
    {
        if (!Id.HasValue)
        {
            return;
        }

        var profile = await ExportProfileStore.GetByIdAsync(Id.Value);
        if (profile is null)
        {
            _notFound = true;
            return;
        }

        _editingId = profile.Id;
        _name = profile.Name;
        _sheetRules.AddRange(profile.SheetRules);
    }

    private void BackToList() => NavigationManager.NavigateTo("export-profiles");

    private void HandleAddSheetRule(SheetGenerationRule rule) => _sheetRules.Add(rule);

    private void HandleSaveSheetRule(int index, SheetGenerationRule updated)
    {
        _sheetRules[index] = updated;
        _editingIndex = null;
    }

    private void ConfirmDeleteSheetRule(int index)
    {
        DeleteSheetRule(index);
        _pendingDeleteIndex = null;
    }

    private void DeleteSheetRule(int index)
    {
        _sheetRules.RemoveAt(index);
        if (_editingIndex == index)
        {
            _editingIndex = null;
        }
    }

    private async Task SaveProfileAsync()
    {
        _profileErrorMessage = null;

        try
        {
            var profile = _editingId.HasValue
                ? new ExportProfile(_editingId.Value, _name, _sheetRules)
                : new ExportProfile(_name, _sheetRules);

            await ExportProfileStore.SaveAsync(profile);
            NavigationManager.NavigateTo("export-profiles");
        }
        catch (DomainValidationException ex)
        {
            _profileErrorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }
}
