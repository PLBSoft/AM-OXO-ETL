@using ExcelETL.BlazorAdmin.Formatting

@inject IStringLocalizer<BlazorAdminMessages> Loc

<!-- Lot 079.1 (docs/tickets/tickets-tdd-lot-079-vue-details-langage-courant-profil-export.md): the sections of a
     plain-language profile description, shared by the import (lot 078) and export (lot 079) Details pages.
     Section 0 is the general section; the others are one per sheet rule. -->

@for (var i = 0; i < Description.Sections.Count; i++)
{
    var section = Description.Sections[i];
    var sectionId = i == 0 ? "details-section-general" : $"details-section-sheet-{i - 1}";
    <section id="@sectionId" class="mb-4">
        <h2 class="h4">@section.Title</h2>

        @if (section.Blocking.Count > 0)
        {
            <div id="@($"{sectionId}-blocking")" class="alert alert-danger">
                <p class="mb-1">@BlockingHeading</p>
                <ul class="mb-0">
                    @foreach (var problem in section.Blocking)
                    {
                        <li>@RenderText(problem)</li>
                    }
                </ul>
            </div>
        }

        @if (section.Sentences.Count > 0)
        {
            <ul class="profile-details-sentences">
                @foreach (var sentence in section.Sentences)
                {
                    <li>
                        @RenderText(sentence.Content)
                        @if (sentence.IsFixed)
                        {
                            <span class="badge text-bg-secondary ms-1">@Loc["ProfileDescription_FixedMarker"]</span>
                        }
                    </li>
                }
            </ul>
        }

        @if (section.Ignored.Count > 0)
        {
            <!-- Static content loaded with the page: no role="alert" (nothing appears dynamically). -->
            <div id="@($"{sectionId}-ignored")" class="alert alert-warning">
                <p class="mb-1">@IgnoredHeading</p>
                <ul class="mb-0">
                    @foreach (var setting in section.Ignored)
                    {
                        <li>@RenderText(setting)</li>
                    }
                </ul>
                @foreach (var note in section.IgnoredNotes)
                {
                    <p class="profile-details-ignored-note mt-2 mb-0">@RenderText(note)</p>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter, EditorRequired]
    public ProfileDescription Description { get; set; } = default!;

    [Parameter, EditorRequired]
    public string BlockingHeading { get; set; } = "";

    [Parameter]
    public string IgnoredHeading { get; set; } = "";

    // Lot 078.12.2/3: profile values in <strong> (the guillemets around them stay plain text), cell
    // coordinates in <code>. Built in C# rather than markup so no whitespace sneaks in around a segment.
    private static RenderFragment RenderText(ProfileDescriptionText text) => builder =>
    {
        foreach (var segment in text.Segments)
        {
            switch (segment.Kind)
            {
                case ProfileDescriptionSegmentKind.Value:
                    builder.OpenElement(0, "strong");
                    builder.AddAttribute(1, "class", "profile-details-value");
                    builder.AddContent(2, segment.Text);
                    builder.CloseElement();
                    break;
                case ProfileDescriptionSegmentKind.CellReference:
                    builder.OpenElement(3, "code");
                    builder.AddAttribute(4, "class", "profile-details-cell");
                    builder.AddContent(5, segment.Text);
                    builder.CloseElement();
                    break;
                default:
                    builder.AddContent(6, segment.Text);
                    break;
            }
        }
    };
}
