@using ExcelETL.BlazorAdmin.Editing.Export
@using ExcelETL.BlazorAdmin.Shared
@using ExcelETL.Domain.Generation.Fields
@using ExcelETL.Domain.Generation.Profile

@inject IStringLocalizer<BlazorAdminMessages> Loc

@* Lot 074 (P3 draft pilot): a pure leaf -- all state lives in Draft, owned by the parent
   (SheetGenerationRuleForm). This component only binds fields and forwards button clicks; the
   parent performs the actual conversion/validation and decides what "valid" means for the slot
   this Draft came from (an already-added item vs. the always-present pending "Add" row). See
   ExportProfileDraftMapper. *@

@if (!string.IsNullOrEmpty(Draft.Error))
{
    <div class="alert alert-danger" role="alert">@Draft.Error</div>
}

<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}header-input")" class="form-control" @bind="Draft.Header" @bind:after="MarkDirty"
               placeholder="@Loc["ExportProfileEditor_HeaderPlaceholder"]" />
        <label for="@($"{IdPrefix}header-input")">@Loc["ExportProfileEditor_HeaderLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <select id="@($"{IdPrefix}source-select")" class="form-select" @bind="Draft.SourceValue" @bind:after="MarkDirty">
            <option value="">@Loc["ExportProfileEditor_SourceNotMapped"]</option>
            @foreach (var fieldRef in AvailableFieldRefs())
            {
                <option value="@fieldRef">@fieldRef</option>
            }
        </select>
        <label for="@($"{IdPrefix}source-select")">@Loc["ExportProfileEditor_SourceLabel"]</label>
    </div>
</div>

<!-- Lot 056 (56.7): submission and cancel are now visually distinct in every mode -- the
     submission button is always solid btn-secondary (icon still Plus in add mode / Check in edit
     mode, Lot 041 unchanged); "Cancel" stays btn-outline-secondary. -->
<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="() => OnSubmit.InvokeAsync()">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        else
        {
            @((MarkupString)AdminIconMarkup.Plus)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="() => OnCancel.InvokeAsync()">
            @((MarkupString)AdminIconMarkup.X) @Loc["ExportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public ColumnDefinitionDraft Draft { get; set; } = new();

    // Needed to filter the source <select>'s options -- the parent SheetGenerationRuleForm owns
    // PivotSource, this component has no sheet-rule context of its own. Live-bound so the option
    // list refreshes as soon as the parent's PivotSource select changes.
    [Parameter]
    public PivotSource PivotSource { get; set; }

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-column-definition-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-column-definition-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnDirty { get; set; }

    private void MarkDirty() => OnDirty.InvokeAsync();

    private IEnumerable<PivotFieldRef> AvailableFieldRefs() =>
        Enum.GetValues<PivotFieldRef>().Where(fieldRef => PivotFieldResolver.GetPivotSource(fieldRef) == PivotSource);
}
