@page "/mappings"

@using ExcelETL.Application.Exceptions
@using ExcelETL.Application.Extraction
@using ExcelETL.Domain.Entities
@using ExcelETL.Domain.Enums

@inject IExtractionConfigRepository ExtractionConfigRepository
@inject BusinessExceptionLocalizer BusinessExceptionLocalizer
@inject IStringLocalizer<BlazorAdminMessages> Loc

<PageTitle>@Loc["Mappings_PageTitle"]</PageTitle>

<h1>@Loc["Mappings_PageTitle"]</h1>

@if (_configs is null)
{
    <p>@Loc["Mappings_Loading"]</p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <h3>@Loc["Mappings_Configurations"]</h3>
            <ul class="list-group">
                @foreach (var config in _configs)
                {
                    <li class="list-group-item @(config.Id == _selectedConfigId ? "active" : "")"
                        style="cursor:pointer" @onclick="() => SelectConfig(config.Id)">
                        @config.Name (@Loc["Mappings_SheetCount", config.Sheets.Count])
                    </li>
                }
            </ul>

            <h4 class="mt-3">@Loc["Mappings_NewConfiguration"]</h4>
            <div class="input-group">
                <input id="new-config-name-input" class="form-control" @bind="_newConfigName" placeholder="@Loc["Mappings_ConfigurationNamePlaceholder"]" />
                <button id="create-config-button" class="btn btn-primary" @onclick="CreateConfigAsync">@Loc["Mappings_Create"]</button>
            </div>
        </div>

        <div class="col-md-8">
            @if (_selectedConfig is not null)
            {
                <h3>@_selectedConfig.Name</h3>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                @foreach (var sheet in _selectedConfig.Sheets.OrderBy(s => s.SheetIndex))
                {
                    <div class="card mb-3">
                        <div class="card-header">@Loc["Mappings_SheetHeader", sheet.SheetName, sheet.SheetIndex]</div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>@Loc["Mappings_SourceCell"]</th>
                                        <th>@Loc["Mappings_TargetProperty"]</th>
                                        <th>@Loc["Mappings_DataType"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mapping in sheet.CellMappings)
                                    {
                                        <tr>
                                            <td>@mapping.SourceCell</td>
                                            <td>@mapping.TargetPropertyName</td>
                                            <td>@CellDataTypeLabel(mapping.DataType)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="row g-2">
                                <div class="col">
                                    <input class="form-control mapping-source-cell-input" @bind="_newMapping.SourceCell" placeholder="@Loc["Mappings_SourceCellPlaceholder"]" />
                                </div>
                                <div class="col">
                                    <input class="form-control mapping-target-property-input" @bind="_newMapping.TargetPropertyName" placeholder="@Loc["Mappings_PropertyNamePlaceholder"]" />
                                </div>
                                <div class="col">
                                    <select class="form-select mapping-data-type-select" @bind="_newMapping.DataType">
                                        @foreach (var type in Enum.GetValues<CellDataType>())
                                        {
                                            <option value="@type">@CellDataTypeLabel(type)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-secondary add-mapping-button" @onclick="() => AddCellMappingAsync(sheet.Id)">
                                        @Loc["Mappings_AddMapping"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <h4>@Loc["Mappings_AddSheet"]</h4>
                <div class="row g-2">
                    <div class="col">
                        <input id="new-sheet-name-input" class="form-control" @bind="_newSheet.SheetName" placeholder="@Loc["Mappings_SheetNamePlaceholder"]" />
                    </div>
                    <div class="col">
                        <input id="new-sheet-index-input" type="number" class="form-control" @bind="_newSheet.SheetIndex" placeholder="@Loc["Mappings_IndexPlaceholder"]" />
                    </div>
                    <div class="col-auto">
                        <button id="add-sheet-button" class="btn btn-primary" @onclick="AddSheetAsync">@Loc["Mappings_AddSheet"]</button>
                    </div>
                </div>
            }
            else
            {
                <p>@Loc["Mappings_SelectConfigPrompt"]</p>
            }
        </div>
    </div>
}

@code {
    private List<ExtractionConfig>? _configs;
    private ExtractionConfig? _selectedConfig;
    private Guid? _selectedConfigId;
    private string _newConfigName = string.Empty;
    private string? _errorMessage;

    private NewSheetModel _newSheet = new();
    private NewMappingModel _newMapping = new();

    protected override async Task OnInitializedAsync() => await LoadConfigsAsync();

    private async Task LoadConfigsAsync()
    {
        _configs = (await ExtractionConfigRepository.GetAllAsync()).ToList();

        _selectedConfig = _selectedConfigId is { } id
            ? _configs.FirstOrDefault(c => c.Id == id)
            : null;
    }

    private void SelectConfig(Guid configId)
    {
        _selectedConfigId = configId;
        _errorMessage = null;
        _selectedConfig = _configs?.FirstOrDefault(c => c.Id == configId);
    }

    private async Task CreateConfigAsync()
    {
        if (string.IsNullOrWhiteSpace(_newConfigName))
        {
            return;
        }

        await ExtractionConfigRepository.AddAsync(new ExtractionConfig(_newConfigName));

        _newConfigName = string.Empty;
        await LoadConfigsAsync();
    }

    private async Task AddSheetAsync()
    {
        if (_selectedConfigId is not { } configId)
        {
            return;
        }

        _errorMessage = null;

        try
        {
            await ExtractionConfigRepository.AddSheetAsync(
                configId, new SheetConfig(_newSheet.SheetName, _newSheet.SheetIndex));
            _newSheet = new NewSheetModel();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ExtractionConfigNotFoundException)
        {
            _errorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }

        await LoadConfigsAsync();
    }

    private async Task AddCellMappingAsync(Guid sheetId)
    {
        if (_selectedConfigId is not { } configId)
        {
            return;
        }

        _errorMessage = null;

        try
        {
            await ExtractionConfigRepository.AddCellMappingAsync(
                configId, sheetId, new CellMapping(_newMapping.SourceCell, _newMapping.TargetPropertyName, _newMapping.DataType));
            _newMapping = new NewMappingModel();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ExtractionConfigNotFoundException)
        {
            _errorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }

        await LoadConfigsAsync();
    }

    private string CellDataTypeLabel(CellDataType type) => type switch
    {
        CellDataType.Text => Loc["Mappings_DataType_Text"],
        CellDataType.Number => Loc["Mappings_DataType_Number"],
        CellDataType.Decimal => Loc["Mappings_DataType_Decimal"],
        CellDataType.Date => Loc["Mappings_DataType_Date"],
        CellDataType.Boolean => Loc["Mappings_DataType_Boolean"],
        _ => type.ToString()
    };

    private sealed class NewSheetModel
    {
        public string SheetName { get; set; } = string.Empty;
        public int SheetIndex { get; set; }
    }

    private sealed class NewMappingModel
    {
        public string SourceCell { get; set; } = string.Empty;
        public string TargetPropertyName { get; set; } = string.Empty;
        public CellDataType DataType { get; set; } = CellDataType.Text;
    }
}
