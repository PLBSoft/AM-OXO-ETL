@page "/history"

@using ExcelETL.Application.Extraction
@using ExcelETL.Domain.Entities
@using ExcelETL.Domain.Enums

@inject IExtractionHistoryRepository ExtractionHistoryRepository
@inject IStringLocalizer<BlazorAdminMessages> Loc

<PageTitle>@Loc["History_PageTitle"]</PageTitle>

<h1>@Loc["History_PageTitle"]</h1>

@if (_history is null)
{
    <p>@Loc["History_Loading"]</p>
}
else if (_history.Count == 0)
{
    <p>@Loc["History_NoEntries"]</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@Loc["History_DateUtc"]</th>
                <th>@Loc["History_SourceFile"]</th>
                <th>@Loc["History_Status"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in _history)
            {
                <tr>
                    <td>@entry.JobTimestamp.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@entry.SourceFileName</td>
                    <td><span class="badge @StatusBadgeClass(entry.Status)">@StatusLabel(entry.Status)</span></td>
                    <td>
                        @if (entry.Status == ExtractionStatus.Completed && !string.IsNullOrEmpty(entry.StoredFilePath))
                        {
                            <a class="btn btn-sm btn-outline-primary" href="@($"/history/{entry.Id}/download")">
                                @Loc["History_Download"]
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ExtractionHistory>? _history;

    protected override async Task OnInitializedAsync()
    {
        _history = (await ExtractionHistoryRepository.GetAllOrderedByDateDescendingAsync()).ToList();
    }

    private static string StatusBadgeClass(ExtractionStatus status) => status switch
    {
        ExtractionStatus.Completed => "bg-success",
        ExtractionStatus.Failed => "bg-danger",
        ExtractionStatus.Processing => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string StatusLabel(ExtractionStatus status) => status switch
    {
        ExtractionStatus.Pending => Loc["History_Status_Pending"],
        ExtractionStatus.Processing => Loc["History_Status_Processing"],
        ExtractionStatus.Completed => Loc["History_Status_Completed"],
        ExtractionStatus.Failed => Loc["History_Status_Failed"],
        _ => status.ToString()
    };
}
