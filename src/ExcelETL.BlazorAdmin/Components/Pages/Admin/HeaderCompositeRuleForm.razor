@using ExcelETL.BlazorAdmin.Editing.Import
@using ExcelETL.BlazorAdmin.Shared

@inject IStringLocalizer<BlazorAdminMessages> Loc

@* Lot 075 (P3 drafts): a pure leaf -- every value lives in Draft, owned and validated by SheetRuleForm
   (ImportProfileDraftMapper.ConvertHeaderComposite). *@

@if (!string.IsNullOrEmpty(Draft.Error))
{
    <div class="alert alert-danger" role="alert">@Draft.Error</div>
}

<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}header-composite-name-input")" @ref="_nameInputRef" class="form-control" @bind="Draft.Name" @bind:after="MarkDirty"
               @onkeydown="OnRowKeyDownAsync"
               placeholder="@Loc["ImportProfileEditor_HeaderCompositeNamePlaceholder"]" />
        <label for="@($"{IdPrefix}header-composite-name-input")">@Loc["ImportProfileEditor_HeaderCompositeNameLabel"]</label>
    </div>
</div>
<div class="mb-3">
    <div class="form-floating">
        <input id="@($"{IdPrefix}header-composite-template-input")" class="form-control" @bind="Draft.Template" @bind:after="MarkDirty"
               @onkeydown="OnRowKeyDownAsync" @onfocusout="OnLastFieldBlurAsync"
               placeholder="@Loc["ImportProfileEditor_HeaderCompositeTemplatePlaceholder"]" />
        <label for="@($"{IdPrefix}header-composite-template-input")">@Loc["ImportProfileEditor_HeaderCompositeTemplateLabel"]</label>
    </div>
    <div class="form-text">@Loc["ImportProfileEditor_HeaderCompositeTemplateHint"]</div>
</div>

<!-- Lot 056 (56.7): submission and cancel are now visually distinct in every mode -- the
     submission button is always solid btn-secondary (icon still Plus in add mode / Check in edit
     mode, Lot 041 unchanged); "Cancel" stays btn-outline-secondary. Previously both were
     btn-outline-secondary in edit mode, indistinguishable (audit S2.3 / lot 053 deferral). -->
<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="Submit">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        else
        {
            @((MarkupString)AdminIconMarkup.Plus)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3" @onclick="() => OnCancel.InvokeAsync()">
            @Loc["ImportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public HeaderCompositeRuleDraft Draft { get; set; } = new();

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-header-composite-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-header-composite-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnDirty { get; set; }

    private ElementReference _nameInputRef;

    private void MarkDirty() => OnDirty.InvokeAsync();

    // Lot 056 (56.4): same submit/focus and blur/Enter contract as BlockFieldForm.
    private async Task Submit()
    {
        await OnSubmit.InvokeAsync();
        if (Draft.Error is null)
        {
            await _nameInputRef.FocusAsync();
        }
    }

    private bool IsRowFullyFilled() => !string.IsNullOrWhiteSpace(Draft.Name) && !string.IsNullOrWhiteSpace(Draft.Template);

    private async Task OnLastFieldBlurAsync()
    {
        if (IsRowFullyFilled())
        {
            await Submit();
        }
    }

    private async Task OnRowKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && IsRowFullyFilled())
        {
            await Submit();
        }
    }
}
