<div class="card-body">
<h5>@Loc["ExportProfileEditor_ApplicationColumnsHeading"]</h5>
@if (_applicationColumns.Count > 0)
{
    <ul class="block-field-list">
        @for (var j = 0; j < _applicationColumns.Count; j++)
        {
            var applicationColumnIndex = j;
            var applicationColumn = _applicationColumns[applicationColumnIndex];
            @if (_editingApplicationColumnIndex == applicationColumnIndex)
            {
                <li class="block-field-item-editing">
                    <ApplicationColumnDefinitionForm IdPrefix="@($"{IdPrefix}application-column-{applicationColumnIndex}-")"
                                                      InitialApplicationColumn="applicationColumn"
                                                      SubmitButtonId="@($"{IdPrefix}save-application-column-definition-button-{applicationColumnIndex}")"
                                                      SubmitLabel="@Loc["ExportProfileEditor_SaveChangesButton"]"
                                                      ShowCancel="true"
                                                      CancelButtonId="@($"{IdPrefix}cancel-application-column-definition-button-{applicationColumnIndex}")"
