<!-- Lot 056 (56.7): submission and cancel are now visually distinct in every mode. -->
<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="Submit">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        else
        {
            @((MarkupString)AdminIconMarkup.Plus)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3" @onclick="Cancel">
            @Loc["ExportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public SheetGenerationRuleDraft Draft { get; set; } = new();

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-sheet-generation-rule-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-sheet-generation-rule-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    // Lot 056 (56.3): mirror of SheetRuleForm's own OnDirty -- raised on every mutation of this
    // form's state so the root editor's "unsaved changes" guard covers in-progress edits too.
    [Parameter]
    public EventCallback OnDirty { get; set; }

    private void MarkDirty() => OnDirty.InvokeAsync();

    // One edit state per nested list (lot 076, same generic tools as SheetRuleForm since lot 075): which
    // item is open and its value when opened, restored on Cancel -- a field's own @bind writes straight
    // into the shared draft the instant it's typed, so this is the only "undo" P3 still needs.
    private readonly ListItemEditState<ColumnDefinitionDraft> _columnEdit = new();
    private readonly ListItemEditState<PointColumnDefinitionDraft> _pointColumnEdit = new();
    private readonly ListItemEditState<ApplicationColumnDefinitionDraft> _applicationColumnEdit = new();

    // PointColumnDefinitions/ApplicationColumnDefinitions have no meaning for TacheMultiple (Domain
    // rejects them outright, T2/U4) and the subforms that add them are hidden the moment this pivot
    // source is selected -- clearing any already-added ones here avoids a confusing submit-time
    // DomainRuleViolationException for state the user can no longer even see. Switching back to
    // Equipement/Isolement only restores the ability to add new Point/Application columns, it does not
    // resurrect ones cleared by an earlier switch to TacheMultiple. This stays a UI rule applied
    // directly to the draft, not a conversion (see ExportProfileDraftMapper's own header comment).
    private void OnPivotSourceChangedAndMarkDirty()
    {
        if (Draft.PivotSource == PivotSource.TacheMultiple)
        {
            Draft.PointColumns.Clear();
            _pointColumnEdit.Close();
            Draft.ApplicationColumns.Clear();
            _applicationColumnEdit.Close();
        }

        MarkDirty();
    }

    private string Localize(Exception exception) => BusinessExceptionLocalizer.TryLocalize(exception) ?? exception.Message;

    private void Delete<TDraft>(List<TDraft> list, int index, ListItemEditState<TDraft> edit) where TDraft : class
    {
        DraftListActions.Delete(list, index, edit);
        MarkDirty();
    }

    // Cancel (ListItemEditState.Cancel, wired in the markup) is a pure discard and never marks the
    // profile dirty -- cancelling a nested edit was never itself a "change" worth flagging.

    private void SubmitColumn(int? index)
    {
        if (DraftListActions.Submit(Draft.Columns, index, Draft.PendingColumn, p => Draft.PendingColumn = p, _columnEdit,
                ExportProfileDraftMapper.ConvertColumn, Localize))
        {
            MarkDirty();
        }
    }

    private void SubmitPointColumn(int? index)
    {
        if (DraftListActions.Submit(Draft.PointColumns, index, Draft.PendingPointColumn, p => Draft.PendingPointColumn = p,
                _pointColumnEdit, ExportProfileDraftMapper.ConvertPointColumn, Localize))
        {
            MarkDirty();
        }
    }

    private void SubmitApplicationColumn(int? index)
    {
        if (DraftListActions.Submit(Draft.ApplicationColumns, index, Draft.PendingApplicationColumn,
                p => Draft.PendingApplicationColumn = p, _applicationColumnEdit, ExportProfileDraftMapper.ConvertApplicationColumn,
                Localize))
        {
            MarkDirty();
        }
    }

    // This form's own top-level Submit button: validates the whole rule (including its own 3
    // still-pending nested rows, per ExportProfileDraftMapper.ConvertSheetRule) and, only on
    // success, tells the owner (OnSubmit) what happened -- the owner (ExportProfileEditor) knows
    // from its own state whether Draft is an already-added rule or the pending "Add" slot, and
    // performs the corresponding list mutation itself. Errors of an earlier attempt are cleared
    // first, so one the user has since fixed never stays on screen (lot 076).
    private async Task Submit()
    {
        DraftListActions.ClearErrors(Draft);
        var result = ExportProfileDraftMapper.ConvertSheetRule(Draft);
        if (!result.IsSuccess)
        {
            DraftListActions.ApplyErrors(result.Errors, Localize);
            return;
        }

        await OnSubmit.InvokeAsync();
    }

    private async Task Cancel() => await OnCancel.InvokeAsync();
}
