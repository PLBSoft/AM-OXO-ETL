            {
                <li class="block-field-item-editing">
                    <PointColumnDefinitionForm IdPrefix="@($"{IdPrefix}point-column-{pointColumnIndex}-")"
                                               InitialPointColumn="pointColumn"
                                               SubmitButtonId="@($"{IdPrefix}save-point-column-definition-button-{pointColumnIndex}")"
                                               SubmitLabel="@Loc["ExportProfileEditor_SaveChangesButton"]"
