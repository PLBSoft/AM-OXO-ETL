<!-- Lot 056 (56.7): submission and cancel are now visually distinct in every mode. -->
<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-secondary w-100 mt-3 d-flex align-items-center justify-content-center gap-1" @onclick="Submit">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        else
        {
            @((MarkupString)AdminIconMarkup.Plus)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3" @onclick="Cancel">
            @Loc["ExportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public SheetGenerationRuleDraft Draft { get; set; } = new();

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-sheet-generation-rule-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-sheet-generation-rule-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    // Lot 056 (56.3): mirror of SheetRuleForm's own OnDirty -- raised on every mutation of this
    // form's state so the root editor's "unsaved changes" guard covers in-progress edits too.
    [Parameter]
    public EventCallback OnDirty { get; set; }

    private void MarkDirty() => OnDirty.InvokeAsync();

    private int? _editingColumnIndex;
    private int? _editingPointColumnIndex;
    private int? _editingApplicationColumnIndex;

    // Taken at "Modify" click time (DraftJson.Clone), restored into the list on Cancel -- the one
    // per-item "undo" mechanism the P3 architecture still needs, since a field's own @bind writes
    // straight into the shared draft the instant it's typed (see this component's own header
    // comment and the design table's "« Annuler » d'un élément" row).
    private ColumnDefinitionDraft? _columnEditSnapshot;
    private PointColumnDefinitionDraft? _pointColumnEditSnapshot;
    private ApplicationColumnDefinitionDraft? _applicationColumnEditSnapshot;

    // PointColumnDefinitions/ApplicationColumnDefinitions have no meaning for TacheMultiple (Domain
    // rejects them outright, T2/U4) and the subforms that add them are hidden the moment this pivot
    // source is selected -- clearing any already-added ones here avoids a confusing submit-time
    // DomainRuleViolationException for state the user can no longer even see. Switching back to
    // Equipement/Isolement only restores the ability to add new Point/Application columns, it does not
    // resurrect ones cleared by an earlier switch to TacheMultiple. This stays a UI rule applied
    // directly to the draft, not a conversion (see ExportProfileDraftMapper's own header comment).
    private void OnPivotSourceChangedAndMarkDirty()
    {
        OnPivotSourceChanged();
        MarkDirty();
    }

    private void OnPivotSourceChanged()
    {
        if (Draft.PivotSource != PivotSource.TacheMultiple)
        {
            return;
        }

        if (Draft.PointColumns.Count > 0)
        {
            Draft.PointColumns.Clear();
            _editingPointColumnIndex = null;
        }

        if (Draft.ApplicationColumns.Count > 0)
        {
            Draft.ApplicationColumns.Clear();
            _editingApplicationColumnIndex = null;
        }
    }

    // --- Columns --------------------------------------------------------------------------

    private void OpenColumnEdit(int index)
    {
        _editingColumnIndex = index;
        _columnEditSnapshot = DraftJson.Clone(Draft.Columns[index]);
        Draft.Columns[index].Error = null;
    }

    private void CancelColumnEdit(int index)
    {
        if (_columnEditSnapshot is not null)
        {
            Draft.Columns[index] = _columnEditSnapshot;
        }

        _editingColumnIndex = null;
        _columnEditSnapshot = null;
        OnCancelledNestedEdit();
    }

    private void HandleColumnSubmit(int? index)
    {
        var target = index.HasValue ? Draft.Columns[index.Value] : Draft.PendingColumn;
        var result = ExportProfileDraftMapper.ConvertColumn(target);
        if (!result.IsSuccess)
        {
            target.Error = Localize(result.Errors[0].Exception);
            return;
        }

        target.Error = null;
        if (index.HasValue)
        {
            _editingColumnIndex = null;
            _columnEditSnapshot = null;
        }
        else
        {
            Draft.Columns.Add(Draft.PendingColumn);
            Draft.PendingColumn = new ColumnDefinitionDraft();
        }

        MarkDirty();
    }

    private void DeleteColumn(int index)
    {
        Draft.Columns.RemoveAt(index);
        if (_editingColumnIndex == index)
        {
            _editingColumnIndex = null;
        }

        MarkDirty();
    }

    // --- Point columns ----------------------------------------------------------------------

    private void OpenPointColumnEdit(int index)
    {
        _editingPointColumnIndex = index;
        _pointColumnEditSnapshot = DraftJson.Clone(Draft.PointColumns[index]);
        Draft.PointColumns[index].Error = null;
    }

    private void CancelPointColumnEdit(int index)
    {
        if (_pointColumnEditSnapshot is not null)
        {
            Draft.PointColumns[index] = _pointColumnEditSnapshot;
        }

        _editingPointColumnIndex = null;
        _pointColumnEditSnapshot = null;
        OnCancelledNestedEdit();
    }

    private void HandlePointColumnSubmit(int? index)
    {
        var target = index.HasValue ? Draft.PointColumns[index.Value] : Draft.PendingPointColumn;
        var result = ExportProfileDraftMapper.ConvertPointColumn(target);
        if (!result.IsSuccess)
        {
            target.Error = Localize(result.Errors[0].Exception);
            return;
        }

        target.Error = null;
        if (index.HasValue)
        {
            _editingPointColumnIndex = null;
            _pointColumnEditSnapshot = null;
        }
        else
        {
            Draft.PointColumns.Add(Draft.PendingPointColumn);
            Draft.PendingPointColumn = new PointColumnDefinitionDraft();
        }

        MarkDirty();
    }

    private void DeletePointColumn(int index)
    {
        Draft.PointColumns.RemoveAt(index);
        if (_editingPointColumnIndex == index)
        {
            _editingPointColumnIndex = null;
        }

        MarkDirty();
    }

    // --- Application columns -----------------------------------------------------------------

    private void OpenApplicationColumnEdit(int index)
    {
        _editingApplicationColumnIndex = index;
        _applicationColumnEditSnapshot = DraftJson.Clone(Draft.ApplicationColumns[index]);
        Draft.ApplicationColumns[index].Error = null;
    }

    private void CancelApplicationColumnEdit(int index)
    {
        if (_applicationColumnEditSnapshot is not null)
        {
            Draft.ApplicationColumns[index] = _applicationColumnEditSnapshot;
        }

        _editingApplicationColumnIndex = null;
        _applicationColumnEditSnapshot = null;
        OnCancelledNestedEdit();
    }

    private void HandleApplicationColumnSubmit(int? index)
    {
        var target = index.HasValue ? Draft.ApplicationColumns[index.Value] : Draft.PendingApplicationColumn;
        var result = ExportProfileDraftMapper.ConvertApplicationColumn(target);
        if (!result.IsSuccess)
        {
            target.Error = Localize(result.Errors[0].Exception);
            return;
        }

        target.Error = null;
        if (index.HasValue)
        {
            _editingApplicationColumnIndex = null;
            _applicationColumnEditSnapshot = null;
        }
        else
        {
            Draft.ApplicationColumns.Add(Draft.PendingApplicationColumn);
            Draft.PendingApplicationColumn = new ApplicationColumnDefinitionDraft();
        }

        MarkDirty();
    }

    private void DeleteApplicationColumn(int index)
    {
        Draft.ApplicationColumns.RemoveAt(index);
        if (_editingApplicationColumnIndex == index)
        {
            _editingApplicationColumnIndex = null;
        }

        MarkDirty();
    }

    // Cancel is a pure discard -- explicitly does not call MarkDirty (matches the pre-migration
    // behavior: cancelling a nested edit was never itself a "change" worth flagging).
    private void OnCancelledNestedEdit()
    {
    }

    private string Localize(Exception exception) => BusinessExceptionLocalizer.TryLocalize(exception) ?? exception.Message;

    // This form's own top-level Submit button: validates the whole rule (including its own 3
    // still-pending nested rows, per ExportProfileDraftMapper.ConvertSheetRule) and, only on
    // success, tells the owner (OnSubmit) what happened -- the owner (ExportProfileEditor) knows
    // from its own state whether Draft is an already-added rule or the pending "Add" slot, and
    // performs the corresponding list mutation itself.
    private async Task Submit()
    {
        var result = ExportProfileDraftMapper.ConvertSheetRule(Draft);
        if (!result.IsSuccess)
        {
            foreach (var error in result.Errors)
            {
                if (error.Draft is IDraftWithError withError)
                {
                    withError.Error = Localize(error.Exception);
                }
            }

            return;
        }

        Draft.Error = null;
        await OnSubmit.InvokeAsync();
    }

    private async Task Cancel() => await OnCancel.InvokeAsync();
}
