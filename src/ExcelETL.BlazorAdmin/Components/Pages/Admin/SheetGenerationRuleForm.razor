<ApplicationColumnDefinitionForm IdPrefix="@($"{IdPrefix}application-column-")"
                                 SubmitButtonId="@($"{IdPrefix}add-application-column-definition-button")"
                                 SubmitLabel="@Loc["ExportProfileEditor_AddApplicationColumnButton"]"
                                 OnSubmit="AddApplicationColumn" />
</div>
</div>
}

<div class="right-aligned-actions">
    <button id="@SubmitButtonId" class="btn btn-outline-secondary w-100 mt-3" @onclick="Submit">
        @if (ShowCancel)
        {
            @((MarkupString)AdminIconMarkup.Check)
        }
        @SubmitLabel
    </button>
    @if (ShowCancel)
    {
        <button id="@CancelButtonId" class="btn btn-outline-secondary w-100 mt-3" @onclick="Cancel">
            @Loc["ExportProfileEditor_CancelButton"]
        </button>
    }
</div>

@code {
    [Parameter]
    public string IdPrefix { get; set; } = string.Empty;

    [Parameter]
    public SheetGenerationRule? InitialRule { get; set; }

    [Parameter]
    public string SubmitButtonId { get; set; } = "add-sheet-generation-rule-button";

    [Parameter]
    public string CancelButtonId { get; set; } = "cancel-sheet-generation-rule-button";

    [Parameter]
    public string SubmitLabel { get; set; } = string.Empty;

    [Parameter]
    public bool ShowCancel { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback<SheetGenerationRule> OnSubmit { get; set; }

    private string _sheetName = string.Empty;
    private PivotSource _pivotSource = PivotSource.Equipement;
    private readonly List<ColumnDefinition> _columns = [];
    private readonly List<PointColumnDefinition> _pointColumns = [];
    private readonly List<ApplicationColumnDefinition> _applicationColumns = [];

    private int? _editingColumnIndex;
    private int? _editingPointColumnIndex;
    private int? _editingApplicationColumnIndex;

    private string? _errorMessage;

    // Only ever runs once per mounted instance -- the parent gives an edit-mode instance a fresh
    // component identity (conditionally rendered inside an @if, not a persistently bound one), so
    // InitialRule never changes underneath an already-initialized instance.
    protected override void OnInitialized()
    {
        if (InitialRule is null)
        {
            return;
        }

        _sheetName = InitialRule.SheetName;
        _pivotSource = InitialRule.PivotSource;
        _columns.AddRange(InitialRule.ColumnDefinitions);
        _pointColumns.AddRange(InitialRule.PointColumnDefinitions);
        _applicationColumns.AddRange(InitialRule.ApplicationColumnDefinitions);
    }

    // PointColumnDefinitions/ApplicationColumnDefinitions have no meaning for TacheMultiple (Domain
    // rejects them outright, T2/U4) and the subforms that add them are hidden the moment this pivot
    // source is selected -- clearing any already-added ones here avoids a confusing submit-time
    // DomainRuleViolationException for state the user can no longer even see. Switching back to
    // Equipement/Isolement only restores the ability to add new Point/Application columns, it does not
    // resurrect ones cleared by an earlier switch to TacheMultiple.
    private void OnPivotSourceChanged()
    {
        if (_pivotSource != PivotSource.TacheMultiple)
        {
            return;
        }

        if (_pointColumns.Count > 0)
        {
            _pointColumns.Clear();
            _editingPointColumnIndex = null;
        }

        if (_applicationColumns.Count > 0)
        {
            _applicationColumns.Clear();
            _editingApplicationColumnIndex = null;
        }
    }

    private void AddColumn(ColumnDefinition column) => _columns.Add(column);

    private void HandleSaveColumn(int index, ColumnDefinition updated)
    {
        _columns[index] = updated;
        _editingColumnIndex = null;
    }

    private void DeleteColumn(int index)
    {
        _columns.RemoveAt(index);
        if (_editingColumnIndex == index)
        {
            _editingColumnIndex = null;
        }
    }

    private void AddPointColumn(PointColumnDefinition pointColumn) => _pointColumns.Add(pointColumn);

    private void HandleSavePointColumn(int index, PointColumnDefinition updated)
    {
        _pointColumns[index] = updated;
        _editingPointColumnIndex = null;
    }

    private void DeletePointColumn(int index)
    {
        _pointColumns.RemoveAt(index);
        if (_editingPointColumnIndex == index)
        {
            _editingPointColumnIndex = null;
        }
    }

    private void AddApplicationColumn(ApplicationColumnDefinition applicationColumn) => _applicationColumns.Add(applicationColumn);

    private void HandleSaveApplicationColumn(int index, ApplicationColumnDefinition updated)
    {
        _applicationColumns[index] = updated;
        _editingApplicationColumnIndex = null;
    }

    private void DeleteApplicationColumn(int index)
    {
        _applicationColumns.RemoveAt(index);
        if (_editingApplicationColumnIndex == index)
        {
            _editingApplicationColumnIndex = null;
        }
    }

    private async Task Submit()
    {
        _errorMessage = null;

        try
        {
            // SheetGenerationRule's constructor snapshots all three lists itself ([.. ...]), unlike the
            // import side's SheetExtractionRule.UnconditionalColonneNames -- no defensive copy needed
            // here before ResetForm() clears _columns/_pointColumns/_applicationColumns below.
            var rule = new SheetGenerationRule(_sheetName, _pivotSource, _columns, _pointColumns, _applicationColumns);

            await OnSubmit.InvokeAsync(rule);

            ResetForm();
        }
        catch (Exception ex) when (ex is DomainValidationException or DomainRuleViolationException)
        {
            _errorMessage = BusinessExceptionLocalizer.TryLocalize(ex) ?? ex.Message;
        }
    }

    private async Task Cancel() => await OnCancel.InvokeAsync();

    private void ResetForm()
    {
        _sheetName = string.Empty;
        _pivotSource = PivotSource.Equipement;
        _columns.Clear();
        _pointColumns.Clear();
        _applicationColumns.Clear();
        _editingColumnIndex = null;
        _editingPointColumnIndex = null;
        _editingApplicationColumnIndex = null;
    }
}
