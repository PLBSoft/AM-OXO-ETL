@page "/users"
@attribute [Authorize(Roles = IdentitySeeder.AdminRoleName)]

@using ExcelETL.Application.Identity
@using ExcelETL.Infrastructure.Identity
@using Microsoft.AspNetCore.Authorization

@inject IUserRepository UserRepository
@inject IStringLocalizer<BlazorAdminMessages> Loc

<PageTitle>@Loc["Users_PageTitle"]</PageTitle>

<h1>@Loc["Users_PageTitle"]</h1>

@if (_users is null)
{
    <p>@Loc["Users_Loading"]</p>
}
else if (_users.Count == 0)
{
    <p>@Loc["Users_NoEntries"]</p>
}
else
{
    <table class="table d-none d-md-table">
        <thead>
            <tr>
                <th>@Loc["Users_Id"]</th>
                <th>@Loc["Users_Email"]</th>
                <th>@Loc["Users_UserName"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in _users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Email</td>
                    <td>@user.UserName</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-md-none">
        @foreach (var user in _users)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="card-title h5">@user.Email</h2>
                    <p class="card-text mb-1"><strong>@Loc["Users_UserName"]:</strong> @user.UserName</p>
                    <p class="card-text text-muted small mb-0"><strong>@Loc["Users_Id"]:</strong> @user.Id</p>
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<UserSummary>? _users;

    protected override async Task OnInitializedAsync()
    {
        _users = await UserRepository.GetAllAsync();
    }
}
