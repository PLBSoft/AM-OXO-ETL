@page "/generated-files"
@attribute [Authorize]

@using ExcelETL.Application.Archiving
@using ExcelETL.BlazorAdmin.Shared
@using ExcelETL.Infrastructure.Identity
@using ExcelETL.BlazorAdmin.Services
@using ExcelETL.Domain.Archiving
@using ExcelETL.Infrastructure.Archiving
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.Extensions.Options

@inject IGeneratedFileArchiveStore GeneratedFileArchiveStore
@inject IOptions<GeneratedFilesArchiveOptions> ArchiveOptions
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject ILocalTimeFormatter LocalTimeFormatter
@inject IArchiveRetentionSettingsStore RetentionSettingsStore
@inject IGeneratedFilePurger GeneratedFilePurger
@inject TimeProvider TimeProvider

<PageTitle>@Loc["GeneratedFiles_PageTitle"]</PageTitle>

<h1>@Loc["GeneratedFiles_PageTitle"]</h1>

<div class="alert alert-info small" role="alert" id="generated-files-scope-note">
    @Loc["GeneratedFiles_ScopeNote"]
</div>

@if (_isAdmin)
{
    <section id="archive-retention-panel" class="card bg-light mb-3">
        <div class="card-body">
            <h2 class="h5 mb-1">@Loc["GeneratedFiles_RetentionHeading"]</h2>
            <p class="small text-muted mb-2">@Loc["GeneratedFiles_RetentionHelp"]</p>

            @* One compact row when the width allows it: label, a 3-digit-wide field, Save, then Purge pushed
               to the right. A plain form-control and a plain btn share Bootstrap's own height, so the field
               and the buttons line up without any custom CSS. The field's width comes from the grid only.
               Below md each button takes its own full-width line. *@
            <div class="row g-2 align-items-center">
                <div class="col-auto">
                    <label for="retention-days-input" class="col-form-label">@Loc["GeneratedFiles_RetentionDaysLabel"]</label>
                </div>
                <div class="col-4 col-sm-3 col-md-2 col-xxl-1">
                    <input id="retention-days-input" type="number" min="0" max="@ArchiveRetentionSetting.MaxRetentionDays"
                           class="form-control"
                           @bind="_retentionInput" @bind:event="oninput" />
                </div>
                <div class="col-12 col-md-auto">
                    <button id="save-retention-days-button" type="button"
                            class="btn btn-secondary w-100 d-flex align-items-center justify-content-center gap-1"
                            @onclick="SaveRetentionAsync">
                        @((MarkupString)AdminIconMarkup.Check) @Loc["GeneratedFiles_RetentionSaveButton"]
                    </button>
                </div>
                @if (!_purgeConfirmationOpen)
                {
                    <div class="col-12 col-md-auto ms-md-auto">
                        <button id="purge-now-button" type="button"
                                class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-1"
                                disabled="@(_savedRetentionDays == 0)"
                                title="@(_savedRetentionDays == 0 ? Loc["GeneratedFiles_PurgeDisabledHint"] : Loc["GeneratedFiles_PurgeNowButton"])"
                                @onclick="OpenPurgeNow">
                            @((MarkupString)AdminIconMarkup.Trash) @Loc["GeneratedFiles_PurgeNowButton"]
                        </button>
                    </div>
                }
            </div>

            @if (_purgeConfirmationOpen)
            {
                <div id="purge-now-confirm" class="right-aligned-actions align-items-center flex-wrap mt-2" role="alert">
                    <span class="text-danger me-auto">@Loc["GeneratedFiles_PurgeNowConfirmMessage", _savedRetentionDays]</span>
                    <button id="confirm-purge-now-button" type="button" class="btn btn-sm btn-danger"
                            @onclick="ConfirmPurgeNowAsync">
                        @Loc["GeneratedFiles_PurgeNowConfirmButton"]
                    </button>
                    <button id="cancel-purge-now-button" type="button"
                            class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center gap-1"
                            @onclick="CancelPurgeNow">
                        @((MarkupString)AdminIconMarkup.X) @Loc["GeneratedFiles_PurgeCancelButton"]
                    </button>
                </div>
            }

            @if (_retentionError is not null)
            {
                <div id="retention-error" class="alert alert-danger py-2 mt-2 mb-0" role="alert">@_retentionError</div>
            }

            @if (_purgeMessage is not null)
            {
                <div id="purge-result" class="alert alert-success py-2 mt-2 mb-0" role="status">@_purgeMessage</div>
            }
        </div>
    </section>
}

<div class="mb-3">
    <label class="form-label" for="generated-files-search-input">@Loc["GeneratedFiles_SearchLabel"]</label>
    <div class="input-group">
        <input id="generated-files-search-input" type="text" class="form-control"
               placeholder="@Loc["GeneratedFiles_SearchPlaceholder"]" @bind="_searchTerm" @bind:event="oninput" />
        <button id="generated-files-search-button" type="button" class="btn btn-primary" @onclick="SearchAsync">
            @Loc["GeneratedFiles_SearchButton"]
        </button>
        <button id="generated-files-clear-search-button" type="button" class="btn btn-outline-secondary" @onclick="ClearSearchAsync">
            @Loc["GeneratedFiles_ClearSearchButton"]
        </button>
    </div>
</div>

@if (_records is null)
{
    <p>@Loc["GeneratedFiles_Loading"]</p>
}
else if (_records.Count == 0)
{
    <p>@Loc["GeneratedFiles_NoEntries"]</p>
}
else
{
    <div class="d-none d-md-block" id="generated-files-grid">
        <QuickGrid Items="@_records.AsQueryable()" Pagination="@_pagination" Class="table">
            <TemplateColumn Title="@Loc["GeneratedFiles_DateColumn"]" Sortable="true" SortBy="@DateSort">
                <span id="@($"generated-file-date-{context.Id}")">@LocalTimestampOrFallback(context)</span>
            </TemplateColumn>
            <TemplateColumn Title="@Loc["GeneratedFiles_EquipementRepereColumn"]" Sortable="true" SortBy="@RepereSort">
                @(context.EquipementRepere ?? "—")
            </TemplateColumn>
            <TemplateColumn Title="@Loc["GeneratedFiles_UsernameColumn"]" Sortable="true" SortBy="@UsernameSort">
                @(context.Username ?? "—")
            </TemplateColumn>
            <TemplateColumn Title="@Loc["GeneratedFiles_StatusColumn"]" Sortable="true" SortBy="@StatusSort">
                <span class="badge @GetStatusBadgeClass(context.Status)">@GetStatusLabel(context.Status)</span>
            </TemplateColumn>
            <TemplateColumn Title="@Loc["GeneratedFiles_WarningsColumn"]" Sortable="true" SortBy="@WarningCountSort">
                @if (context.Warnings.Count == 0)
                {
                    <span class="badge bg-secondary">@Loc["GeneratedFiles_NoWarnings"]</span>
                }
                else
                {
                    <details id="@($"warnings-details-{context.Id}")" open="@_expandedWarningIds.Contains(context.Id)">
                        <summary id="@($"warnings-toggle-{context.Id}")"
                                 @onclick="() => ToggleWarnings(context.Id)" @onclick:preventDefault="true">
                            <span class="badge bg-warning text-dark">@context.Warnings.Count</span>
                        </summary>
                        @if (_expandedWarningIds.Contains(context.Id))
                        {
                            <ul class="mb-0 ps-3" id="@($"warnings-list-{context.Id}")">
                                @foreach (var warning in context.Warnings)
                                {
                                    <li>@string.Format(Loc["GeneratedFiles_WarningsSummary"].Value, warning.Sheet, warning.Message)</li>
                                }
                            </ul>
                        }
                    </details>
                }
            </TemplateColumn>
            <TemplateColumn Title="@Loc["GeneratedFiles_SourceFileColumn"]">
                @if (context.FilesPurgedAtUtc is not null)
                {
                    <span id="@($"source-expired-{context.Id}")" class="text-muted">@Loc["GeneratedFiles_FilesExpired"]</span>
                }
                else if (_sourceDownloadHrefs.TryGetValue(context.Id, out var sourceHref))
                {
                    <a id="@($"download-source-link-{context.Id}")" class="btn btn-outline-secondary btn-sm"
                       href="@sourceHref" download="@context.SourceFileName">
                        @Loc["GeneratedFiles_DownloadSourceButton"]
                    </a>
                }
                else
                {
                    <button id="@($"prepare-download-source-button-{context.Id}")" type="button"
                            class="btn btn-outline-secondary btn-sm"
                            @onclick="() => PrepareSourceDownloadAsync(context)">
                        @Loc["GeneratedFiles_DownloadSourceButton"]
                    </button>
                }
            </TemplateColumn>
            <TemplateColumn Title="@Loc["GeneratedFiles_TargetFileColumn"]">
                @if (context.TargetFilePath is null)
                {
                    <span class="text-muted">—</span>
                }
                else if (context.FilesPurgedAtUtc is not null)
                {
                    <span id="@($"target-expired-{context.Id}")" class="text-muted">@Loc["GeneratedFiles_FilesExpired"]</span>
                }
                else if (_targetDownloadHrefs.TryGetValue(context.Id, out var targetHref))
                {
                    <a id="@($"download-target-link-{context.Id}")" class="btn btn-outline-secondary btn-sm"
                       href="@targetHref" download="@context.TargetFileName">
                        @Loc["GeneratedFiles_DownloadTargetButton"]
                    </a>
                }
                else
                {
                    <button id="@($"prepare-download-target-button-{context.Id}")" type="button"
                            class="btn btn-outline-secondary btn-sm"
                            @onclick="() => PrepareTargetDownloadAsync(context)">
                        @Loc["GeneratedFiles_DownloadTargetButton"]
                    </button>
                }
            </TemplateColumn>
        </QuickGrid>
        <div id="generated-files-paginator">
            <Paginator State="@_pagination" />
        </div>
    </div>

    <div class="d-md-none">
        @foreach (var record in _records)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="card-title h5">@(record.EquipementRepere ?? "—")</h2>
                    <p class="card-text mb-1" id="generated-file-date-card-@record.Id">@LocalTimestampOrFallback(record)</p>
                    <p class="card-text mb-1">@Loc["GeneratedFiles_UsernameColumn"]: @(record.Username ?? "—")</p>
                    <p class="card-text mb-2"><span class="badge @GetStatusBadgeClass(record.Status)">@GetStatusLabel(record.Status)</span></p>
                    <p class="card-text mb-2">
                        @Loc["GeneratedFiles_WarningsColumn"]:
                        @if (record.Warnings.Count == 0)
                        {
                            <span class="badge bg-secondary">@Loc["GeneratedFiles_NoWarnings"]</span>
                        }
                        else
                        {
                            <details id="@($"warnings-details-card-{record.Id}")" open="@_expandedWarningIds.Contains(record.Id)">
                                <summary id="@($"warnings-toggle-card-{record.Id}")"
                                         @onclick="() => ToggleWarnings(record.Id)" @onclick:preventDefault="true">
                                    <span class="badge bg-warning text-dark">@record.Warnings.Count</span>
                                </summary>
                                @if (_expandedWarningIds.Contains(record.Id))
                                {
                                    <ul class="mb-0 ps-3" id="@($"warnings-list-card-{record.Id}")">
                                        @foreach (var warning in record.Warnings)
                                        {
                                            <li>@string.Format(Loc["GeneratedFiles_WarningsSummary"].Value, warning.Sheet, warning.Message)</li>
                                        }
                                    </ul>
                                }
                            </details>
                        }
                    </p>
                    <div class="d-flex gap-2">
                        @if (record.FilesPurgedAtUtc is not null)
                        {
                            <span id="@($"source-expired-card-{record.Id}")" class="text-muted">@Loc["GeneratedFiles_FilesExpired"]</span>
                        }
                        else if (_sourceDownloadHrefs.TryGetValue(record.Id, out var sourceHrefCard))
                        {
                            <a id="@($"download-source-link-card-{record.Id}")" class="btn btn-outline-secondary btn-sm"
                               href="@sourceHrefCard" download="@record.SourceFileName">
                                @Loc["GeneratedFiles_DownloadSourceButton"]
                            </a>
                        }
                        else
                        {
                            <button id="@($"prepare-download-source-button-card-{record.Id}")" type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    @onclick="() => PrepareSourceDownloadAsync(record)">
                                @Loc["GeneratedFiles_DownloadSourceButton"]
                            </button>
                        }

                        @if (record.TargetFilePath is null)
                        {
                            <span class="text-muted">—</span>
                        }
                        else if (record.FilesPurgedAtUtc is not null)
                        {
                            <span id="@($"target-expired-card-{record.Id}")" class="text-muted">@Loc["GeneratedFiles_FilesExpired"]</span>
                        }
                        else if (_targetDownloadHrefs.TryGetValue(record.Id, out var targetHrefCard))
                        {
                            <a id="@($"download-target-link-card-{record.Id}")" class="btn btn-outline-secondary btn-sm"
                               href="@targetHrefCard" download="@record.TargetFileName">
                                @Loc["GeneratedFiles_DownloadTargetButton"]
                            </a>
                        }
                        else
                        {
                            <button id="@($"prepare-download-target-button-card-{record.Id}")" type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    @onclick="() => PrepareTargetDownloadAsync(record)">
                                @Loc["GeneratedFiles_DownloadTargetButton"]
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    // QuickGrid (Microsoft.AspNetCore.Components.QuickGrid): official, MIT-licensed, no CSS
    // framework of its own -- renders a plain <table> styled via the existing Bootstrap `table`
    // class, unlike a full component-library option (e.g. MudBlazor) which would bring its own
    // Material Design styling alongside the app's existing Bootstrap/M3 theme. Client-side
    // pagination/sorting (an IQueryable over the already-loaded _records list) was chosen over a
    // GridItemsProvider/server-side page-by-page load: simpler, and the archive's expected volume
    // doesn't yet justify the extra IGeneratedFileArchiveStore surface a server-side approach would
    // need. Desktop only -- the mobile card list below stays a plain, unpaginated foreach (matching
    // this project's established d-none d-md-table / d-md-none split), since QuickGrid's own layout
    // is table-shaped and admin use of this archive is expected to be primarily desktop.
    private static readonly GridSort<GeneratedFileRecord> DateSort =
        GridSort<GeneratedFileRecord>.ByAscending(r => r.GeneratedAtUtc);
    private static readonly GridSort<GeneratedFileRecord> RepereSort =
        GridSort<GeneratedFileRecord>.ByAscending(r => r.EquipementRepere);
    private static readonly GridSort<GeneratedFileRecord> UsernameSort =
        GridSort<GeneratedFileRecord>.ByAscending(r => r.Username);
    private static readonly GridSort<GeneratedFileRecord> StatusSort =
        GridSort<GeneratedFileRecord>.ByAscending(r => r.Status);
    private static readonly GridSort<GeneratedFileRecord> WarningCountSort =
        GridSort<GeneratedFileRecord>.ByAscending(r => r.Warnings.Count);

    private PaginationState _pagination = new() { ItemsPerPage = 25 };

    // Lot 072: same "content genuinely absent from the DOM while collapsed" idiom as every other
    // <details> disclosure in this project (R3, Lot 033) -- driven by this component-state set,
    // not <details>'s own native open/closed CSS, which would leave the <li> elements in the DOM
    // either way.
    private readonly HashSet<Guid> _expandedWarningIds = [];

    private void ToggleWarnings(Guid id)
    {
        if (!_expandedWarningIds.Add(id))
        {
            _expandedWarningIds.Remove(id);
        }
    }

    private IReadOnlyList<GeneratedFileRecord>? _records;
    private string _searchTerm = "";
    private readonly Dictionary<Guid, string> _sourceDownloadHrefs = new();
    private readonly Dictionary<Guid, string> _targetDownloadHrefs = new();

    // Lot 064: same browser-local-time mechanism/dedup-by-visible-ids convention as Logs.razor.
    private const string TimestampPattern = "dd/MM/yyyy HH:mm:ss";
    private readonly Dictionary<Guid, string> _localTimestamps = new();
    private HashSet<Guid>? _localTimestampsComputedForIds;

    // Lot 090: retention settings and manual purge, admin only. Hidden (and refused in the handlers
    // below) for any other authenticated account -- this page itself stays open to every account.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isAdmin;
    private int _savedRetentionDays;
    private int _retentionInput;
    private string? _retentionError;
    private string? _purgeMessage;
    private bool _purgeConfirmationOpen;

    private async Task LoadRetentionAsync()
    {
        var authState = AuthState is null ? null : await AuthState;
        _isAdmin = authState?.User.IsInRole(IdentitySeeder.AdminRoleName) == true;
        if (!_isAdmin)
        {
            return;
        }

        _savedRetentionDays = await RetentionSettingsStore.GetRetentionDaysAsync();
        _retentionInput = _savedRetentionDays;
    }

    private async Task SaveRetentionAsync()
    {
        if (!_isAdmin)
        {
            return;
        }

        _retentionError = null;
        _purgeMessage = null;
        if (_retentionInput is < 0 or > ArchiveRetentionSetting.MaxRetentionDays)
        {
            _retentionError = Loc["GeneratedFiles_RetentionInvalid", 0, ArchiveRetentionSetting.MaxRetentionDays];
            return;
        }

        await RetentionSettingsStore.SaveRetentionDaysAsync(_retentionInput);
        _savedRetentionDays = _retentionInput;
        _purgeMessage = Loc["GeneratedFiles_RetentionSaved", _savedRetentionDays];
    }

    private void OpenPurgeNow()
    {
        if (_isAdmin && _savedRetentionDays > 0)
        {
            _purgeMessage = null;
            _purgeConfirmationOpen = true;
        }
    }

    private void CancelPurgeNow() => _purgeConfirmationOpen = false;

    private async Task ConfirmPurgeNowAsync()
    {
        _purgeConfirmationOpen = false;
        if (!_isAdmin)
        {
            return;
        }

        var result = await GeneratedFilePurger.PurgeExpiredAsync(TimeProvider.GetUtcNow().UtcDateTime);
        _purgeMessage = Loc["GeneratedFiles_PurgeResult", result.RecordsPurged, result.FilesDeleted,
            (result.BytesFreed / 1024.0 / 1024.0).ToString("0.0", System.Globalization.CultureInfo.CurrentUICulture)];
        await LoadRecordsAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRetentionAsync();
        await LoadRecordsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_records is null || !RendererInfo.IsInteractive)
        {
            return;
        }

        var currentIds = _records.Select(r => r.Id).ToHashSet();
        if (_localTimestampsComputedForIds is not null && _localTimestampsComputedForIds.SetEquals(currentIds))
        {
            return;
        }

        var formatted = await LocalTimeFormatter.FormatManyAsync(
            _records.Select(r => r.GeneratedAtUtc).ToList(), TimestampPattern);

        _localTimestamps.Clear();
        for (var i = 0; i < _records.Count; i++)
        {
            _localTimestamps[_records[i].Id] = formatted[i];
        }

        _localTimestampsComputedForIds = currentIds;
        StateHasChanged();
    }

    private string LocalTimestampOrFallback(GeneratedFileRecord record) =>
        _localTimestamps.TryGetValue(record.Id, out var localTimestamp)
            ? localTimestamp
            : record.GeneratedAtUtc.ToString(TimestampPattern);

    private async Task LoadRecordsAsync()
    {
        _records = await GeneratedFileArchiveStore.SearchAsync(null);
        await _pagination.SetCurrentPageIndexAsync(0);
    }

    private async Task SearchAsync()
    {
        _records = await GeneratedFileArchiveStore.SearchAsync(_searchTerm);
        await _pagination.SetCurrentPageIndexAsync(0);
    }

    private async Task ClearSearchAsync()
    {
        _searchTerm = "";
        await LoadRecordsAsync();
    }

    // Data: URI download, same no-JS-interop mechanism as ExportProfileTest.razor (Lot J3/X1) -- but
    // built lazily per row on click rather than eagerly for the whole list, since this list has no
    // purge policy yet (see the ticket) and reading every archived source/target file into memory on
    // every page load would not scale as the archive grows. A synchronous File.ReadAllBytes (not
    // ReadAllBytesAsync) is deliberate: these are small, occasional, one-shot admin reads (source
    // ~1-6 MB, target ~20-100 KB per the ticket's own volume estimate), and a real cross-thread I/O
    // continuation was observed to race past bUnit's render-completion wait in this component's own
    // tests -- a synchronous read keeps the click handler's render commit fully deterministic.
    private Task PrepareSourceDownloadAsync(GeneratedFileRecord record)
    {
        var bytes = File.ReadAllBytes(Path.Combine(ArchiveOptions.Value.RootPath, record.SourceFilePath));
        _sourceDownloadHrefs[record.Id] = BuildDataUrl(bytes);
        return Task.CompletedTask;
    }

    private Task PrepareTargetDownloadAsync(GeneratedFileRecord record)
    {
        if (record.TargetFilePath is null)
        {
            return Task.CompletedTask;
        }

        var bytes = File.ReadAllBytes(Path.Combine(ArchiveOptions.Value.RootPath, record.TargetFilePath));
        _targetDownloadHrefs[record.Id] = BuildDataUrl(bytes);
        return Task.CompletedTask;
    }

    private static string BuildDataUrl(byte[] bytes) =>
        $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{Convert.ToBase64String(bytes)}";

    private static string GetStatusBadgeClass(GeneratedFileArchiveStatus status) => status switch
    {
        GeneratedFileArchiveStatus.Success => "bg-success",
        GeneratedFileArchiveStatus.NonBlockingWarning => "bg-warning text-dark",
        GeneratedFileArchiveStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetStatusLabel(GeneratedFileArchiveStatus status) => status switch
    {
        GeneratedFileArchiveStatus.Success => Loc["GeneratedFiles_StatusSuccess"],
        GeneratedFileArchiveStatus.NonBlockingWarning => Loc["GeneratedFiles_StatusNonBlockingWarning"],
        GeneratedFileArchiveStatus.Rejected => Loc["GeneratedFiles_StatusRejected"],
        _ => status.ToString()
    };
}
