@page "/"
@page "/dashboard"
@implements IAsyncDisposable

@using ExcelETL.Application.Extraction

@inject IExtractionHistoryRepository ExtractionHistoryRepository
@inject IStringLocalizer<BlazorAdminMessages> Loc

<PageTitle>@Loc["Dashboard_PageTitle"]</PageTitle>

<h1>@Loc["Dashboard_PageTitle"]</h1>

@if (_statistics is null)
{
    <p>@Loc["Dashboard_Loading"]</p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Loc["Dashboard_TotalJobs"]</h5>
                    <p class="display-6" id="stat-total-jobs">@_statistics.TotalJobs</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Loc["Dashboard_Completed"]</h5>
                    <p class="display-6 text-success" id="stat-completed-jobs">@_statistics.CompletedJobs</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Loc["Dashboard_Failed"]</h5>
                    <p class="display-6 text-danger" id="stat-failed-jobs">@_statistics.FailedJobs</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Loc["Dashboard_AverageDuration"]</h5>
                    <p class="display-6" id="stat-average-duration">@FormatDuration(_statistics.AverageCompletedDuration)</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(4);

    private ExtractionHistoryStatistics? _statistics;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _refreshCts;
    private Task? _refreshLoop;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        _refreshCts = new CancellationTokenSource();
        _timer = new PeriodicTimer(RefreshInterval);
        _refreshLoop = RunRefreshLoopAsync(_refreshCts.Token);
    }

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        _statistics = await ExtractionHistoryRepository.GetStatisticsAsync();
    }

    private string FormatDuration(TimeSpan? duration) =>
        duration is null ? Loc["Dashboard_NotAvailable"] : duration.Value.ToString(@"hh\:mm\:ss");

    public async ValueTask DisposeAsync()
    {
        _refreshCts?.Cancel();
        _timer?.Dispose();

        if (_refreshLoop is not null)
        {
            try
            {
                await _refreshLoop;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _refreshCts?.Dispose();
    }
}
