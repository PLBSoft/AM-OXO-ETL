@page "/Error"
@using System.Diagnostics

@inject IStringLocalizer<BlazorAdminMessages> Loc

<PageTitle>@Loc["Error_PageTitle"]</PageTitle>

<h1 class="text-danger">@Loc["Error_Heading"]</h1>
<h2 class="text-danger">@Loc["Error_Subheading"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Loc["Error_RequestIdLabel"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Loc["Error_DevelopmentModeHeading"]</h3>
<p>
    @((MarkupString)Loc["Error_DevelopmentModeExplanation"].Value)
</p>
<p>
    @((MarkupString)Loc["Error_DevelopmentModeWarningDetail"].Value)
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
