@page "/"
@attribute [Authorize]

@using ExcelETL.Application.Home
@using ExcelETL.Domain.Archiving
@using ExcelETL.BlazorAdmin.Services
@using ExcelETL.BlazorAdmin.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@inject IHomeIndicatorsService HomeIndicatorsService
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject ApplicationBuildInfo BuildInfo
@inject ILocalTimeFormatter LocalTimeFormatter
@inject TimeProvider TimeProvider

<PageTitle>@Loc["Home_PageTitle"]</PageTitle>

<!-- Follow-up (post-062): the sidebar hides the client logo/version footer on mobile
     (NavMenu.razor.css, <641px) -- shown here instead on the landing page, per the client's own
     request, since it's the one page every account reaches right after signing in. Hidden on
     desktop (Home.razor.css, >=641px), so the sidebar stays the single place showing this
     information there, never duplicated. -->
<div class="home-mobile-brand">
    <img id="home-mobile-client-logo" src="images/client-logo.png" alt="@Loc["NavMenu_ClientLogoAlt"]" />
    <div id="home-mobile-version-info" class="home-mobile-version-info" title="@(_localBuildDateTooltip ?? BuildDateTooltip)">
        v@(BuildInfo.Version)
        @if (BuildInfo.BuildDateUtc is not null)
        {
            @: (@(_localBuildDateLabel ?? BuildInfo.BuildDateUtc.Value.ToString("dd/MM/yyyy")))
        }
    </div>
</div>

<h1>@Loc["Home_PageTitle"]</h1>
<p class="text-muted small">@Loc["Home_Intro"]</p>

<!-- Lot 054 (54.4/54.6): a stable wrapper, present from initial render regardless of state, so
     aria-live="polite" is already attached to the DOM before the loading/tile/error content it
     announces ever appears -- same pattern as ImportProfileTest.razor/ExportProfileTest.razor (Lot
     040). -->
<div id="home-kpi-region" aria-live="polite">
@if (_loadError)
{
    <!-- 54.4: the service itself never throws (every indicator read is isolated internally), but the
         page stays defensive regardless -- / is the post-login redirect target, so an unhandled
         exception here would lock every account out of the application at the door. -->
    <div id="home-global-error" class="alert alert-danger" role="alert">@Loc["Home_GlobalErrorMessage"]</div>
}
else if (_indicators is null)
{
    <div id="home-loading" class="d-flex align-items-center gap-2">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span>@Loc["Home_Loading"]</span>
    </div>
}
else
{
    <!-- Bootstrap's responsive grid handles mobile stacking on its own (1 column on narrow
         viewports, up to 4 on desktop) -- no separate mobile/desktop template, per Lot V's own
         "no unnecessary duplicate markup" instruction. -->
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-lg-3">
            <a id="home-kpi-import-profiles" class="card h-100 text-decoration-none text-body" href="import-profiles">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        @((MarkupString)AdminIconMarkup.Collection)
                        <span id="home-kpi-import-profiles-label" class="text-muted">@Loc["NavMenu_ImportProfiles"]</span>
                    </div>
                    <p class="display-6 mb-0" aria-labelledby="home-kpi-import-profiles-label">
                        @if (_indicators.ImportProfileCount.State == HomeIndicatorState.Unavailable)
                        {
                            <span class="text-danger fs-5">@Loc["Home_IndicatorUnavailable"]</span>
                        }
                        else
                        {
                            @_indicators.ImportProfileCount.Value
                        }
                    </p>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <a id="home-kpi-export-profiles" class="card h-100 text-decoration-none text-body" href="export-profiles">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        @((MarkupString)AdminIconMarkup.FileEarmarkSpreadsheet)
                        <span id="home-kpi-export-profiles-label" class="text-muted">@Loc["NavMenu_ExportProfiles"]</span>
                    </div>
                    <p class="display-6 mb-0" aria-labelledby="home-kpi-export-profiles-label">
                        @if (_indicators.ExportProfileCount.State == HomeIndicatorState.Unavailable)
                        {
                            <span class="text-danger fs-5">@Loc["Home_IndicatorUnavailable"]</span>
                        }
                        else
                        {
                            @_indicators.ExportProfileCount.Value
                        }
                    </p>
                </div>
            </a>
        </div>

        <!-- Lot 088 (088.5): the last 30 local days (browser time zone once known, UTC before that),
             replacing the all-time total -- same id, same link. The total is the sum of the activity
             chart's bars, so the two can never disagree. -->
        <div class="col-12 col-sm-6 col-lg-3">
            <a id="home-kpi-generated-files" class="card h-100 text-decoration-none text-body" href="generated-files">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        @((MarkupString)AdminIconMarkup.Archive)
                        <span id="home-kpi-generated-files-label" class="text-muted">@Loc["Home_RecentActivityLabel"]</span>
                    </div>
                    @if (_recentDays is null)
                    {
                        <p class="display-6 mb-0" aria-labelledby="home-kpi-generated-files-label">
                            <span class="text-danger fs-5">@Loc["Home_IndicatorUnavailable"]</span>
                        </p>
                    }
                    else
                    {
                        var success = _recentDays.Sum(d => d.Success);
                        var warning = _recentDays.Sum(d => d.Warning);
                        var rejected = _recentDays.Sum(d => d.Rejected);
                        <p id="home-kpi-generated-files-total" class="display-6 mb-0" aria-labelledby="home-kpi-generated-files-label">
                            @(success + warning + rejected)
                        </p>
                        <p class="small mb-0">
                            <span id="home-kpi-generated-files-success">@Loc["Home_RecentActivitySuccess", success]</span>
                            <span aria-hidden="true"> · </span>
                            <span id="home-kpi-generated-files-warning">@Loc["Home_RecentActivityWarning", warning]</span>
                            <span aria-hidden="true"> · </span>
                            <span id="home-kpi-generated-files-rejected" class="@(rejected > 0 ? "text-danger fw-semibold" : null)">@Loc[rejected > 1 ? "Home_RecentActivityRejectedPlural" : "Home_RecentActivityRejectedSingular", rejected]</span>
                        </p>
                    }
                </div>
            </a>
        </div>

        <!-- Links to the archive page (client request, 28/09), like the "30 derniers jours" tile. The
             repère, user and status of the most recent file are read with its date (one query). -->
        <div class="col-12 col-sm-6 col-lg-3">
            <a id="home-kpi-last-generation" class="card h-100 text-decoration-none text-body" href="generated-files">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        @((MarkupString)AdminIconMarkup.Clock)
                        <span id="home-kpi-last-generation-label" class="text-muted">@Loc["Home_LastGenerationLabel"]</span>
                    </div>
                    <p class="fs-4 mb-0" id="home-kpi-last-generation-value" aria-labelledby="home-kpi-last-generation-label">
                        @if (_indicators.LastGeneration.State == HomeIndicatorState.Unavailable)
                        {
                            <span class="text-danger">@Loc["Home_IndicatorUnavailable"]</span>
                        }
                        else if (_indicators.LastGeneration.Value is { } lastGeneration)
                        {
                            @LocalTimestampOrFallback(lastGeneration.GeneratedAtUtc)
                        }
                        else
                        {
                            <span>@Loc["Home_NoGeneration"]</span>
                        }
                    </p>
                    @if (_indicators.LastGeneration.Value is { } details)
                    {
                        <dl class="small mb-0 mt-2">
                            <div class="d-flex gap-1">
                                <dt class="fw-normal text-muted">@Loc["Home_LastGenerationDetailLabel", Loc["GeneratedFiles_EquipementRepereColumn"]]</dt>
                                <dd id="home-kpi-last-generation-repere" class="mb-0 text-break">@(details.EquipementRepere ?? "—")</dd>
                            </div>
                            <div class="d-flex gap-1">
                                <dt class="fw-normal text-muted">@Loc["Home_LastGenerationDetailLabel", Loc["GeneratedFiles_UsernameColumn"]]</dt>
                                <dd id="home-kpi-last-generation-username" class="mb-0 text-break">@(details.Username ?? "—")</dd>
                            </div>
                            <div class="d-flex gap-1 align-items-center">
                                <dt class="fw-normal text-muted">@Loc["Home_LastGenerationDetailLabel", Loc["GeneratedFiles_StatusColumn"]]</dt>
                                <dd class="mb-0"><span id="home-kpi-last-generation-status" class="badge @GetStatusBadgeClass(details.Status)">@GetStatusLabel(details.Status)</span></dd>
                            </div>
                        </dl>
                    }
                </div>
            </a>
        </div>
    </div>

    <!-- Lot 088 (088.6): same grouped days as the "30 derniers jours" tile above. -->
    <section id="home-activity" class="card mt-4" aria-labelledby="home-activity-title">
        <div class="card-body">
            <h2 id="home-activity-title" class="h5">@Loc["Home_ActivityChartTitle"]</h2>
            @if (_recentDays is null)
            {
                <p id="home-activity-unavailable" class="text-danger mb-0">@Loc["Home_IndicatorUnavailable"]</p>
            }
            else if (_recentDays.All(d => d.Total == 0))
            {
                <p id="home-activity-empty" class="text-muted mb-0">@Loc["Home_NoRecentActivity"]</p>
            }
            else
            {
                <HomeActivityChart Days="_recentDays" />
            }
        </div>
    </section>
}
</div>

@code {
    private const string LastGenerationTimestampPattern = "dd/MM/yyyy HH:mm";

    private HomeIndicators? _indicators;
    private bool _loadError;

    // Lot 088: RecentActivity grouped into the last 30 local days -- null when it couldn't be read.
    // Grouped in UTC first (prerendering, or before the circuit is interactive), then again in the
    // browser's own time zone once JS interop can report it (D7, same principle as lot 064).
    private IReadOnlyList<DailyGenerationActivity>? _recentDays;
    private TimeZoneInfo _timeZone = TimeZoneInfo.Utc;
    private bool _timeZoneResolved;
    private string? _localLastGenerationTimestamp;
    private DateTime? _localLastGenerationComputedFor;

    // Same computation as NavMenu.razor's own BuildDateTooltip -- kept duplicated rather than
    // factored into a shared helper, consistent with this project's precedent of accepting small
    // duplication over a premature abstraction for a two-line computed property.
    private string? BuildDateTooltip => BuildInfo.BuildDateUtc is { } buildDateUtc
        ? string.Format(
            Loc["NavMenu_BuildDateTooltip"].Value,
            buildDateUtc.ToString("dddd d MMMM yyyy, HH:mm", System.Globalization.CultureInfo.CurrentUICulture))
        : null;

    // Follow-up (post-064): same reopening/reasoning as NavMenu.razor's own build-date fields --
    // duplicated here rather than shared, same precedent as BuildDateTooltip above.
    private const string BuildDateNumericPattern = "yyyy-MM-dd HH:mm";
    private string? _localBuildDateLabel;
    private string? _localBuildDateTooltip;
    private bool _localBuildDateComputed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _indicators = await HomeIndicatorsService.GetIndicatorsAsync();
            GroupRecentActivity();
        }
        catch
        {
            // 54.4: defense in depth -- IHomeIndicatorsService.GetIndicatorsAsync is designed to
            // never throw (every store read is isolated internally), but / is the post-login
            // redirect target, so this page must never propagate an exception regardless.
            _loadError = true;
        }
    }

    // Lot 064: same browser-local-time mechanism as Logs.razor/GeneratedFiles.razor. Two independent
    // concerns (last-generation KPI, build-date footer) are each computed only once they have
    // something new to convert -- neither is allowed to early-return past the other (a page with no
    // generated file yet must still get its build date converted).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var didUpdate = false;

        if (!_timeZoneResolved && _indicators is not null)
        {
            _timeZoneResolved = true;
            try
            {
                _timeZone = BrowserTimeZoneResolver.Resolve(await LocalTimeFormatter.GetBrowserTimeZoneIdAsync());
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
            {
                // Keep the UTC grouping: an approximate day is better than a failed home page.
            }

            if (_timeZone != TimeZoneInfo.Utc)
            {
                GroupRecentActivity();
                didUpdate = true;
            }
        }

        if (_indicators?.LastGeneration.Value?.GeneratedAtUtc is { } lastGenerationAtUtc
            && _localLastGenerationComputedFor != lastGenerationAtUtc)
        {
            _localLastGenerationTimestamp = await LocalTimeFormatter.FormatAsync(lastGenerationAtUtc, LastGenerationTimestampPattern);
            _localLastGenerationComputedFor = lastGenerationAtUtc;
            didUpdate = true;
        }

        if (!_localBuildDateComputed && BuildInfo.BuildDateUtc is { } buildDateUtc)
        {
            var localNumeric = await LocalTimeFormatter.FormatAsync(buildDateUtc, BuildDateNumericPattern);
            if (DateTime.TryParseExact(
                    localNumeric, BuildDateNumericPattern,
                    System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None,
                    out var localBuildDate))
            {
                _localBuildDateLabel = localBuildDate.ToString("dd/MM/yyyy");
                _localBuildDateTooltip = string.Format(
                    Loc["NavMenu_BuildDateTooltip"].Value,
                    localBuildDate.ToString("dddd d MMMM yyyy, HH:mm", System.Globalization.CultureInfo.CurrentUICulture));
            }

            _localBuildDateComputed = true;
            didUpdate = true;
        }

        if (didUpdate)
        {
            StateHasChanged();
        }
    }

    private void GroupRecentActivity() =>
        _recentDays = _indicators?.RecentActivity is { State: HomeIndicatorState.Known, Value: { } entries }
            ? GenerationActivityBuilder.Build(entries, _timeZone, TimeProvider.GetUtcNow().UtcDateTime)
            : null;

    // Same badge colours and labels as GeneratedFiles.razor, so a status reads the same on both pages.
    private static string GetStatusBadgeClass(GeneratedFileArchiveStatus status) => status switch
    {
        GeneratedFileArchiveStatus.Success => "bg-success",
        GeneratedFileArchiveStatus.NonBlockingWarning => "bg-warning text-dark",
        GeneratedFileArchiveStatus.Rejected => "bg-danger",
        _ => "bg-secondary",
    };

    private string GetStatusLabel(GeneratedFileArchiveStatus status) => status switch
    {
        GeneratedFileArchiveStatus.Success => Loc["GeneratedFiles_StatusSuccess"],
        GeneratedFileArchiveStatus.NonBlockingWarning => Loc["GeneratedFiles_StatusNonBlockingWarning"],
        GeneratedFileArchiveStatus.Rejected => Loc["GeneratedFiles_StatusRejected"],
        _ => status.ToString(),
    };

    private string LocalTimestampOrFallback(DateTime lastGenerationAtUtc) =>
        _localLastGenerationComputedFor == lastGenerationAtUtc && _localLastGenerationTimestamp is not null
            ? _localLastGenerationTimestamp
            : lastGenerationAtUtc.ToString(LastGenerationTimestampPattern);
}
