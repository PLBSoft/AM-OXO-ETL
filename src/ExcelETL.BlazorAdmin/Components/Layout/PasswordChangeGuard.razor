@using System.Security.Claims
@using ExcelETL.BlazorAdmin.Components.Account.Pages
@using ExcelETL.Infrastructure.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@inject NavigationManager NavigationManager

@* Lot 045 (45.0/45.4): global guard -- while the authenticated user carries the
   RequirePasswordChangeOnFirstLogin claim (added at sign-in by
   RequirePasswordChangeClaimsPrincipalFactory), every navigation except the forced-change page
   itself and logout is redirected there. OnInitializedAsync covers a fresh hard navigation/circuit
   start (works under both static SSR and interactive render, no JS needed) -- this is what actually
   protects the Account pages (Login/Register/ForcePasswordChange itself all render this same
   MainLayout). NavigationLock.OnBeforeInternalNavigation additionally covers a client-side SPA
   navigation attempted while an interactive circuit is already connected (sidebar links, etc.).
   NavigationLock is only rendered when RendererInfo.IsInteractive is true: the real static-SSR
   NavigationManager used for [ExcludeFromInteractiveRouting] pages throws NotSupportedException on
   RegisterLocationChangingHandler (confirmed empirically while building this lot) -- accessing
   RendererInfo at all requires a render mode to have been assigned, which only interactive pages
   have. *@
@if (RendererInfo.IsInteractive)
{
    <NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" />
}

@code {
    // Pages that must stay reachable regardless of the flag, to avoid a redirect loop: the forced
    // change page itself, and logout (a raw <form method="post"> to a non-Blazor minimal API
    // endpoint in practice, but checked here too in case enhanced navigation ever intercepts it).
    private static readonly string[] AllowedPathPrefixes =
    [
        "account/forcepasswordchange",
        "account/logout",
    ];

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await RedirectIfRequiredAsync(NavigationManager.Uri);
    }

    private Task OnBeforeInternalNavigationAsync(LocationChangingContext context)
        => RedirectIfRequiredAsync(context.TargetLocation, context);

    private async Task RedirectIfRequiredAsync(string uri, LocationChangingContext? context = null)
    {
        if (!await RequiresForcedChangeAsync())
        {
            return;
        }

        var path = NavigationManager.ToBaseRelativePath(NavigationManager.ToAbsoluteUri(uri).ToString());
        if (IsAllowedPath(path))
        {
            return;
        }

        context?.PreventNavigation();
        NavigationManager.NavigateTo(ForcePasswordChange.Route);
    }

    private async Task<bool> RequiresForcedChangeAsync()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;
        return user.Identity?.IsAuthenticated == true
            && user.HasClaim(c => c.Type == RequirePasswordChangeClaimsPrincipalFactory.ClaimType
                && c.Value == bool.TrueString);
    }

    private static bool IsAllowedPath(string path)
    {
        var normalized = path.Trim('/').ToLowerInvariant();
        return AllowedPathPrefixes.Any(prefix => normalized.StartsWith(prefix, StringComparison.Ordinal));
    }
}
