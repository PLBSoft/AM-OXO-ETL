@inherits LayoutComponentBase

@inject IStringLocalizer<BlazorAdminMessages> Loc

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Loc["MainLayout_UnhandledError"]
    <a href="." class="reload">@Loc["MainLayout_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>
