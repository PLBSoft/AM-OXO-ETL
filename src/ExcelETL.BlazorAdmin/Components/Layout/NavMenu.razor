@implements IDisposable

@using ExcelETL.Infrastructure.Identity

@inject NavigationManager NavigationManager
@inject IStringLocalizer<BlazorAdminMessages> Loc

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ExcelETL.BlazorAdmin</a>
    </div>
</div>

<input type="checkbox" title="@Loc["NavMenu_ToggleTitle"]" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink id="nav-logs-link" class="nav-link" href="logs">
                        <span class="bi bi-card-list-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_Logs"]
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@IdentitySeeder.AdminRoleName">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink id="nav-users-link" class="nav-link" href="users">
                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_Users"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink id="nav-import-profiles-link" class="nav-link" href="import-profiles">
                        <span class="bi bi-collection-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_ImportProfiles"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink id="nav-import-profiles-test-link" class="nav-link" href="import-profiles/test">
                        <span class="bi bi-play-circle-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_ImportProfileTest"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink id="nav-export-profiles-link" class="nav-link" href="export-profiles">
                        <span class="bi bi-file-earmark-spreadsheet-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_ExportProfiles"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink id="nav-export-profiles-test-link" class="nav-link" href="export-profiles/test">
                        <span class="bi bi-download-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_ExportProfileTest"]
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink id="nav-profile-link" class="nav-link" href="profile">
                        <span class="bi bi-person-circle-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name - @Loc["NavMenu_Profile"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_Logout"]
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_Register"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink id="nav-login-link" class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_Login"]
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
