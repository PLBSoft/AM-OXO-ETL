@implements IDisposable

@using ExcelETL.Infrastructure.Identity

@using ExcelETL.BlazorAdmin.Services
@using ExcelETL.BlazorAdmin.Shared

@inject NavigationManager NavigationManager
@inject IStringLocalizer<BlazorAdminMessages> Loc
@inject ApplicationBuildInfo BuildInfo
@inject ILocalTimeFormatter LocalTimeFormatter

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid d-flex align-items-center">
        <SectionOutlet SectionName="@PageBackNavSectionName" />
        <a class="navbar-brand text-truncate flex-grow-1" href="">Alpha - MAD / REL OXO</a>
    </div>
</div>

<input id="nav-menu-toggler" type="checkbox" title="@Loc["NavMenu_ToggleTitle"]"
       aria-label="@Loc["NavMenu_ToggleTitle"]" aria-controls="nav-scrollable"
       aria-expanded="@(_isNavExpanded ? "true" : "false")" @onchange="OnTogglerChanged"
       class="navbar-toggler flex-shrink-0" />

<div id="nav-scrollable" class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <!-- Lot 052 (52.2): convention-autorisation-pages-blazoradmin.md -- Admin governs the
             administration of the application (Users, Logs), not its use. The 4 links below moved
             out of the Admin-only block into a plain (role-less) AuthorizeView -- every authenticated
             account, with or without a role, now sees them. No link changes position in the display
             order (Lot S2): only the AuthorizeView wrapping each one changes. -->
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink id="nav-import-profiles-link" class="nav-link" href="import-profiles">
                        <span class="bi bi-collection-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_ImportProfiles"]
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink id="nav-export-profiles-link" class="nav-link" href="export-profiles">
                        <span class="bi bi-file-earmark-spreadsheet-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_ExportProfiles"]
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink id="nav-api-test-link" class="nav-link" href="api-test">
                        <span class="bi bi-send-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_ApiTest"]
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="@IdentitySeeder.AdminRoleName">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink id="nav-users-link" class="nav-link" href="users">
                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_Users"]
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink id="nav-generated-files-link" class="nav-link" href="generated-files">
                        <span class="bi bi-archive-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_GeneratedFiles"]
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <!-- Logs stays Admin-only (administration of the application, Lot 44.4's decision confirmed
             at this lot -- see 52.0's investigation note in the ticket document). -->
        <AuthorizeView Roles="@IdentitySeeder.AdminRoleName">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink id="nav-logs-link" class="nav-link" href="logs">
                        <span class="bi bi-card-list-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_Logs"]
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink id="nav-profile-link" class="nav-link" href="profile">
                        <span class="bi bi-person-circle-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name - @Loc["NavMenu_Profile"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_Logout"]
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <!-- Lot 051 (51.2): public self-registration removed as a security decision -- this
                     block now offers login only. -->
                <div class="nav-item px-3">
                    <NavLink id="nav-login-link" class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> @Loc["NavMenu_Login"]
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <!-- Follow-up (post-062): client logo + version/date, outside of any AuthorizeView so they
             are always visible regardless of authentication state (61.0.3/61.0.4), grouped into one
             `.sidebar-footer` so `margin-top:auto` (NavMenu.razor.css) pushes them to the true
             bottom of the sidebar regardless of how many nav links the current account sees --
             previously two loose siblings simply sat right after the last link, which left a large
             visible gap below them whenever the link list was short. Hidden entirely on mobile
             (NavMenu.razor.css, <641px) -- the same information is shown on Home.razor instead
             there, since the client reported the mobile open-menu rendering of this block as poor. -->
        <div id="sidebar-footer" class="sidebar-footer">
            <div class="sidebar-logo-container">
                <img id="sidebar-client-logo" src="images/client-logo.png" alt="@Loc["NavMenu_ClientLogoAlt"]" />
            </div>
            <!-- Dark/light theme toggle: a plain HTML onclick calling straight into
                 window.amOxoTheme.toggle() (wwwroot/js/theme.js), not @onclick/IJSRuntime -- works
                 without a circuit round trip, same convention as the mobile hamburger toggler above.
                 Both icon spans are always in the DOM; NavMenu.razor.css shows only the one matching
                 the current [data-bs-theme] attribute on <html> via a CSS attribute selector. -->
            <div class="sidebar-theme-toggle-container">
                <button type="button" id="theme-toggle-button" class="sidebar-theme-toggle"
                        onclick="window.amOxoTheme.toggle()"
                        title="@Loc["NavMenu_ThemeToggleTitle"]" aria-label="@Loc["NavMenu_ThemeToggleTitle"]">
                    <span class="theme-toggle-icon theme-toggle-icon-sun">@((MarkupString)AdminIconMarkup.Sun)</span>
                    <span class="theme-toggle-icon theme-toggle-icon-moon">@((MarkupString)AdminIconMarkup.Moon)</span>
                </button>
            </div>
            <div id="sidebar-version-info" class="sidebar-version-info" title="@(_localBuildDateTooltip ?? BuildDateTooltip)">
                v@(BuildInfo.Version)
                @if (BuildInfo.BuildDateUtc is not null)
                {
                    @: (@(_localBuildDateLabel ?? BuildInfo.BuildDateUtc.Value.ToString("dd/MM/yyyy")))
                }
            </div>
        </div>
    </nav>
</div>

@code {
    // X11 (Lot X): shared SectionOutlet slot in the global top-row banner, filled by
    // <PageBackNavLink> on the 4 "child" pages that define a back-nav target (see PageBackNavLink.razor).
    // Left empty (nothing rendered) on every other page -- native SectionOutlet behavior with no
    // matching SectionContent anywhere in the render tree.
    public const string PageBackNavSectionName = "page-back-nav";

    private string? currentUrl;

    // 39.1: purely additive to the pre-existing CSS-only `.navbar-toggler:checked ~ .nav-scrollable`
    // mechanism (NavMenu.razor.css) -- the checkbox stays a real HTML checkbox, this state only
    // drives the parallel aria-expanded attribute for assistive technology, never the visual open/
    // close behavior itself.
    private bool _isNavExpanded;

    private void OnTogglerChanged(ChangeEventArgs e) => _isNavExpanded = e.Value is true;

    // Follow-up (post-064): raw-UTC fallback, shown until the browser-local conversion below
    // resolves (or forever, under non-interactive rendering -- prerendering/bUnit's default) --
    // same "never a blank cell, brief documented flash" convention as Logs.razor/GeneratedFiles.razor.
    private string? BuildDateTooltip => BuildInfo.BuildDateUtc is { } buildDateUtc
        ? string.Format(
            Loc["NavMenu_BuildDateTooltip"].Value,
            buildDateUtc.ToString("dddd d MMMM yyyy, HH:mm", System.Globalization.CultureInfo.CurrentUICulture))
        : null;

    // Follow-up (post-064): the publication date/time was initially left out of Lot 064's browser-
    // local-time conversion (a build date, not an incident timestamp to correlate) -- reopened once
    // Simon actually compared a real publish against the displayed value and got confused by the
    // same UTC-vs-local gap. `ILocalTimeFormatter.FormatAsync` only supports numeric tokens
    // (yyyy/MM/dd/HH/mm/ss, see localTime.js) -- no day/month name support -- so the browser-local
    // numeric string is parsed back into a plain `DateTime` here and re-formatted with
    // `CultureInfo.CurrentUICulture` for the day/month names, exactly like the pre-existing
    // server-side-only BuildDateTooltip above did with the (wrong) UTC value.
    private const string BuildDateNumericPattern = "yyyy-MM-dd HH:mm";
    private string? _localBuildDateLabel;
    private string? _localBuildDateTooltip;
    private bool _localBuildDateComputed;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive || _localBuildDateComputed || BuildInfo.BuildDateUtc is not { } buildDateUtc)
        {
            return;
        }

        var localNumeric = await LocalTimeFormatter.FormatAsync(buildDateUtc, BuildDateNumericPattern);
        if (DateTime.TryParseExact(
                localNumeric, BuildDateNumericPattern,
                System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None,
                out var localBuildDate))
        {
            _localBuildDateLabel = localBuildDate.ToString("dd/MM/yyyy");
            _localBuildDateTooltip = string.Format(
                Loc["NavMenu_BuildDateTooltip"].Value,
                localBuildDate.ToString("dddd d MMMM yyyy, HH:mm", System.Globalization.CultureInfo.CurrentUICulture));
        }

        _localBuildDateComputed = true;
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
