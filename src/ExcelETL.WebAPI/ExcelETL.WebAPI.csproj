<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
    <!-- Design-time only, needed for `dotnet ef` commands to run with this project as the startup
         project: ExcelETL.Infrastructure's own Design reference is marked PrivateAssets="all" and
         does not flow transitively. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExcelETL.Application\ExcelETL.Application.csproj" />
    <ProjectReference Include="..\ExcelETL.Hosting\ExcelETL.Hosting.csproj" />
    <ProjectReference Include="..\ExcelETL.Infrastructure\ExcelETL.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExcelETL.WebAPI.Tests" />
  </ItemGroup>

  <!-- Own version counter, independent from ExcelETL.BlazorAdmin's (Lot 062); deliberately not
       shared between the two independently-deployed hosts, same rationale as Lot 062's own
       decision. Incremented on Publish only (never a plain dotnet build/F5), read back by
       ApiBuildInfo for GET /api/health. See ExcelETL.BlazorAdmin.csproj's own target for the full
       BeforeBuild/_IsPublishing rationale; identical mechanism, not reproduced here. -->
  <PropertyGroup>
    <VersionCounterFile>$(MSBuildProjectDirectory)\version.txt</VersionCounterFile>
  </PropertyGroup>

  <Target Name="IncrementVersionCounterOnPublish" BeforeTargets="BeforeBuild" Condition="'$(_IsPublishing)' == 'true'">
    <ReadLinesFromFile File="$(VersionCounterFile)">
      <Output TaskParameter="Lines" ItemName="_VersionCounterLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_CurrentVersionCounter Condition="'@(_VersionCounterLines)' != ''">@(_VersionCounterLines)</_CurrentVersionCounter>
      <_CurrentVersionCounter Condition="'$(_CurrentVersionCounter)' == ''">0</_CurrentVersionCounter>
      <_NextVersionCounter>$([MSBuild]::Add($(_CurrentVersionCounter), 1))</_NextVersionCounter>
    </PropertyGroup>
    <WriteLinesToFile File="$(VersionCounterFile)" Lines="$(_NextVersionCounter)" Overwrite="true" />
    <PropertyGroup>
      <Version>1.0.$(_NextVersionCounter)</Version>
      <AssemblyInformationalVersion>1.0.$(_NextVersionCounter)</AssemblyInformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
